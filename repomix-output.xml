.form-group {
  display: flex;
  min-width: 0;
  flex-direction: column;
  margin-bottom: 1.2rem;
}

.form-group label {
  margin-bottom: 0.45rem;
  color: #18394c;
  font-size: 0.88rem;
  font-weight: 650;
}

.form-group input {
  display: block;
  width: 100%;
