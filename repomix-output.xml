    private List<PedidoItem> items;
    private BigDecimal precioTotal;
    private DireccionEnvioPedido direccionEnvio;
    private MetodoPagoPedido metodoPago;
    private PedidoEstado estado;
    private LocalDateTime fechaCreacion;

