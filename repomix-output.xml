                            : 'Mostrar ' + product.name"
                      [title]="product.available ? 'Ocultar producto' : 'Mostrar producto'">
                      @if (visibilitySaving() === product.id) {
                      Guardando...
                      } @else {
                      {{ product.available ? 'Publicado' : 'Oculto' }}
                      }
                    </button>
                  </td>

                  <td class="action-column">
                    <div class="action-buttons">
                      <a class="icon-button edit-button" [routerLink]="['/products', product.id, 'edit']"
                        [attr.aria-label]="'Editar ' + product.name" [title]="'Editar ' + product.name">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                          <path d="M12 20h9" />
                          <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z" />
                        </svg>
                      </a>
                    </div>
                  </td>
                </tr>

                @if (
                isEditing(product.id, 'price') ||
                isEditing(product.id, 'stock') ||
                visibilityError()
                ) {
                <tr class="inline-error-row">
                  <td colspan="6">
                    @if (inlineError(); as error) {
                    <span role="alert">{{ error }}</span>
                    } @else if (visibilityError(); as error) {
                    <span role="alert">{{ error }}</span>
                    } @else {
                    <span>Pulsa ✓ para guardar o × para cancelar.</span>
                    }
                  </td>
                </tr>
                }
                }
              </tbody>
            </table>
          </div>
          }
        </section>
      </div>
    </main>
  </div>
</div>
