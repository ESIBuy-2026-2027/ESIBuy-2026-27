:host {
  display: block;
  min-height: 100vh;
  background: #f8fafc;
  color: #102c40;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
}

.home-container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}

/* HERO SECTION */
.hero-section {
  background: linear-gradient(135deg, #edf4ff 0%, #f5f9ff 60%, #edf8f5 100%);
  padding: 56px 24px 64px;
  border-bottom: 1px solid #e2e8f0;
  text-align: center;
  position: relative;
}

.hero-content {
  max-width: 780px;
  margin: 0 auto;
}

.hero-eyebrow {
  margin: 0 0 10px;
  color: #0d9488;
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 1.5px;
  text-transform: uppercase;
}

.hero-section h1 {
  margin: 0 0 12px;
  font-size: clamp(2rem, 3.5vw, 2.75rem);
  font-weight: 800;
  color: #102c40;
