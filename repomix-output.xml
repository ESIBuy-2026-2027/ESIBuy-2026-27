                  </td>

                  <td>
                    @if (isEditing(product.id, 'stock')) {
                    <div class="inline-editor">
                      <label class="visually-hidden" [for]="'stock-' + product.id">
                        Stock de {{ product.name }}
                      </label>
                      <input class="inline-input stock-input" [id]="'stock-' + product.id" type="number" min="0"
                        step="1" [ngModel]="inlineValue()"
                        (ngModelChange)="inlineValue.set($event === '' ? null : +$event)"
                        (keydown.enter)="saveInlineEdit(product)" (keydown.escape)="cancelInlineEdit()"
                        [disabled]="inlineSaving()">

                      <div class="inline-actions">
                        <button type="button" class="inline-save" (click)="saveInlineEdit(product)"
                          [disabled]="inlineSaving()" aria-label="Guardar stock">✓</button>
                        <button type="button" class="inline-cancel" (click)="cancelInlineEdit()"
                          [disabled]="inlineSaving()" aria-label="Cancelar edición del stock">×</button>
                      </div>
                    </div>
                    } @else {
                    <button type="button" class="editable-value stock-badge" [class.stock-empty]="product.stock === 0"
                      [class.stock-low]="stockStatus(product.stock) === 'Stock bajo'"
                      (click)="startInlineEdit(product, 'stock')"
                      [attr.aria-label]="'Modificar stock de ' + product.name" title="Modificar stock">
                      @if (stockStatus(product.stock) !== 'En stock') {
                      {{ stockStatus(product.stock) }} ·
                      }
                      {{ product.stock }}
                    </button>
                    }
                  </td>

                  <td>
                    <button type="button" class="availability-badge editable-availability"
                      [class.is-published]="product.available" [class.is-paused]="!product.available"
                      (click)="toggleVisibility(product)"
                      [disabled]="visibilitySaving() === product.id || inlineSaving()" [attr.aria-label]="product.available
