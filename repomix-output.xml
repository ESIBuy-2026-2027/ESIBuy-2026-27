import { HttpClient } from '@angular/common/http';
import { Component, computed, inject, OnInit, signal } from '@angular/core';
import { FormsModule } from '@angular/forms';
import { Router } from '@angular/router';
import { Location } from '@angular/common';
import { AuthService } from '../../../core/services/auth.service';
import { DeleteAccount } from '../../../shared/delete-account/delete-account';
import { TwoFactorSettingsComponent } from '../../../shared/two-factor-settings/two-factor-settings';
import { ProfileShellComponent } from '../../../shared/profile-shell/profile-shell';
import type { ProfileNavigationItem } from '../../../shared/profile-shell/profile-shell';
import { ADMIN_AVATARS } from '../../../core/constants/avatars';

interface AdminProfileResponse {
    firstName: string;
    lastName: string;
    email: string;
    phone: string | null;
    maskedNationalId: string | null;
    profileImage: string | null;
    headquarters: string | null;
    hireDate: string | null;
    totpEnabled: boolean;
}

interface UpdateAdminProfileRequest {
    firstName: string;
    lastName: string;
    headquarters: string;
    profileImage: string;
    nationalId?: string;
}

@Component({
    selector: 'app-admin-profile',
    standalone: true,
    imports: [FormsModule, DeleteAccount, TwoFactorSettingsComponent, ProfileShellComponent],
    templateUrl: './admin-profile.html',
    styleUrl: './admin-profile.css',
})
export class AdminProfile implements OnInit {
    private readonly authService = inject(AuthService);
    private readonly http = inject(HttpClient);
    private readonly router = inject(Router);
    private readonly location = inject(Location);
    private readonly apiUrl = '/api/users/me/profile';

    readonly adminAvatars: readonly string[] = ADMIN_AVATARS;

    readonly selectedAvatar = signal(this.adminAvatars[0]);

    readonly profile = signal<AdminProfileResponse | null>(null);
    readonly loading = signal(true);
    readonly profileError = signal<string | null>(null);
    readonly logoutError = signal<string | null>(null);

    readonly editing = signal(false);
    readonly saving = signal(false);
    readonly editError = signal<string | null>(null);
    readonly editSuccess = signal<string | null>(null);

    readonly twoFactorEnabled = signal(false);

    readonly shellSections: ProfileNavigationItem[] = [
        { key: 'personal', label: 'Datos personales' },
        { key: 'security', label: 'Seguridad' },
    ];

    readonly activeSection = signal<'personal' | 'security'>('personal');

    selectSection(section: 'personal' | 'security'): void {
        this.activeSection.set(section);
    }

    editForm: UpdateAdminProfileRequest = this.emptyForm();

    readonly fullName = computed(() => {
        const profile = this.profile();

        return profile
            ? [profile.firstName, profile.lastName].filter(Boolean).join(' ')
            : '';
    });

    readonly initials = computed(() => {
        const profile = this.profile();

        if (!profile) return 'A';

        const first = profile.firstName?.trim().charAt(0) ?? '';
        const last = profile.lastName?.trim().charAt(0) ?? '';

        return `${first}${last}`.toUpperCase() || 'A';
    });

    readonly displayAvatar = computed(() => {
        if (this.editing()) {
            return this.selectedAvatar();
        }

        return this.getValidAvatar(this.profile()?.profileImage);
    });

    readonly formattedHireDate = computed(() => {
        const date = this.profile()?.hireDate;

        if (!date) return 'No disponible';

        const parsedDate = new Date(date);

        if (Number.isNaN(parsedDate.getTime())) {
            return date;
        }

        return new Intl.DateTimeFormat('es-ES', {
            day: '2-digit',
            month: '2-digit',
            year: 'numeric',
        }).format(parsedDate);
    });

    ngOnInit(): void {
        this.loadProfile();
    }

    private emptyForm(): UpdateAdminProfileRequest {
        return {
            firstName: '',
            lastName: '',
            headquarters: '',
            profileImage: this.adminAvatars[0],
            nationalId: '',
        };
    }

    private normalizeAvatar(path: string | null | undefined): string {
        return path?.replace(/^\/+/, '') ?? '';
    }

    private getValidAvatar(path: string | null | undefined): string {
        const normalized = this.normalizeAvatar(path);

        return this.adminAvatars.includes(normalized)
            ? normalized
            : this.adminAvatars[0];
    }

    selectAvatar(avatar: string): void {
        if (!this.editing() || this.saving()) return;

        if (this.adminAvatars.includes(avatar)) {
            this.selectedAvatar.set(avatar);
            this.editForm.profileImage = avatar;
        }
    }

    loadProfile(): void {
        this.loading.set(true);
        this.profileError.set(null);

        this.http.get<AdminProfileResponse>(this.apiUrl, {
            withCredentials: true,
        }).subscribe({
            next: profile => {
                this.profile.set(profile);
                this.twoFactorEnabled.set(profile.totpEnabled === true);

                const avatar = this.getValidAvatar(profile.profileImage);
                this.selectedAvatar.set(avatar);

                this.editForm = {
                    firstName: profile.firstName ?? '',
                    lastName: profile.lastName ?? '',
                    headquarters: profile.headquarters ?? '',
                    profileImage: avatar,
                    nationalId: '',
                };

                this.loading.set(false);
            },
            error: (error: { status?: number }) => {
                this.loading.set(false);

                if (error.status === 401 || error.status === 403) {
                    this.profileError.set(
                        'No se ha podido acceder al perfil. Comprueba que has iniciado sesión con una cuenta de administrador.',
                    );
                    return;
                }

                this.profileError.set(
                    'No se han podido cargar los datos del perfil. Inténtalo de nuevo.',
                );
            },
        });
    }

    onTwoFactorEnabledChange(enabled: boolean): void {
        this.twoFactorEnabled.set(enabled);

        const current = this.profile();

        if (current) {
            this.profile.set({
                ...current,
                totpEnabled: enabled,
            });
        }
    }

    startEditing(): void {
        const profile = this.profile();
        if (!profile) return;

        const avatar = this.getValidAvatar(profile.profileImage);

        this.selectedAvatar.set(avatar);
        this.editForm = {
            firstName: profile.firstName ?? '',
            lastName: profile.lastName ?? '',
            headquarters: profile.headquarters ?? '',
            profileImage: avatar,
            // Nunca rellenar este campo con el DNI enmascarado.
            nationalId: '',
        };

        this.editError.set(null);
        this.editSuccess.set(null);
        this.editing.set(true);
    }

    cancelEditing(): void {
        const profile = this.profile();

        this.selectedAvatar.set(this.getValidAvatar(profile?.profileImage));
        this.editing.set(false);
        this.editError.set(null);
        this.editForm = this.emptyForm();

        if (profile) {
            this.editForm = {
                firstName: profile.firstName ?? '',
                lastName: profile.lastName ?? '',
                headquarters: profile.headquarters ?? '',
                profileImage: this.getValidAvatar(profile.profileImage),
                nationalId: '',
            };
        }
    }

    saveProfile(): void {
        if (this.saving()) return;

        this.editError.set(null);
        this.editSuccess.set(null);

        const firstName = this.editForm.firstName.trim();
        const lastName = this.editForm.lastName.trim();
        const headquarters = this.editForm.headquarters.trim();

        if (firstName.length < 2 || firstName.length > 25) {
            this.editError.set('El nombre debe tener entre 2 y 25 caracteres.');
            return;
        }

        if (lastName.length < 2 || lastName.length > 50) {
            this.editError.set('Los apellidos deben tener entre 2 y 50 caracteres.');
            return;
        }

        if (headquarters.length > 100) {
            this.editError.set('La sede no puede superar los 100 caracteres.');
            return;
        }

        if (!this.adminAvatars.includes(this.selectedAvatar())) {
            this.editError.set('Selecciona una imagen de perfil válida.');
            return;
        }

        const payload: UpdateAdminProfileRequest = {
            firstName,
            lastName,
            headquarters,
            profileImage: this.selectedAvatar(),
        };

        const nationalId = this.editForm.nationalId?.trim();

        if (nationalId) {
            payload.nationalId = nationalId;
        }

        this.saving.set(true);

        this.http.put<AdminProfileResponse>(this.apiUrl, payload, {
            withCredentials: true,
        }).subscribe({
            next: response => {
                const updatedProfile: AdminProfileResponse = {
                    ...response,
                    profileImage: response.profileImage || payload.profileImage,
                    headquarters: response.headquarters ?? payload.headquarters,
                };

                this.profile.set(updatedProfile);
                this.selectedAvatar.set(
                    this.getValidAvatar(updatedProfile.profileImage),
                );

                this.saving.set(false);
                this.editing.set(false);
                this.editSuccess.set(
                    'Tus datos se han actualizado correctamente.',
                );
                this.editForm = this.emptyForm();
            },
            error: (error: {
                status?: number;
                error?: {
                    message?: string;
                    detail?: string;
                    errors?: Record<string, string>;
                };
            }) => {
                this.saving.set(false);

                const validationErrors = error.error?.errors
                    ? Object.values(error.error.errors).join('. ')
                    : null;
                let defaultErrorMessage =
                    'No se han podido guardar los cambios. Inténtalo de nuevo.';

                if (error.status === 409) {
                    defaultErrorMessage =
                        'El documento de identidad ya está registrado.';
                } else if (error.status === 400) {
                    defaultErrorMessage = 'Revisa los datos introducidos.';
                }

                this.editError.set(
                    validationErrors
                    ?? error.error?.detail
                    ?? error.error?.message
                    ?? defaultErrorMessage,
                );
            },
        });
    }

    goBack(): void {
        if (window.history.length > 1) {
            this.location.back();
        } else {
            window.history.replaceState(null, '', '/admin/usuarios');
        }
    }

    logout(): void {
        this.logoutError.set(null);

        this.authService.logout().subscribe({
            next: () => {
                void this.router.navigate(['/']);
            },
            error: () => {
                this.logoutError.set(
                    'No se pudo cerrar la sesión. Inténtalo de nuevo.',
                );
            },
        });
    }
}
</file>

<file path="frontend/src/app/features/client/shipping-addresses/shipping-addresses.html">
<section class="addresses-page" aria-labelledby="addresses-title">
  <header class="page-heading">
    <div class="heading-copy">
      <p class="eyebrow">MI CUENTA</p>
      <h1 id="addresses-title">Mis direcciones</h1>
      <p class="page-description">
        Gestiona tus direcciones de envío y elige dónde recibir tus pedidos.
      </p>
    </div>

    @if (!formOpen()) {
    <button type="button" class="primary-action" data-testid="add-address" [disabled]="limitReached()" (click)="openForm()">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12 5v14M5 12h14"></path>
      </svg>
      Añadir dirección
    </button>
    }
  </header>

  @if (successMessage()) {
  <output class="success-message" aria-live="polite">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="m5 12 4 4L19 6"></path>
    </svg>
    {{ successMessage() }}
  </output>
  }

  @if (loadError()) {
  <div class="form-error" role="alert">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="12" cy="12" r="9"></circle>
      <path d="M12 8v5M12 16h.01"></path>
    </svg>
    <span>{{ loadError() }}</span>
    <button type="button" class="primary-button" (click)="loadAddresses()">Reintentar</button>
  </div>
  }

  @if (limitReached() && !formOpen()) {
  <div class="limit-notice limit-note">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M12 3 3 7.5v9L12 21l9-4.5v-9L12 3Z"></path>
      <path d="m3 7.5 9 4.5 9-4.5M12 12v9"></path>
    </svg>
    <p>Has alcanzado el límite de direcciones guardadas.</p>
  </div>
  }

  @if (formOpen()) {
  <section class="panel address-form-panel" aria-labelledby="address-form-title">
    <div class="panel-heading">
      <div class="panel-heading-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24">
          <path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"></path>
          <circle cx="12" cy="10" r="2.5"></circle>
        </svg>
      </div>

      <div class="panel-heading-text">
        <h2 id="address-form-title">
          {{ editing() ? 'Editar dirección' : 'Nueva dirección' }}
        </h2>
        <p>Introduce los datos necesarios para la entrega.</p>
      </div>
    </div>

    <form class="address-form" (ngSubmit)="save()" novalidate>
      @if (formError()) {
      <div class="form-error" role="alert">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="9"></circle>
          <path d="M12 8v5M12 16h.01"></path>
        </svg>
        <span>{{ formError() }}</span>
      </div>
      }
      <div class="field-grid">
        <div class="form-field field-full">
          <label for="recipientName">Nombre del destinatario <span class="required-mark">*</span></label>
          <input id="recipientName" name="recipientName" type="text" [(ngModel)]="form.recipientName"
            (ngModelChange)="onFieldChange()" autocomplete="name" placeholder="Nombre y apellidos"
            [class.invalid]="submitted() && fieldErrors()['recipientName']"
            [attr.aria-invalid]="submitted() && fieldErrors()['recipientName'] ? 'true' : null"
            [attr.aria-describedby]="submitted() && fieldErrors()['recipientName'] ? 'recipientName-error' : null"
            required>
          @if (submitted() && fieldErrors()['recipientName']) {
          <span class="field-error" id="recipientName-error">
            {{ fieldErrors()['recipientName'] }}
          </span>
          }
        </div>

        <div class="form-field field-full">
          <label for="street">Dirección <span class="required-mark">*</span></label>
          <input id="street" name="street" type="text" [(ngModel)]="form.street" (ngModelChange)="onFieldChange()"
            autocomplete="address-line1" placeholder="Calle, número, piso y puerta"
            [class.invalid]="submitted() && fieldErrors()['street']"
            [attr.aria-invalid]="submitted() && fieldErrors()['street'] ? 'true' : null"
            [attr.aria-describedby]="submitted() && fieldErrors()['street'] ? 'street-error' : null" required>
          @if (submitted() && fieldErrors()['street']) {
          <span class="field-error" id="street-error">
            {{ fieldErrors()['street'] }}
          </span>
          }
        </div>

        <div class="form-field field-full">
          <label for="additionalInfo">
            Información adicional
          </label>
          <input id="additionalInfo" name="additionalInfo" type="text" [(ngModel)]="form.additionalInfo"
            (ngModelChange)="onFieldChange()" autocomplete="address-line2"
            placeholder="Bloque, escalera o indicaciones para la entrega">
        </div>

        <div class="form-field">
          <label for="postalCode">Código postal <span class="required-mark">*</span></label>
          <input id="postalCode" name="postalCode" type="text" [(ngModel)]="form.postalCode"
            (ngModelChange)="onFieldChange()" autocomplete="postal-code" inputmode="numeric" placeholder="Ej. 13001"
            [class.invalid]="submitted() && fieldErrors()['postalCode']"
            [attr.aria-invalid]="submitted() && fieldErrors()['postalCode'] ? 'true' : null"
            [attr.aria-describedby]="submitted() && fieldErrors()['postalCode'] ? 'postalCode-error' : null" required>
          @if (submitted() && fieldErrors()['postalCode']) {
          <span class="field-error" id="postalCode-error">
            {{ fieldErrors()['postalCode'] }}
          </span>
          }
        </div>

        <div class="form-field">
          <label for="city">Localidad <span class="required-mark">*</span></label>
          <input id="city" name="city" type="text" [(ngModel)]="form.city" (ngModelChange)="onFieldChange()"
            autocomplete="address-level2" placeholder="Localidad" [class.invalid]="submitted() && fieldErrors()['city']"
            [attr.aria-invalid]="submitted() && fieldErrors()['city'] ? 'true' : null"
            [attr.aria-describedby]="submitted() && fieldErrors()['city'] ? 'city-error' : null" required>
          @if (submitted() && fieldErrors()['city']) {
          <span class="field-error" id="city-error">
            {{ fieldErrors()['city'] }}
          </span>
          }
        </div>

        <div class="form-field">
          <label for="province">Provincia <span class="required-mark">*</span></label>
          <input id="province" name="province" type="text" [(ngModel)]="form.province" (ngModelChange)="onFieldChange()"
            autocomplete="address-level1" placeholder="Provincia"
            [class.invalid]="submitted() && fieldErrors()['province']"
            [attr.aria-invalid]="submitted() && fieldErrors()['province'] ? 'true' : null"
            [attr.aria-describedby]="submitted() && fieldErrors()['province'] ? 'province-error' : null" required>
          @if (submitted() && fieldErrors()['province']) {
          <span class="field-error" id="province-error">
            {{ fieldErrors()['province'] }}
          </span>
          }
        </div>

        <div class="form-field field-full">
          <label for="phone">Teléfono de contacto</label>
          <input id="phone" name="phone" type="tel" inputmode="numeric" maxlength="9" autocomplete="tel"
            [(ngModel)]="form.phone" (ngModelChange)="onFieldChange()" autocomplete="tel" inputmode="tel"
            placeholder="Teléfono para incidencias con la entrega"
            [class.invalid]="submitted() && fieldErrors()['phone']"
            [attr.aria-invalid]="submitted() && fieldErrors()['phone'] ? 'true' : null"
            [attr.aria-describedby]="submitted() && fieldErrors()['phone'] ? 'phone-error' : null" required>
          @if (submitted() && fieldErrors()['phone']) {
          <span class="field-error" id="phone-error">
            {{ fieldErrors()['phone'] }}
          </span>
          }
        </div>
      </div>

      <label class="default-option" for="isDefault">
        <input id="isDefault" name="isDefault" type="checkbox" [(ngModel)]="form.isDefault">
        <span class="custom-checkbox" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path d="m5 12 4 4L19 6"></path>
          </svg>
        </span>
        <span class="default-option-copy">
          <strong>Usar como dirección predeterminada</strong>
          <small>Se utilizará inicialmente para tus próximos pedidos.</small>
        </span>
      </label>

      <div class="form-actions">
        <button type="button" class="secondary-button" (click)="cancelForm()" [disabled]="saving()">
          Cancelar
        </button>

        <button type="submit" class="primary-action" [disabled]="saving()">
          @if (saving()) {
          <span class="button-spinner" aria-hidden="true"></span>
          {{ editing() ? 'Guardando...' : 'Añadiendo...' }}
          } @else {
          {{ editing() ? 'Guardar cambios' : 'Guardar dirección' }}
          }
        </button>
      </div>
    </form>
  </section>
  }

  <section class="addresses-section" aria-labelledby="saved-addresses-title">
    <div class="section-heading">
      <div>
        <h2 id="saved-addresses-title">Direcciones guardadas</h2>
        <p>Consulta y administra los datos de entrega.</p>
      </div>

      <span class="address-count">
        {{ addresses().length }}
        {{ addresses().length === 1 ? 'dirección' : 'direcciones' }}
      </span>
    </div>

    @if (loading()) {
    <div class="state-card" aria-live="polite">
      <span class="loading-spinner" aria-hidden="true"></span>
      <p>Cargando tus direcciones...</p>
    </div>
    } @else if (addresses().length === 0) {
    <div class="state-card empty-state">
      <div class="empty-state-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24">
          <path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"></path>
          <circle cx="12" cy="10" r="2.5"></circle>
        </svg>
      </div>

      <h3>Aún no tienes direcciones</h3>
      <p>Añade una dirección para tener tus datos de entrega preparados.</p>

      @if (!formOpen()) {
      <button type="button" class="primary-action" data-testid="add-address" [disabled]="limitReached()" (click)="openForm()">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 5v14M5 12h14"></path>
        </svg>
        Añadir mi primera dirección
      </button>
      }
    </div>
    } @else {
    <div class="address-list">
      @for (address of addresses(); track address.id) {
      <article class="address-card" [class.is-default]="address.isDefault">
        <div class="address-card-top">
          <div class="address-identity">
            <div class="address-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                <path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"></path>
                <circle cx="12" cy="10" r="2.5"></circle>
              </svg>
            </div>

            <div class="address-recipient">
              <h3>{{ address.recipientName }}</h3>
              <p>{{ address.street }}{{ address.additionalInfo ? ', ' + address.additionalInfo : '' }}</p>
            </div>
          </div>

          @if (address.isDefault) {
          <span class="default-badge">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="m5 12 4 4L19 6"></path>
            </svg>
            Predeterminada
          </span>
          } @else {
          <button type="button" class="set-default-button" (click)="setDefaultAddress(address)"
            [disabled]="saving() || deletingAddressId() === address.id"
            [attr.aria-label]="'Establecer como predeterminada la dirección de ' + address.recipientName"
            title="Marcar como predeterminada">
            Marcar como predeterminada
          </button>
          }
        </div>

        <div class="address-details">
          @if (address.additionalInfo) {
          <p class="detail-row">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M4 5h16M4 12h16M4 19h10"></path>
            </svg>
            <span>{{ address.additionalInfo }}</span>
          </p>
          }

          <p class="detail-row">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 21s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12Z"></path>
              <circle cx="12" cy="9" r="2.5"></circle>
            </svg>
            <span>{{ address.postalCode }} · {{ address.city }}, {{ address.province }}</span>
          </p>


          @if (address.phone?.trim()) {
          <p class="detail-row">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="M7.5 3.5h2l1.2 4.2-1.8 1.8a14.7 14.7 0 0 0 5.6 5.6l1.8-1.8 4.2 1.2v2c0 1.1-.9 2-2 2C11.6 18.5 5.5 12.4 5.5 5.5c0-1.1.9-2 2-2Z">
              </path>
            </svg>
            <span>{{ address.phone }}</span>
          </p>
          }

        </div>

        @if (deleteError() && deletingAddressId() === address.id) {
        <p class="form-error card-error" role="alert">
          {{ deleteError() }}
        </p>
        }

        <div class="address-card-footer">
          <div class="address-actions">
            <button type="button" class="icon-action edit-button" (click)="openEdit(address)"
              [disabled]="saving() || deletingAddressId() === address.id"
              [attr.aria-label]="'Editar dirección de ' + address.recipientName" title="Editar dirección">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 20h9"></path>
                <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"></path>
              </svg>
              <span>Editar</span>
            </button>

            <button type="button" class="icon-action delete-button" (click)="confirmDeleteAddress(address)"
              [disabled]="deletingAddressId() === address.id || saving()"
              [attr.aria-label]="'Eliminar dirección de ' + address.recipientName" title="Eliminar dirección">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M3 6h18"></path>
                <path d="M8 6V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2"></path>
                <path d="m19 6-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path>
                <path d="M10 11v6M14 11v6"></path>
              </svg>
              <span>
                {{ deletingAddressId() === address.id ? 'Eliminando...' : 'Eliminar' }}
              </span>
            </button>
          </div>
        </div>
      </article>
      }
    </div>
    }
  </section>

  @if (addressPendingDeletion(); as pendingAddress) {
  <div class="dialog-backdrop">
    <section class="confirm-dialog" role="alertdialog" aria-modal="true" aria-labelledby="delete-dialog-title"
      aria-describedby="delete-dialog-description">
      <div class="dialog-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24">
          <path d="M12 9v4M12 17h.01"></path>
          <path d="M10.3 3.9 2.7 17a2 2 0 0 0 1.7 3h15.2a2 2 0 0 0 1.7-3l-7.6-13.1a2 2 0 0 0-3.4 0Z"></path>
        </svg>
      </div>

      <h2 id="delete-dialog-title">Eliminar dirección</h2>
      <p id="delete-dialog-description">
        ¿Quieres eliminar la dirección de
        <strong>{{ pendingAddress.recipientName }}</strong>?
      </p>
      <p class="dialog-warning">
        Esta acción no se puede deshacer.
      </p>

      @if (deleteError()) {
      <p class="form-error" role="alert">{{ deleteError() }}</p>
      }

      <div class="dialog-actions">
        <button type="button" class="secondary-button" (click)="cancelDeleteAddress()"
          [disabled]="deletingAddressId() === pendingAddress.id">
          Cancelar
        </button>

        <button type="button" class="danger-button" (click)="deleteAddress()"
          [disabled]="deletingAddressId() === pendingAddress.id">
          {{ deletingAddressId() === pendingAddress.id ? 'Eliminando...' : 'Sí, eliminar' }}
        </button>
      </div>
    </section>
  </div>
  }
</section>
</file>

