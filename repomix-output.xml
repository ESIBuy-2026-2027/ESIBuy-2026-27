    padding-top: 15px;
}

.payment-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
}

.icon-action {
    display: inline-flex;
    min-height: 35px;
    align-items: center;
    justify-content: center;
    gap: 7px;
    padding: 0 10px;
    border: 1px solid transparent;
    border-radius: 8px;
    font-family: inherit;
    font-size: 11px;
    font-weight: 700;
    cursor: pointer;
    transition:
        background-color 0.2s ease,
        border-color 0.2s ease,
        color 0.2s ease;
}

.icon-action svg {
    width: 15px;
    height: 15px;
}

.edit-button {
    border-color: #d9e3eb;
    background: #fff;
    color: #3a5871;
}

.edit-button:hover:not(:disabled) {
    border-color: #9aafbf;
    background: #f4f8f9;
    color: var(--color-text-primary);
}

.delete-button {
    border-color: #f1d2d5;
    background: #fff;
    color: #a12632;
}

.delete-button:hover:not(:disabled) {
    border-color: #d9a0a5;
    background: #fff1f2;
    color: #842029;
}

/* FOCO ACCESIBLE */

:where(
    .primary-action,
    .secondary-button,
    .set-default-button,
    .icon-action
):focus-visible {
    outline: 3px solid rgb(66 191 163 / 35%);
    outline-offset: 3px;
}

/* RESPONSIVE */

@media (max-width: 760px) {
    .payment-page {
        padding: 25px 20px;
    }

    .payment-list {
        grid-template-columns: minmax(0, 1fr);
    }

    .payment-card {
        padding: 18px;
    }

    .panel {
        padding: 22px 18px;
    }
}

@media (max-width: 520px) {
    .payment-page {
        padding: 22px 15px;
        border-radius: 12px;
    }

    .page-heading {
        align-items: stretch;
        flex-direction: column;
        gap: 15px;
        margin-bottom: 24px;
    }

    .page-heading .primary-action {
        width: 100%;
    }

    .field-grid {
        grid-template-columns: minmax(0, 1fr);
        gap: 15px;
    }

    .form-field-group {
        grid-template-columns: minmax(0, 1fr);
        gap: 15px;
    }

    .form-actions {
        flex-direction: column-reverse;
    }

    .form-actions button {
        width: 100%;
    }

    .payment-card-top {
        flex-wrap: wrap;
    }

    .set-default-button {
        width: 100%;
    }

    .payment-actions {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}


/* MODAL DE CONFIRMACIÓN DE ELIMINACIÓN */

.modal-backdrop {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    background: rgb(16 44 64 / 55%);
    backdrop-filter: blur(3px);
}

.confirm-modal {
    width: min(100%, 440px);
    padding: 28px;
    border: 1px solid #d9e3eb;
    border-radius: 16px;
    background: #fff;
    box-shadow: 0 20px 60px rgb(16 44 64 / 22%);
    animation: modal-appear 0.18s ease-out;
}

.confirm-modal-icon {
    display: grid;
    width: 48px;
    height: 48px;
    place-items: center;
    margin-bottom: 18px;
    border: 1px solid #f1d2d5;
    border-radius: 13px;
    background: #fff1f2;
    color: #a12632;
}

.confirm-modal-icon svg {
    width: 23px;
    height: 23px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
}

.confirm-modal h2 {
    margin: 0 0 10px;
    color: var(--color-text-primary);
    font-size: 19px;
    font-weight: 750;
    letter-spacing: -0.3px;
}

.confirm-modal p {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 13px;
    line-height: 1.7;
    overflow-wrap: anywhere;
}

.confirm-modal p strong {
    color: var(--color-text-primary);
    font-weight: 750;
}

.confirm-modal-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 10px;
    margin-top: 26px;
    padding-top: 18px;
    border-top: 1px solid #e7edf0;
}

.confirm-delete-button {
    display: inline-flex;
    min-height: 40px;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 0 15px;
    border: 1px solid #a12632;
    border-radius: 8px;
    background: #a12632;
    color: #fff;
    font-family: inherit;
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
    transition: background-color 0.2s ease;
}

.confirm-delete-button:hover:not(:disabled) {
    border-color: #842029;
    background: #842029;
}

.confirm-delete-button:disabled {
    cursor: not-allowed;
    opacity: 0.6;
}

.confirm-modal-actions button:focus-visible {
    outline: 3px solid rgb(66 191 163 / 35%);
    outline-offset: 3px;
}

@keyframes modal-appear {
    from {
        opacity: 0;
        transform: translateY(8px) scale(0.98);
    }

    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }
}

@media (max-width: 480px) {
    .confirm-modal {
        padding: 22px;
    }

    .confirm-modal-actions {
        flex-direction: column-reverse;
    }

    .confirm-modal-actions button {
        width: 100%;
    }
}

@media (prefers-reduced-motion: reduce) {
    .confirm-modal {
        animation: none;
    }
}
</file>

<file path="frontend/src/app/features/client/payment-methods/payment-methods.html">
<section class="payment-page" aria-labelledby="payment-title">
    <header class="page-heading">
        <div class="heading-copy">
            <p class="eyebrow">MI CUENTA</p>
            <h1 id="payment-title">Mis métodos de pago</h1>
            <p class="page-description">
                Gestiona tus tarjetas y los métodos de pago guardados en tu cuenta.
            </p>
        </div>

        @if (!formVisible()) {
        <button type="button" class="primary-action" (click)="openForm()" [disabled]="loading()">
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 5v14M5 12h14"></path>
            </svg>
            Añadir método
        </button>
        }
    </header>

    @if (success(); as message) {
    <output class="success-message" aria-live="polite">
        <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="m5 12 4 4L19 6"></path>
        </svg>
        {{ message }}
    </output>
    }

    @if (error(); as message) {
    <div class="form-error" role="alert">
        <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="9"></circle>
            <path d="M12 8v5M12 16h.01"></path>
        </svg>
        <span>{{ message }}</span>
    </div>
    }

    @if (formVisible()) {
    <section class="panel payment-form-panel" aria-labelledby="payment-form-title">
        <div class="panel-heading">
            <div class="panel-heading-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                    <rect x="3" y="5" width="18" height="14" rx="2.5"></rect>
                    <path d="M3 10h18M7 15h3"></path>
                </svg>
            </div>

            <div class="panel-heading-text">
                <h2 id="payment-form-title">
                    {{ editingMethodId() !== null
                    ? 'Editar método de pago'
                    : 'Nuevo método de pago' }}
                </h2>
                <p>
                    {{ editingMethodId() !== null
                    ? 'Modifica los datos del método de pago seleccionado.'
                    : 'Introduce los datos del método que quieres guardar.' }}
                </p>
            </div>
        </div>

        <form class="payment-form" (ngSubmit)="save()" [attr.aria-label]="editingMethodId() !== null
                ? 'Editar método de pago'
                : 'Nuevo método de pago'">

            <div class="field-grid">
                <div class="form-field">
                    <label for="paymentType">
                        Tipo de método <span class="required-mark">*</span>
                    </label>
                    <select id="paymentType" name="paymentType" [ngModel]="selectedType()"
                        (ngModelChange)="updateType($event)" [disabled]="saving()">
                        <option value="CARD">Tarjeta</option>
                        <option value="PAYPAL">PayPal</option>
                        <option value="BIZUM">Bizum</option>
                    </select>
                </div>

                <div class="form-field">
                    <label for="paymentLabel">
                        Nombre identificativo
                    </label>
                    <input id="paymentLabel" name="paymentLabel" type="text" maxlength="40"
                        placeholder="Ej. Mi tarjeta personal" [ngModel]="form().label"
                        (ngModelChange)="updateField('label', $event)" [disabled]="saving()" />
                    <small>Te ayudará a reconocer el método guardado.</small>
                </div>

                @if (selectedType() === 'CARD') {
                <div class="form-field field-full">
                    <label for="cardholderName">
                        Titular de la tarjeta <span class="required-mark">*</span>
                    </label>
                    <input id="cardholderName" name="cardholderName" type="text" minlength="2" maxlength="80"
                        autocomplete="cc-name" placeholder="Nombre que aparece en la tarjeta"
                        [ngModel]="form().cardholderName" (ngModelChange)="updateField('cardholderName', $event)"
                        [disabled]="saving()" required />
                </div>

                <div class="form-field">
                    <label for="cardBrand">
                        Marca de la tarjeta <span class="required-mark">*</span>
                    </label>
                    <select id="cardBrand" name="cardBrand" [ngModel]="form().cardBrand"
                        (ngModelChange)="updateField('cardBrand', $event)" [disabled]="saving()">
                        <option value="VISA">Visa</option>
                        <option value="MASTERCARD">Mastercard</option>
                        <option value="AMEX">American Express</option>
                        <option value="OTHER">Otra</option>
                    </select>
                </div>

                <div class="form-field-group">
                    <div class="form-field">
                        <label for="lastFourDigits">
                            Últimas 4 cifras <span class="required-mark">*</span>
                        </label>
                        <input id="lastFourDigits" name="lastFourDigits" type="text" inputmode="numeric"
                            autocomplete="off" maxlength="4" pattern="[0-9]{4}" placeholder="1234"
                            [ngModel]="form().lastFourDigits" (ngModelChange)="updateField('lastFourDigits', $event)"
                            [disabled]="saving()" required />
                    </div>

                    <div class="form-field">
                        <label for="expiration">
                            Caducidad <span class="required-mark">*</span>
                        </label>
                        <input id="expiration" name="expiration" type="text" inputmode="numeric" autocomplete="cc-exp"
                            placeholder="MM/AA" maxlength="5" pattern="(0[1-9]|1[0-2])/[0-9]{2}"
                            [ngModel]="form().expiration"
                            (ngModelChange)="updateField('expiration', formatExpiration($event))" [disabled]="saving()"
                            required />
                    </div>
                </div>
                }

                @if (selectedType() === 'PAYPAL') {
                <div class="form-field field-full">
                    <label for="paypalEmail">
                        Correo de PayPal <span class="required-mark">*</span>
                    </label>
                    <input id="paypalEmail" name="paypalEmail" type="email" maxlength="254" autocomplete="email"
                        placeholder="tu-correo@ejemplo.com" [ngModel]="form().paypalEmail"
                        (ngModelChange)="updateField('paypalEmail', $event)" [disabled]="saving()" required />
                </div>
                }

                @if (selectedType() === 'BIZUM') {
                <div class="form-field">
                    <label for="bizumPhone">
                        Teléfono asociado a Bizum <span class="required-mark">*</span>
                    </label>
                    <input id="bizumPhone" name="bizumPhone" type="tel" inputmode="numeric" maxlength="9"
                        pattern="[0-9]{9}" autocomplete="tel" placeholder="Ej. 600000000" [ngModel]="form().bizumPhone"
                        (ngModelChange)="updateField('bizumPhone', $event)" [disabled]="saving()" required />
                </div>
                }
            </div>

            <label class="default-option" for="defaultMethod">
                <input id="defaultMethod" type="checkbox" name="defaultMethod" [ngModel]="form().defaultMethod"
                    (ngModelChange)="updateField('defaultMethod', $event)" [disabled]="saving()" />

                <span class="custom-checkbox" aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                        <path d="m5 12 4 4L19 6"></path>
                    </svg>
                </span>

                <span class="default-option-copy">
                    <strong>Usar como método predeterminado</strong>
                    <small>Se utilizará como opción predeterminada para tus próximos pagos.</small>
                </span>
            </label>

            <div class="payment-notice">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="12" cy="12" r="9"></circle>
                    <path d="M12 11v5M12 8h.01"></path>
                </svg>
                <p>
                    Esta sección guarda datos identificativos para la simulación de pagos.
                    No procesa cobros ni verifica cuentas externas.
                </p>
            </div>

            <div class="form-actions">
                <button type="button" class="secondary-button" (click)="cancelForm()" [disabled]="saving()">
                    Cancelar
                </button>

                <button type="submit" class="primary-action" [disabled]="saving()">
                    @if (saving()) {
                    <span class="button-spinner" aria-hidden="true"></span>
                    {{ editingMethodId() !== null ? 'Guardando...' : 'Añadiendo...' }}
                    } @else {
                    {{ editingMethodId() !== null ? 'Guardar cambios' : 'Guardar método' }}
                    }
                </button>
            </div>
        </form>
    </section>
    }

    <section class="payment-section" aria-labelledby="saved-methods-title">
        <div class="section-heading">
            <div>
                <h2 id="saved-methods-title">Métodos guardados</h2>
                <p>Consulta y administra tus opciones de pago.</p>
            </div>

            <span class="method-count">
                {{ methods().length }}
                {{ methods().length === 1 ? 'método' : 'métodos' }}
            </span>
        </div>

        @if (loading()) {
        <div class="state-card" aria-live="polite">
            <span class="loading-spinner" aria-hidden="true"></span>
            <p>Cargando tus métodos de pago...</p>
        </div>
        } @else if (methods().length === 0 && !formVisible()) {
        <div class="state-card empty-state">
            <div class="empty-state-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                    <rect x="3" y="5" width="18" height="14" rx="2.5"></rect>
                    <path d="M3 10h18M7 15h3"></path>
                </svg>
            </div>

            <h3>Aún no tienes métodos de pago</h3>
            <p>
                Añade una tarjeta, una cuenta de PayPal o un teléfono de Bizum
                para tener tus datos preparados.
            </p>

            <button type="button" class="primary-action" (click)="openForm()" [disabled]="loading()">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 5v14M5 12h14"></path>
                </svg>
                Añadir método
            </button>
        </div>
        } @else {
        @if (cardMethods().length > 0) {
        <h3 class="group-title">Tarjetas</h3>

        <div class="payment-list">
            @for (method of cardMethods(); track method.id) {
            <article class="payment-card" [class.is-default]="method.isDefault">
                <div class="payment-card-top">
                    <div class="payment-identity">
                        <div class="payment-icon card-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24">
                                <rect x="3" y="5" width="18" height="14" rx="2.5"></rect>
                                <path d="M3 10h18M7 15h3"></path>
                            </svg>
                        </div>

                        <div class="payment-name">
                            <h3>{{ method.label || methodTypeLabel(method.type) }}</h3>
                            <p>
                                {{ method.cardBrand || 'Tarjeta' }}
                                ···· {{ method.lastFourDigits || '----' }}
                            </p>
                        </div>
                    </div>

                    @if (method.isDefault) {
                    <span class="default-badge">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="m5 12 4 4L19 6"></path>
                        </svg>
                        Predeterminado
                    </span>
                    } @else {
                    <button type="button" class="set-default-button" (click)="setDefault(method)"
                        [disabled]="actionId() !== null"
                        [attr.aria-label]="'Establecer como predeterminada la tarjeta ' + (method.label || methodTypeLabel(method.type))">
                        {{ actionId() === method.id ? 'Actualizando...' : 'Hacer predeterminada' }}
                    </button>
                    }
                </div>

                <div class="payment-details">
                    <p class="detail-row">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <circle cx="12" cy="8" r="4"></circle>
                            <path d="M4 21a8 8 0 0 1 16 0"></path>
                        </svg>
                        <span>Titular: {{ method.cardholderName || 'No indicado' }}</span>
                    </p>

                    @if (expirationLabel(method); as expiration) {
                    <p class="detail-row">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <rect x="3" y="5" width="18" height="16" rx="2"></rect>
                            <path d="M16 3v4M8 3v4M3 10h18"></path>
                        </svg>
                        <span>Caducidad: {{ expiration }}</span>
                    </p>
                    }
                </div>

                <div class="payment-card-footer">
                    <div class="payment-actions">
                        <button type="button" class="icon-action edit-button" (click)="openEdit(method)"
                            [disabled]="actionId() !== null"
                            [attr.aria-label]="'Editar método ' + (method.label || methodTypeLabel(method.type))">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M12 20h9"></path>
                                <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"></path>
                            </svg>
                            <span>Editar</span>
                        </button>

                        <button type="button" class="icon-action delete-button" (click)="deleteMethod(method)"
                            [disabled]="actionId() !== null"
                            [attr.aria-label]="'Eliminar método ' + (method.label || methodTypeLabel(method.type))">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6"></path>
                                <path d="M10 11v5M14 11v5"></path>
                            </svg>
                            <span>Eliminar</span>
                        </button>
                    </div>
                </div>
            </article>
            }
        </div>
        }

        @if (otherMethods().length > 0) {
        <h3 class="group-title">Otros métodos</h3>

        <div class="payment-list">
            @for (method of otherMethods(); track method.id) {
            <article class="payment-card" [class.is-default]="method.isDefault">
                <div class="payment-card-top">
                    <div class="payment-identity">
                        <div class="payment-icon" [class.paypal-icon]="method.type === 'PAYPAL'"
                            [class.bizum-icon]="method.type === 'BIZUM'" aria-hidden="true">
                            @if (method.type === 'PAYPAL') {
                            <img class="payment-logo paypal-logo"
                                src="https://www.paypalobjects.com/paypal-ui/logos/svg/paypal-wordmark-color.svg"
                                alt="" />
                            } @else {
                            <img class="payment-logo bizum-logo"
                                src="https://commons.wikimedia.org/wiki/Special:Redirect/file/Bizum.svg" alt="" />
                            }
                        </div>

                        <div class="payment-name">
                            <h3>{{ method.label || methodTypeLabel(method.type) }}</h3>
                            @if (method.type === 'PAYPAL') {
                            <p>{{ method.paypalEmail || 'Correo no indicado' }}</p>
                            } @else {
                            <p>{{ method.bizumPhone || 'Teléfono no indicado' }}</p>
                            }
                        </div>
                    </div>

                    @if (method.isDefault) {
                    <span class="default-badge">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="m5 12 4 4L19 6"></path>
                        </svg>
                        Predeterminado
                    </span>
                    } @else {
                    <button type="button" class="set-default-button" (click)="setDefault(method)"
                        [disabled]="actionId() !== null"
                        [attr.aria-label]="'Marcar como predeterminado ' + (method.label || methodTypeLabel(method.type))">
                        {{ actionId() === method.id ? 'Actualizando...' : 'Marcar como predeterminado' }}
                    </button>
                    }
                </div>

                <div class="payment-card-footer">
                    <div class="payment-actions">
                        <button type="button" class="icon-action edit-button" (click)="openEdit(method)"
                            [disabled]="actionId() !== null"
                            [attr.aria-label]="'Editar método ' + (method.label || methodTypeLabel(method.type))">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M12 20h9"></path>
                                <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"></path>
                            </svg>
                            <span>Editar</span>
                        </button>

                        <button type="button" class="icon-action delete-button" (click)="deleteMethod(method)"
                            [disabled]="actionId() !== null"
                            [attr.aria-label]="'Eliminar método ' + (method.label || methodTypeLabel(method.type))">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6"></path>
                                <path d="M10 11v5M14 11v5"></path>
                            </svg>
                            <span>Eliminar</span>
                        </button>
                    </div>
                </div>
            </article>
            }
        </div>
        }

        }

    </section>
    @if (methodToDelete(); as method) {
    <div class="modal-backdrop" (click)="cancelDelete()" (keydown.escape)="cancelDelete()">
        <section class="confirm-modal" role="alertdialog" aria-modal="true" aria-labelledby="delete-modal-title"
            aria-describedby="delete-modal-description">

            <div class="confirm-modal-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                    <path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6"></path>
                    <path d="M10 11v5M14 11v5"></path>
                </svg>
            </div>

            <h2 id="delete-modal-title">
                Eliminar método de pago
            </h2>

            <p id="delete-modal-description">
                ¿Seguro que quieres eliminar
                <strong>{{ method.label || methodTypeLabel(method.type) }}</strong>?
                Esta acción no se puede deshacer.
            </p>

            <div class="confirm-modal-actions">
                <button type="button" class="secondary-button" (click)="cancelDelete()"
                    [disabled]="actionId() !== null">
                    Cancelar
                </button>

                <button type="button" class="confirm-delete-button" (click)="confirmDelete()"
                    [disabled]="actionId() !== null">

                    @if (actionId() === method.id) {
                    <span class="button-spinner" aria-hidden="true"></span>
                    Eliminando...
                    } @else {
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6"></path>
                        <path d="M10 11v5M14 11v5"></path>
                    </svg>
                    Eliminar método
                    }
                </button>
            </div>
        </section>
    </div>
    }
</section>
</file>

<file path="frontend/src/app/features/identity/login/login.css">
:host {
  display: block;
  width: 100%;
  min-width: 0;
  color: #192338;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
}

.login-page {
  display: grid;
  box-sizing: border-box;
  width: 100%;
  min-height: calc(100vh - var(--app-header-height, 4rem));
  min-height: calc(100dvh - var(--app-header-height, 4rem));
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  background: #fff;
}

.welcome-panel {
  position: relative;
  display: flex;
  min-width: 0;
  flex-direction: column;
  justify-content: space-between;
  overflow: hidden;
  box-sizing: border-box;
  padding: 3.5rem 10%;
  background: linear-gradient(140deg, #edf4ff 0%, #f5f9ff 55%, #edf8f5 100%);
}

.welcome-panel::before,
.welcome-panel::after {
  position: absolute;
  z-index: 0;
  border-radius: 50%;
  background: rgb(255 255 255 / 55%);
  content: "";
  pointer-events: none;
}

.welcome-panel::before {
  top: -17rem;
  right: -9rem;
  width: 31rem;
  height: 31rem;
}

.welcome-panel::after {
  bottom: -15rem;
  left: -10rem;
  width: 26rem;
  height: 26rem;
}

.brand,
.welcome-copy,
.shopping-illustration {
  position: relative;
  z-index: 1;
}

.brand {
  width: fit-content;
  color: #192338;
  font-size: 1.25rem;
  font-weight: 800;
  letter-spacing: -0.04em;
  text-decoration: none;
}

.brand-name span {
  color: #0a2c3a;
}

.welcome-copy {
  max-width: 34rem;
  margin: 3rem 0;
}

.eyebrow {
  margin: 0 0 1rem;
  color: #0a2c3a;
  font-size: 0.8rem;
  font-weight: 800;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.welcome-copy h2 {
  max-width: 11ch;
  margin: 0;
  color: #192338;
  font-size: clamp(2.5rem, 4.2vw, 3.5rem);
  font-weight: 750;
  letter-spacing: -0.055em;
  line-height: 1.08;
}

.welcome-text {
  max-width: 31rem;
  margin: 1.25rem 0 0;
  color: #64728a;
  font-size: 1rem;
  line-height: 1.65;
}

.shopping-illustration {
  position: relative;
  min-height: 12rem;
}

.order-card,
.payment-card {
  position: absolute;
  display: flex;
  flex-direction: column;
  gap: 0.8rem;
  box-sizing: border-box;
  border: 1px solid #edf1f7;
  border-radius: 1.2rem;
  background: #fff;
  box-shadow: 0 1rem 2.5rem rgb(33 58 99 / 10%);
}

.order-card {
  bottom: 3rem;
  left: 12%;
  width: 13rem;
  padding: 1.2rem;
  transform: rotate(-7deg);
}

.order-card > span,
.payment-card > span {
  color: #8290a8;
  font-size: 0.7rem;
  font-weight: 800;
  text-transform: uppercase;
}

.progress-bar {
  width: 75%;
  height: 0.6rem;
  border-radius: 999px;
  background: #0a2c3a;
}

.order-card p {
  margin: 0;
  color: #4acdbb;
  font-size: 0.75rem;
  font-weight: 700;
}

.payment-card {
  right: 15%;
  bottom: 0;
  width: 16rem;
  min-height: 10rem;
  padding: 1.25rem;
}

.payment-card strong {
  margin-top: 0.3rem;
  color: #192338;
  font-size: 1.1rem;
  letter-spacing: 0.12em;
}

.payment-card small {
  margin-top: auto;
  color: #8290a8;
  font-size: 0.65rem;
}

.auth-panel {
  display: flex;
  min-width: 0;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 3rem clamp(1.5rem, 5vw, 4rem);
  background: #fff;
}

.login-card {
  width: 100%;
  max-width: 28rem;
  min-width: 0;
  padding: 0;
  box-sizing: border-box;
  border: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
}

.login-header {
  margin-bottom: 2rem;
}

.login-header h1 {
  margin: 0;
  color: #192338;
  font-size: 1.8rem;
  font-weight: 750;
  letter-spacing: -0.035em;
}

.login-subtitle {
  margin: 0.55rem 0 0;
  color: #7b879b;
  font-size: 0.9rem;
  line-height: 1.55;
}

.server-error-banner,
.server-success-banner {
  display: block;
  margin-bottom: 1.25rem;
  padding: 0.85rem 1rem;
  border-radius: 0.75rem;
  font-size: 0.9rem;
  font-weight: 600;
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.server-error-banner {
  border: 1px solid #fecaca;
  background: #fef2f2;
  color: #b91c1c;
}

.server-success-banner {
  border: 1px solid #bbf7d0;
  background: #f0fdf4;
  color: #166534;
}

.login-form {
  width: 100%;
  min-width: 0;
}

.form-section {
  min-width: 0;
  margin: 0 0 1.5rem;
  padding: 0;
  border: 0;
}

.form-group {
  display: flex;
  min-width: 0;
  flex-direction: column;
  margin-bottom: 1.25rem;
}

.form-group:last-child {
  margin-bottom: 0;
}

.form-group label {
  margin-bottom: 0.45rem;
  color: #1e293b;
  font-size: 0.9rem;
  font-weight: 650;
}

.form-group input {
  display: block;
  width: 100%;
  min-width: 0;
  min-height: 3rem;
  padding: 0.8rem 0.9rem;
  box-sizing: border-box;
  border: 1px solid #cbd5e1;
  border-radius: 0.7rem;
  outline: none;
  background: #fff;
  color: #1e293b;
  font-family: inherit;
  font-size: 0.95rem;
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.form-group input::placeholder {
  color: #94a3b8;
}

.form-group input:hover:not(:disabled) {
  border-color: #94a3b8;
}

.form-group input:focus {
  border-color: #0a2c3a;
  box-shadow: 0 0 0 3px rgb(66 214 178 / 22%);
}

.form-group input:disabled {
  background: #f8fafc;
  color: #64748b;
  cursor: not-allowed;
}

.password-wrapper {
  position: relative;
  width: 100%;
  min-width: 0;
}

.password-wrapper input {
  padding-right: 3.25rem;
}

.password-toggle {
  position: absolute;
  top: 50%;
  right: 0.75rem;
  display: flex;
  width: 1.75rem;
  height: 1.75rem;
  align-items: center;
  justify-content: center;
  padding: 0;
  transform: translateY(-50%);
  border: 0;
  border-radius: 0.4rem;
  background: transparent;
  color: #64748b;
  cursor: pointer;
}

.password-toggle:hover {
  background: #f1f5f9;
  color: #0a2c3a;
}

.password-toggle:focus-visible,
.forgot-password-link:focus-visible {
  outline: 2px solid #0a2c3a;
  outline-offset: 3px;
}

.password-toggle svg {
  display: block;
  width: 1.25rem;
  height: 1.25rem;
}

.error {
  display: block;
  margin-top: 0.4rem;
  color: #dc2626;
  font-size: 0.8rem;
  line-height: 1.4;
}

.btn-submit {
  display: inline-flex;
  width: 100%;
  min-height: 3rem;
  align-items: center;
  justify-content: center;
  padding: 0.85rem 1rem;
  border: 1px solid transparent;
  border-radius: 0.7rem;
  background: #0a2c3a;
  color: #fff;
  font-family: inherit;
  font-size: 0.95rem;
  font-weight: 750;
  line-height: 1.4;
  text-align: center;
  cursor: pointer;
  transition: background 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
}

.btn-submit:hover:not(:disabled) {
  transform: translateY(-1px);
  background: #123f4e;
  box-shadow: 0 5px 12px rgb(16 44 64 / 16%);
}

.btn-submit:focus-visible,
.btn-dashboard:focus-visible {
  outline: 3px solid rgb(66 214 178 / 55%);
  outline-offset: 3px;
}

.btn-submit:disabled {
  background: #cbd5e1;
  color: #64748b;
  cursor: not-allowed;
}

.auth-links {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 0.3rem;
  margin-top: 1.5rem;
  color: #7b879b;
  font-size: 0.85rem;
  text-align: center;
}

.auth-link,
.forgot-password-link {
  color: #0a2c3a;
  font-weight: 700;
  text-decoration: none;
}

.auth-link:hover,
.forgot-password-link:hover {
  text-decoration: underline;
}

.forgot-password {
  margin-top: 1rem;
  text-align: center;
}

.forgot-password-link {
  padding: 0;
  border: 0;
  background: transparent;
  font-family: inherit;
  font-size: 0.85rem;
  cursor: pointer;
}

.forgot-password-message {
  display: block;
  margin: 0.75rem 0 0;
  color: #64728a;
  font-size: 0.85rem;
  line-height: 1.5;
}

.security-note {
  margin: 2.5rem 0 0;
  color: #94a0b2;
  font-size: 0.75rem;
  text-align: center;
}

/* Sesión ya iniciada */
.active-session-card {
  display: flex;
  width: 100%;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
  padding: 2rem 1.5rem;
  border: 1px solid #edf1f7;
  border-radius: 1.2rem;
  background: #fff;
  box-shadow: 0 1rem 2.5rem rgb(33 58 99 / 8%);
  text-align: center;
}

.login-card--embedded .active-session-card {
  padding: 0.5rem 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
}

.active-session-icon-wrapper {
  display: flex;
  width: 3.6rem;
  height: 3.6rem;
  align-items: center;
  justify-content: center;
  margin-bottom: 1rem;
  border-radius: 50%;
  background: #eafcf8;
  color: #0c5d4d;
}

.active-session-icon {
  width: 1.75rem;
  height: 1.75rem;
}

.active-session-badge {
  display: inline-block;
  margin-bottom: 0.75rem;
  padding: 0.3rem 0.85rem;
  border-radius: 999px;
  background: #eafcf8;
  color: #0c5d4d;
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

.active-session-title {
  margin: 0 0 0.5rem;
  color: #192338;
  font-size: 1.5rem;
  font-weight: 750;
  letter-spacing: -0.03em;
}

.active-session-greeting {
  margin: 0 0 1.25rem;
  color: #64748b;
  font-size: 0.95rem;
  line-height: 1.6;
  overflow-wrap: anywhere;
}

.active-session-greeting strong {
  color: #0a2c3a;
}

.active-session-info {
  display: flex;
  max-width: 100%;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 0.65rem;
  box-sizing: border-box;
  margin-bottom: 1.5rem;
  padding: 0.5rem 0.85rem;
  border: 1px solid #e2e8f0;
  border-radius: 0.7rem;
  background: #f8fafc;
}

.role-pill {
  display: inline-block;
  padding: 0.2rem 0.55rem;
  border-radius: 0.4rem;
  background: #0a2c3a;
  color: #5ccfc0;
  font-size: 0.75rem;
  font-weight: 700;
  text-transform: uppercase;
}

.email-text {
  color: #334155;
  font-size: 0.85rem;
  font-weight: 600;
  overflow-wrap: anywhere;
}

.active-session-actions {
  display: flex;
  width: 100%;
  flex-direction: column;
  gap: 0.75rem;
}

.btn-dashboard {
  display: inline-flex;
  width: 100%;
  min-height: 3rem;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  box-sizing: border-box;
  padding: 0.85rem 1.25rem;
  border-radius: 0.7rem;
  background: #0a2c3a;
  color: #fff;
  font-family: inherit;
  font-size: 0.95rem;
  font-weight: 750;
  line-height: 1.4;
  text-decoration: none;
  cursor: pointer;
  transition: background 0.2s ease, transform 0.15s ease;
}

.btn-dashboard:hover {
  transform: translateY(-1px);
  background: #123f4e;
}

.btn-logout-session {
  display: inline-flex;
  width: 100%;
  min-height: 2.8rem;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  box-sizing: border-box;
  padding: 0.75rem 1.25rem;
  border: 1px solid #fecaca;
  border-radius: 0.7rem;
  background: #fff;
  color: #b91c1c;
  font-family: inherit;
  font-size: 0.9rem;
  font-weight: 650;
  cursor: pointer;
}

.btn-logout-session:hover {
  border-color: #fda4af;
  background: #fff1f2;
  color: #991b1b;
}

/* La versión integrada solo dibuja el formulario: el diseño exterior lo aporta el componente padre. */
.login-page--embedded {
  display: block;
  min-height: 0;
  height: auto;
  background: transparent;
}

.login-page--embedded .auth-panel {
  display: block;
  padding: 0;
  background: transparent;
}

.login-card--embedded {
  max-width: none;
  padding: 0;
  border: 0;
  border-radius: 0;
  box-shadow: none;
}

.login-card--embedded .login-header {
  display: none;
}

.login-card--embedded .security-note,
.login-card--embedded .auth-links {
  display: none;
}

@media (max-width: 760px) {
  .login-page {
    min-height: calc(100vh - var(--app-header-height, 4rem));
    min-height: calc(100dvh - var(--app-header-height, 4rem));
    grid-template-columns: 1fr;
  }

  .welcome-panel {
    min-height: 24rem;
    padding: 2rem 8%;
  }

  .welcome-copy {
    margin: 2.5rem 0 1rem;
  }

  .welcome-copy h2 {
    max-width: 15ch;
    font-size: clamp(2rem, 8vw, 3rem);
  }

  .shopping-illustration {
    display: none;
  }

  .auth-panel {
    padding: 3rem 1.5rem;
  }

  .login-header h1 {
    font-size: 1.6rem;
  }

  .security-note {
    margin-top: 2rem;
  }
}

@media (max-width: 420px) {
  .welcome-panel {
    min-height: 21rem;
  }

  .welcome-copy h2 {
    font-size: 2.15rem;
  }

  .auth-panel {
    padding: 2.5rem 1.25rem;
  }

  .auth-links {
    flex-direction: column;
    gap: 0.2rem;
  }

  .active-session-card {
    padding: 1.5rem 1rem;
  }

  .active-session-title {
    font-size: 1.35rem;
  }

  .active-session-info {
    width: 100%;
  }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    transition-duration: 0.01ms !important;
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
  }
}
