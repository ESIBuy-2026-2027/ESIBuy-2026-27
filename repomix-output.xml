package es.uclm.esibuy.users.service;

import java.util.ArrayList;
import java.util.List;
import java.util.UUID;

import org.springframework.stereotype.Service;

import es.uclm.esibuy.common.exception.AddressLimitExceededException;
import es.uclm.esibuy.common.exception.AddressNotFoundException;
import es.uclm.esibuy.common.exception.UserNotFoundException;
import es.uclm.esibuy.users.dto.ShippingAddressRequest;
import es.uclm.esibuy.users.dto.ShippingAddressResponse;
import es.uclm.esibuy.users.model.ClientProfile;
import es.uclm.esibuy.users.model.ShippingAddress;
import es.uclm.esibuy.users.model.User;
import es.uclm.esibuy.users.repository.UserRepository;

@Service
public class ShippingAddressService {

    public static final int MAX_ADDRESSES = 10;

    private final UserRepository userRepository;

    public ShippingAddressService(UserRepository userRepository) {
        this.userRepository = userRepository;
    }

    public List<ShippingAddress> list(String userId) {
        User user = findUser(userId);
        ClientProfile profile = user.getClientProfile();
        return profile == null ? List.of() : profile.getAddresses();
    }

    public ShippingAddress add(String userId, ShippingAddressRequest request) {
        User user = findUser(userId);

        ClientProfile profile = user.getClientProfile();
        if (profile == null) {
            profile = new ClientProfile();
            user.setClientProfile(profile);
        }

        List<ShippingAddress> addresses = new ArrayList<>(profile.getAddresses());
        if (addresses.size() >= MAX_ADDRESSES) {
            throw new AddressLimitExceededException(
                    "Has alcanzado el máximo de " + MAX_ADDRESSES + " direcciones de envío");
        }

        // La primera dirección es siempre la predeterminada; solo puede haber una.
        boolean makeDefault = request.defaultAddress() || addresses.isEmpty();
        if (makeDefault) {
            addresses.forEach(address -> address.setDefaultAddress(false));
        }

        ShippingAddress created = new ShippingAddress(
                UUID.randomUUID().toString(),
                request.recipientName().trim(),
                request.street().trim(),
                blankToNull(request.additionalInfo()),
                request.postalCode().trim(),
                request.city().trim(),
                request.province().trim(),
                blankToNull(request.phone()),
                makeDefault);

        addresses.add(created);
        profile.setAddresses(addresses);
        userRepository.save(user);
        return created;
    }

    public ShippingAddressResponse update(String userId, String addressId, ShippingAddressRequest request) {
        User user = userRepository.findById(userId)
                .orElseThrow(UserNotFoundException::new);
        ClientProfile profile = user.getClientProfile();
        if (profile == null)
            throw new AddressNotFoundException();

        List<ShippingAddress> addresses = new ArrayList<>(profile.getAddresses());
        ShippingAddress target = addresses.stream()
                .filter(a -> a.getId().equals(addressId))
                .findFirst()
                .orElseThrow(AddressNotFoundException::new);

        boolean makeDefault = request.defaultAddress() ||
                addresses.stream().noneMatch(a -> a.isDefaultAddress() && !a.getId().equals(addressId));
        if (makeDefault) {
            addresses.forEach(a -> a.setDefaultAddress(false));
        }

        target.setRecipientName(request.recipientName().trim());
        target.setStreet(request.street().trim());
        target.setAdditionalInfo(blankToNull(request.additionalInfo()));
        target.setPostalCode(request.postalCode().trim());
        target.setCity(request.city().trim());
        target.setProvince(request.province().trim());
        target.setPhone(blankToNull(request.phone()));
        target.setDefaultAddress(makeDefault);

        profile.setAddresses(addresses);
        userRepository.save(user);
        return ShippingAddressResponse.from(target);
    }

    public void delete(String userId, String addressId) {
        User user = findUser(userId);
        ClientProfile profile = user.getClientProfile();

        if (profile == null) {
            throw new AddressNotFoundException();
        }

        List<ShippingAddress> addresses = new ArrayList<>(profile.getAddresses());

        ShippingAddress target = addresses.stream()
                .filter(address -> address.getId().equals(addressId))
                .findFirst()
                .orElseThrow(AddressNotFoundException::new);

        boolean wasDefault = target.isDefaultAddress();

        addresses.remove(target);

        if (wasDefault && !addresses.isEmpty()) {
            addresses.forEach(address -> address.setDefaultAddress(false));
            addresses.get(0).setDefaultAddress(true);
        }

        profile.setAddresses(addresses);
        userRepository.save(user);
    }

    private User findUser(String userId) {
        return userRepository.findById(userId)
                .orElseThrow(() -> new UserNotFoundException("Usuario no encontrado"));
    }

    private String blankToNull(String value) {
        return value == null || value.isBlank() ? null : value.trim();
    }
}
</file>

<file path="frontend/src/app/core/services/auth.service.ts">
import { HttpClient, HttpErrorResponse, HttpParams } from '@angular/common/http';
import { computed, Injectable, signal } from '@angular/core';
import { Observable, catchError, of, tap, throwError } from 'rxjs';

export type UserRole = 'CLIENT' | 'SELLER' | 'ADMIN';

export interface AuthenticatedUser {
  id: string;
  email: string;
  role: UserRole;
  active: boolean;
  totpEnabled?: boolean;
}

export interface LoginResponse {
  requires2fa?: boolean;
  requires3fa?: boolean;
  expiresInSeconds?: number;
  email?: string;
  id?: string;
  role?: UserRole;
  active?: boolean;
  totpEnabled?: boolean;
}

export interface ClientProfile {
  birthDate?: string;
  customerType?: string;
}

export interface SellerProfile {
  businessName?: string;
  defaultCategory?: string;
  headquarters?: string;
}

export interface AdminProfile {
  headquarters?: string;
  hireDate?: string;
}

export interface UserAdmin {
  id: string;
  email: string;
  firstName: string;
  lastName: string;
  nationalId: string | null;
  phone: string | null;
  profileImage: string | null;
  role: UserRole;
  active: boolean;
  blocked: boolean;
  createdAt: string | null;
  clientProfile?: ClientProfile | null;
  sellerProfile?: SellerProfile | null;
  adminProfile?: AdminProfile | null;
}

export interface UpdateUserRequest {
  firstName: string;
  lastName: string;
  nationalId?: string;
  phone?: string;
  profileImage?: string;
  headquarters?: string;
  businessName?: string;
  birthDate?: string;
  defaultCategory?: string;
}

export interface UserResponse {
  id: string;
  email: string;
  firstName: string;
  lastName: string;
  nationalId?: string | null;
  phone: string | null;
  role: string;
  profileImage?: string | null;
  headquarters?: string | null;
  businessName?: string | null;
  birthDate?: string | null;
  defaultCategory?: string | null;
}

export interface CreateAdminRequest {
  nationalId: string;
  firstName: string;
  lastName: string;
  email: string;
  password: string;
  confirmPassword: string;
  headquarters?: string | null;
  profileImage?: string | null;
}

export interface ApiResponse<T> {
  success: boolean;
  message: string;
  data: T;
  correlationId: string | null;
}

@Injectable({ providedIn: 'root' })
export class AuthService {
  private readonly apiUrl = '/api/users';
  private readonly adminApiUrl = '/api/admin/users';
  private readonly currentUserSignal = signal<AuthenticatedUser | null>(null);

  readonly currentUser = this.currentUserSignal.asReadonly();
  readonly isAuthenticated = computed(() => this.currentUserSignal() !== null);

  constructor(private readonly http: HttpClient) { }

  registerClient(data: unknown): Observable<unknown> {
    return this.http.post(
      `${this.apiUrl}/register/client`,
      data,
      { withCredentials: true },
    );
  }

  registerSeller(data: unknown): Observable<unknown> {
    return this.http.post(
      `${this.apiUrl}/register/seller`,
      data,
      { withCredentials: true },
    );
  }


  createAdmin(data: CreateAdminRequest): Observable<unknown> {
    return this.http.post(
      '/api/admin/create-admin',
      data,
      { withCredentials: true },
    );
  }


  login(data: {
    email: string;
    password: string;
    totpCode?: string;
  }): Observable<LoginResponse> {
    return this.http
      .post<LoginResponse>(
        `${this.apiUrl}/login`,
        data,
        { withCredentials: true },
      )
      .pipe(
        tap((response) => {
          // No autenticar hasta completar los factores requeridos.
          if (
            !response.requires2fa &&
            !response.requires3fa &&
            response.id
          ) {
            this.currentUserSignal.set(response as AuthenticatedUser);
          }
        }),
      );
  }

  requestPasswordReset(email: string) {
    return this.http.post<{ message: string }>(
      '/api/auth/password-reset/request',
      { email },
      { withCredentials: true }
    );
  }


  validatePasswordResetToken(token: string) {
    return this.http.post<{ message: string }>(
      '/api/auth/password-reset/validate',
      { token },
      { withCredentials: true }
    );
  }

  confirmPasswordReset(token: string, newPassword: string) {
    return this.http.post<{ message: string }>(
      '/api/auth/password-reset/confirm',
      { token, newPassword },
      { withCredentials: true }
    );
  }

  verifyLoginOtp(code: string): Observable<LoginResponse> {
    return this.http
      .post<LoginResponse>(
        `${this.apiUrl}/login/verify-otp`,
        { code },
        { withCredentials: true },
      )
      .pipe(
        tap((response) => {
          if (response.id && response.role) {
            this.currentUserSignal.set(response as AuthenticatedUser);
          }
        }),
      );
  }

  setup2FA(): Observable<{ secret: string; qrUri: string }> {
    return this.http.post<{ secret: string; qrUri: string }>(
      `${this.apiUrl}/2fa/setup`,
      {},
      { withCredentials: true },
    );
  }

  enable2FA(
    code: string,
  ): Observable<{ message: string; backupCodes: string[] }> {
    return this.http.post<{ message: string; backupCodes: string[] }>(
      `${this.apiUrl}/2fa/enable`,
      { code },
      { withCredentials: true },
    );
  }

  regenerateBackupCodes(
    code?: string,
  ): Observable<{ message: string; backupCodes: string[] }> {
    return this.http.post<{ message: string; backupCodes: string[] }>(
      `${this.apiUrl}/2fa/regenerate-backup-codes`,
      { code },
      { withCredentials: true },
    );
  }

  disable2FA(code: string): Observable<{ message: string }> {
    return this.http.post<{ message: string }>(
      `${this.apiUrl}/2fa/disable`,
      { code },
      { withCredentials: true },
    );
  }

  me(): Observable<AuthenticatedUser> {
    return this.http
      .get<AuthenticatedUser>(
        `${this.apiUrl}/me`,
        { withCredentials: true },
      )
      .pipe(
        tap((user) => this.currentUserSignal.set(user)),
      );
  }

  loadCurrentUser(): Observable<AuthenticatedUser | null> {
    return this.me().pipe(
      catchError((error: unknown) => {
        if (error instanceof HttpErrorResponse && error.status === 401) {
          this.clearCurrentUser();
          return of(null);
        }

        return throwError(() => error);
      }),
    );
  }

  logout(): Observable<void> {
    return this.http
      .post<void>(
        `${this.apiUrl}/logout`,
        {},
        { withCredentials: true },
      )
      .pipe(
        tap(() => this.clearCurrentUser()),
      );
  }

  clearCurrentUser(): void {
    this.currentUserSignal.set(null);
  }

  getAllUsers(role?: string, status?: string): Observable<UserAdmin[]> {
    let params = new HttpParams();

    if (role) {
      params = params.set('role', role);
    }

    if (status) {
      params = params.set('status', status);
    }

    return this.http.get<UserAdmin[]>(this.adminApiUrl, {
      params,
      withCredentials: true,
    });
  }

  getAdminUser(id: string): Observable<ApiResponse<UserResponse>> {
    return this.http.get<ApiResponse<UserResponse>>(
      `${this.adminApiUrl}/${encodeURIComponent(id)}`,
      { withCredentials: true },
    );
  }

  updateAdminUser(
    id: string,
    data: UpdateUserRequest,
  ): Observable<ApiResponse<UserResponse>> {
    return this.http.put<ApiResponse<UserResponse>>(
      `${this.adminApiUrl}/${encodeURIComponent(id)}`,
      data,
      { withCredentials: true },
    );
  }

  deleteAdminUser(id: string): Observable<ApiResponse<void>> {
    return this.http.delete<ApiResponse<void>>(
      `${this.adminApiUrl}/${encodeURIComponent(id)}`,
      { withCredentials: true },
    );
  }

  toggleAdminUserStatus(
    id: string,
  ): Observable<ApiResponse<UserResponse>> {
    return this.http.put<ApiResponse<UserResponse>>(
      `${this.adminApiUrl}/${encodeURIComponent(id)}/status`,
      {},
      { withCredentials: true },
    );
  }

  blockAdminUser(id: string): Observable<ApiResponse<void>> {
    return this.http.post<ApiResponse<void>>(
      `${this.adminApiUrl}/${encodeURIComponent(id)}/block`,
      {},
      { withCredentials: true },
    );
  }

  unblockAdminUser(id: string): Observable<ApiResponse<void>> {
    return this.http.post<ApiResponse<void>>(
      `${this.adminApiUrl}/${encodeURIComponent(id)}/unblock`,
      {},
      { withCredentials: true },
    );
  }

  activateAdminUser(id: string): Observable<ApiResponse<void>> {
    return this.http.post<ApiResponse<void>>(
      `${this.adminApiUrl}/${encodeURIComponent(id)}/activate`,
      {},
      { withCredentials: true },
    );
  }

  deactivateAdminUser(id: string): Observable<ApiResponse<void>> {
    return this.http.post<ApiResponse<void>>(
      `${this.adminApiUrl}/${encodeURIComponent(id)}/deactivate`,
      {},
      { withCredentials: true },
    );
  }
}
</file>

<file path="frontend/src/app/core/services/shipping-address.service.ts">
import { HttpClient } from '@angular/common/http';
import { inject, Injectable } from '@angular/core';
import { Observable } from 'rxjs';

export interface ShippingAddress {
  id: string;
  recipientName: string;
  street: string;
  additionalInfo: string | null;
  postalCode: string;
  city: string;
  province: string;
  phone: string | null;
  isDefault: boolean;
}

/** Datos que envía el cliente al crear una dirección (el id lo genera el servidor). */
export type ShippingAddressRequest = Omit<ShippingAddress, 'id'>;

@Injectable({ providedIn: 'root' })
export class ShippingAddressService {
  private readonly http = inject(HttpClient);
  private readonly url = '/api/users/me/addresses';

  list(): Observable<ShippingAddress[]> {
    return this.http.get<ShippingAddress[]>(this.url, { withCredentials: true });
  }

  add(request: ShippingAddressRequest): Observable<ShippingAddress> {
    return this.http.post<ShippingAddress>(this.url, request, { withCredentials: true });
  }

  update(id: string, req: ShippingAddressRequest): Observable<ShippingAddress> {
    return this.http.put<ShippingAddress>(
      `/api/users/me/addresses/${id}`, req, { withCredentials: true }
    );
  }

  delete(id: string): Observable<void> {
    return this.http.delete<void>(
      `${this.url}/${id}`, { withCredentials: true },
    );
  }
}
