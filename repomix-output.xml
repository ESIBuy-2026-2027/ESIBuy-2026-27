<file path="frontend/src/app/features/identity/login/login.html">
<div class="login-page" [class.login-page--embedded]="embedded">
  @if (!embedded) {
  <section class="welcome-panel" aria-labelledby="welcome-title">
    <a routerLink="/" class="brand" aria-label="ESIBuy, inicio">
    </a>

    <div class="welcome-copy">
      <p class="eyebrow">Tu tienda, más sencilla</p>
      <h2 id="welcome-title">Compra con confianza.</h2>
      <h2>Vive la experiencia.</h2>
      <p class="welcome-text">
        Accede a tu cuenta para descubrir productos, gestionar tus pedidos
        y disfrutar de una compra segura.
      </p>
    </div>

    <div class="shopping-illustration" aria-hidden="true">
      <div class="order-card">
        <span>Pedido #2048</span>
        <div class="progress-bar"></div>
        <p>● En camino</p>
      </div>

      <div class="payment-card">
        <span>Pago seguro</span>
        <strong>•••• 4821</strong>
        <small>ESIBUY MEMBER</small>
      </div>
    </div>
  </section>
  }

  <section class="auth-panel" [attr.aria-labelledby]="!embedded ? 'login-title' : null">
    <main class="login-card" [class.login-card--embedded]="embedded">
      @if (currentUser(); as user) {
      <div class="active-session-card">
        <div class="active-session-icon-wrapper" aria-hidden="true">
          <svg class="active-session-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
            stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" />
            <circle cx="12" cy="7" r="4" />
          </svg>
        </div>

        <span class="active-session-badge">Sesión activa</span>

        <h2 class="active-session-title">¡Bienvenido de nuevo!</h2>

        <p class="active-session-greeting">
          Hola <strong>{{ getUserDisplayName(user) }}</strong>, ya has iniciado sesión en ESIBuy.
        </p>

        <div class="active-session-info">
          <span class="role-pill">{{ getRoleLabel(user.role) }}</span>
          <span class="email-text">{{ user.email }}</span>
        </div>

        <div class="active-session-actions">
          <a [routerLink]="getDashboardRoute(user.role)" class="btn-dashboard">
            {{ getDashboardButtonText(user.role) }}
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
              stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14m-7-7 7 7-7 7" />
            </svg>
          </a>

          <button type="button" class="btn-logout-session" (click)="logout()">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
              stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
              <polyline points="16 17 21 12 16 7" />
              <line x1="21" y1="12" x2="9" y2="12" />
            </svg>
            Cerrar sesión
          </button>
        </div>
      </div>
      } @else {
      <header class="login-header" *ngIf="!embedded">
        <h1 id="login-title">{{ requires2FA ? 'Autenticación en dos pasos' : 'Iniciar sesión' }}</h1>

        <p class="login-subtitle">
          {{ requires2FA ? 'Introduce el código de tu aplicación Authenticator o un código de respaldo.' : 'Accede a tu
          cuenta para continuar.' }}
        </p>
      </header>

      @if (successMessage) {
      <output class="server-success-banner">
        {{ successMessage }}
      </output>
      }

      <div *ngIf="serverError" class="server-error-banner" role="alert">
        {{ serverError }}
      </div>

      <form [formGroup]="loginForm" (ngSubmit)="onSubmit()" class="login-form">

        <fieldset class="form-section" [disabled]="loading || retryAfterSeconds > 0">

          @if (!requires2FA) {
          <div class="form-group">
            <label for="email">Email</label>

            <input id="email" type="email" formControlName="email" placeholder="usuario@dominio.com"
              autocomplete="email" />

            <span class="error" *ngIf="
                  loginForm.get('email')?.touched &&
                  loginForm.get('email')?.hasError('required')
                ">
              El email es obligatorio
            </span>

            <span class="error" *ngIf="
                  loginForm.get('email')?.touched &&
                  loginForm.get('email')?.hasError('email')
                ">
              Formato de email no válido
            </span>

          </div>

          <div class="form-group">

            <label for="password">Contraseña</label>

            <div class="password-wrapper">

              <input id="password" [attr.type]="showPassword ? 'text' : 'password'" formControlName="password"
                placeholder="Tu contraseña" [attr.autocomplete]="showPassword ? 'off' : 'current-password'" />

              <button type="button" class="password-toggle" (click)="showPassword = !showPassword"
                [attr.aria-label]="showPassword ? 'Ocultar contraseña' : 'Mostrar contraseña'">
                <svg *ngIf="!showPassword" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z" fill="none" stroke="currentColor"
                    stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />

                  <circle cx="12" cy="12" r="2.5" fill="none" stroke="currentColor" stroke-width="2" />
                </svg>

                <svg *ngIf="showPassword" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M3 3l18 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />

                  <path
                    d="M10.6 6.2A10.5 10.5 0 0 1 12 6c6 0 9.5 6 9.5 6a17.5 17.5 0 0 1-3.2 3.8M6.2 6.2C3.9 7.8 2.5 12 2.5 12s3.5 6 9.5 6c1.4 0 2.7-.3 3.8-.8"
                    fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </button>

            </div>

            <span class="error" *ngIf="
                  loginForm.get('password')?.touched &&
                  loginForm.get('password')?.hasError('required')
                ">
              La contraseña es obligatoria
            </span>

          </div>
          } @else {
          <div class="form-group">
            <label for="totpCode">Código de verificación (6 dígitos o Respaldo)</label>
            <input id="totpCode" type="text" formControlName="totpCode" placeholder="ej. 123456" autofocus
              autocomplete="one-time-code" maxlength="8" />
            <span class="error" *ngIf="
                  loginForm.get('totpCode')?.touched &&
                  loginForm.get('totpCode')?.hasError('required')
                ">
              Introduce el código TOTP o de respaldo
            </span>
          </div>
          }

        </fieldset>

        <button type="submit" class="btn-submit" [disabled]="loading || retryAfterSeconds > 0">
          {{ loading ? 'Verificando...' : requires2FA ? 'Confirmar código' : retryAfterSeconds > 0 ? 'Espera para
          reintentar' : 'Entrar' }}
        </button>

        <button *ngIf="requires2FA" type="button" class="btn-logout-session" (click)="cancel2FA()"
          style="margin-top: 10px;">
          Volver a introducir credenciales
        </button>

      </form>

      <div class="forgot-password" *ngIf="!requires2FA">
        <a routerLink="/recuperar-password" class="forgot-password-link">
          ¿Has olvidado tu contraseña?
        </a>
      </div>

      <div class="auth-links" *ngIf="!embedded && !requires2FA">
        <span>¿Todavía no tienes una cuenta?</span>
        <a routerLink="/register" class="auth-link">Regístrate</a>
      </div>

      <p class="security-note" *ngIf="!embedded && !requires2FA">
        Tus datos están protegidos con cifrado seguro
      </p>
      }

    </main>
  </section>
</div>
</file>

