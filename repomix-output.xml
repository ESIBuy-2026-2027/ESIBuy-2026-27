            <h2>{{ product.name }}</h2>

            @if (product.description) {
            <p class="product-description">
              {{ product.description }}
            </p>
            }

            <p class="product-stock">
              Disponible: {{ product.stock }}
            </p>

            <p class="product-price">
              {{ formatPrice(product.price) }}
            </p>

            <label [for]="'quantity-' + product.id">Cantidad</label>
            <input [id]="'quantity-' + product.id" type="number" min="1" step="1" [max]="product.stock"
              [ngModel]="quantityFor(product.id)" (ngModelChange)="setQuantity(product.id, $event)">

            <button class="primary-action add-to-cart" type="button" [disabled]="addingProductId() === product.id"
              (click)="addToCart(product)">
              {{ addingProductId() === product.id
              ? 'Añadiendo…'
              : 'Añadir al carrito' }}
            </button>
          </div>
        </article>
        }
      </section>
      }
    </main>
  </div>
</div>
