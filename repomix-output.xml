          <path d="M16 14h1a4 4 0 0 1 4 4v2"></path>
        </svg>
        <span>Usuarios</span>
      </a>

      <a class="navigation-link" routerLink="/admin/users/new" routerLinkActive="is-active"
        [routerLinkActiveOptions]="{ exact: true }" ariaCurrentWhenActive="page">
        <span class="navigation-icon text-icon" aria-hidden="true">＋</span>
        <span>Dar de alta Administrador</span>
      </a>

      <a class="navigation-link" routerLink="/admin/categorias" routerLinkActive="is-active"
        [routerLinkActiveOptions]="{ exact: true }" ariaCurrentWhenActive="page">
        <svg class="navigation-icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20 13 11 22l-9-9V2h11l9 9a1.4 1.4 0 0 1-2 2Z"></path>
          <circle cx="7" cy="7" r="1.2"></circle>
        </svg>
        <span>Categorías</span>
      </a>
    </nav>
  </aside>

  <button type="button" class="app-sidebar-toggle-open" (click)="toggleSidebar()" aria-label="Mostrar barra lateral"
    [hidden]="!sidebarCollapsed()">
    <span aria-hidden="true">›</span>
  </button>

  <div class="admin-workspace app-workspace">
    <main class="admin-create-container edit-page">
      <div class="main-container">

        <!-- Errores generales -->
        <div *ngIf="errorMessage" class="alert-box alert-danger" role="alert">
          <div class="alert-title">
            <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>Error</span>
          </div>

          <p class="error-message" style="margin: 0; font-size: 0.9rem;">
            {{ errorMessage }}
          </p>

          <ul *ngIf="fieldErrors && (fieldErrors | keyvalue).length > 0" class="alert-list">
            <li *ngFor="let err of fieldErrors | keyvalue">{{ err.value }}</li>
          </ul>
        </div>

        <!-- Confirmación de alta -->
        @if (successMessage) {
        <output class="alert-box alert-success" aria-live="polite">
          <div class="alert-title">
            <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span>Éxito</span>
          </div>
          <p class="success-message">{{ successMessage }}</p>
        </output>
        }

        <section class="card">
          <div class="card-header">
            <h1 class="card-title">
              <svg width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
              </svg>
              Alta de cuenta de Administrador
            </h1>

            <p class="card-subtitle">
              Completa los datos del nuevo administrador para registrarlo en el sistema.
              Los campos con asterisco (*) son obligatorios.
            </p>
          </div>

          <form [formGroup]="form" (ngSubmit)="onSubmit()" novalidate>

            <!-- Nombre y apellidos -->
            <div class="form-row">
              <div class="form-group">
                <label for="firstName" class="form-label">
                  Nombre <span class="required">*</span>
                </label>

                <input id="firstName" type="text" class="form-control" formControlName="firstName" placeholder="Nombre"
                  maxlength="25" autocomplete="given-name" />

                <div *ngIf="form.get('firstName')?.touched && form.get('firstName')?.hasError('required')"
                  class="field-error">
                  El nombre es obligatorio.
                </div>

                <div
                  *ngIf="form.get('firstName')?.touched && (form.get('firstName')?.hasError('minlength') || form.get('firstName')?.hasError('maxlength'))"
                  class="field-error">
                  El nombre debe tener entre 2 y 25 caracteres.
                </div>

                <div *ngIf="fieldErrors['firstName']" class="field-error">
                  {{ fieldErrors['firstName'] }}
                </div>
              </div>

              <div class="form-group">
                <label for="lastName" class="form-label">
                  Apellidos <span class="required">*</span>
                </label>

                <input id="lastName" type="text" class="form-control" formControlName="lastName" placeholder="Apellidos"
                  maxlength="50" autocomplete="family-name" />

                <div *ngIf="form.get('lastName')?.touched && form.get('lastName')?.hasError('required')"
                  class="field-error">
                  Los apellidos son obligatorios.
                </div>

                <div
                  *ngIf="form.get('lastName')?.touched && (form.get('lastName')?.hasError('minlength') || form.get('lastName')?.hasError('maxlength'))"
                  class="field-error">
                  Los apellidos deben tener entre 2 y 50 caracteres.
                </div>

                <div *ngIf="fieldErrors['lastName']" class="field-error">
                  {{ fieldErrors['lastName'] }}
                </div>
              </div>
            </div>

            <!-- DNI y email -->
            <div class="form-row">
              <div class="form-group">
                <label for="nationalId" class="form-label">
                  DNI <span class="required">*</span>
                </label>

                <input id="nationalId" type="text" class="form-control" formControlName="nationalId"
                  placeholder="DNI" />

                <div *ngIf="form.get('nationalId')?.touched && form.get('nationalId')?.hasError('required')"
                  class="field-error">
                  El DNI es obligatorio.
                </div>

                <div *ngIf="fieldErrors['nationalId']" class="field-error">
                  {{ fieldErrors['nationalId'] }}
                </div>
              </div>

              <div class="form-group">
                <label for="email" class="form-label">
                  Email corporativo <span class="required">*</span>
                </label>

                <input id="email" type="email" class="form-control" formControlName="email"
                  placeholder="usuario@dominio.com" maxlength="120" autocomplete="email" />

                <div *ngIf="form.get('email')?.touched && form.get('email')?.hasError('required')" class="field-error">
                  El email es obligatorio.
                </div>

                <div *ngIf="form.get('email')?.touched && form.get('email')?.hasError('email')" class="field-error">
                  Formato de email no válido (ejemplo: usuario@dominio.com).
                </div>

                <div *ngIf="fieldErrors['email']" class="field-error">
                  {{ fieldErrors['email'] }}
                </div>
              </div>
            </div>

            <!-- Contraseñas -->
            <div class="form-row">
              <div class="form-group">
                <label for="password" class="form-label">
                  Contraseña <span class="required">*</span>
                </label>

                <div class="password-wrapper">
                  <input id="password" [type]="showPassword ? 'text' : 'password'" class="form-control"
                    formControlName="password" placeholder="Mínimo 12 caracteres"
                    [attr.autocomplete]="showPassword ? 'off' : 'new-password'" />

                  <button type="button" class="password-toggle" (click)="showPassword = !showPassword"
                    [attr.aria-label]="showPassword ? 'Ocultar contraseña' : 'Mostrar contraseña'">
                    <svg *ngIf="!showPassword" viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"></path>
                      <circle cx="12" cy="12" r="2.5"></circle>
                    </svg>

                    <svg *ngIf="showPassword" viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M3 3l18 18"></path>
                      <path
                        d="M10.6 6.2A10.5 10.5 0 0 1 12 6c6 0 9.5 6 9.5 6a17.5 17.5 0 0 1-3.2 3.8M6.2 6.2C3.9 7.8 2.5 12 2.5 12s3.5 6 9.5 6c1.4 0 2.7-.3 3.8-.8">
                      </path>
                    </svg>
                  </button>
                </div>

                <div *ngIf="form.get('password')?.touched && form.get('password')?.hasError('required')"
                  class="field-error">
                  La contraseña es obligatoria.
                </div>

                <div *ngIf="form.get('password')?.touched && form.get('password')?.hasError('minlength')"
                  class="field-error">
                  Debe tener al menos 12 caracteres.
                </div>

                <div *ngIf="form.get('password')?.touched && form.get('password')?.hasError('pattern')"
                  class="field-error">
                  La contraseña debe tener mayúscula, minúscula, número y un carácter especial.
                </div>

                <div *ngIf="fieldErrors['password']" class="field-error">
                  {{ fieldErrors['password'] }}
                </div>
              </div>

              <div class="form-group">
                <label for="confirmPassword" class="form-label">
                  Repetir contraseña <span class="required">*</span>
                </label>

                <div class="password-wrapper">
                  <input id="confirmPassword" [type]="showPassword ? 'text' : 'password'" class="form-control"
                    formControlName="confirmPassword" placeholder="Repite la contraseña"
                    [attr.autocomplete]="showPassword ? 'off' : 'new-password'" />
                </div>

                <div *ngIf="form.get('confirmPassword')?.touched && form.get('confirmPassword')?.hasError('required')"
                  class="field-error">
                  Debe repetir la contraseña.
                </div>

                <div
                  *ngIf="form.hasError('passwordsMismatch') && (form.get('confirmPassword')?.touched || form.get('password')?.touched)"
                  class="field-error">
                  Las contraseñas no coinciden.
                </div>

                <div *ngIf="fieldErrors['confirmPassword']" class="field-error">
                  {{ fieldErrors['confirmPassword'] }}
                </div>
              </div>
            </div>

            <!-- Sede y fecha de creación -->
            <div class="form-row">
              <div class="form-group">
                <label for="headquarters" class="form-label">Sede</label>

                <input id="headquarters" type="text" class="form-control" formControlName="headquarters"
                  placeholder="Ej: Ciudad Real, Albacete, Toledo..." maxlength="100" />

                <div *ngIf="fieldErrors['headquarters']" class="field-error">
                  {{ fieldErrors['headquarters'] }}
                </div>
              </div>

              <div class="form-group">
                <label for="creationDate" class="form-label">Fecha de creación</label>

                <input id="creationDate" type="text" class="form-control readonly-control"
                  [value]="creationDate | date:'dd/MM/yyyy HH:mm:ss'" readonly aria-readonly="true" tabindex="-1" />
              </div>
            </div>

            <!-- Avatares -->
            <fieldset class="form-group avatar-section">
              <legend class="form-label">Avatar de perfil</legend>

              <div class="avatar-selector-grid">
                <button *ngFor="let av of avatars" type="button" class="avatar-item"
                  [class.selected]="form.get('profileImage')?.value === av" (click)="selectAvatar(av)"
                  [attr.aria-label]="'Seleccionar avatar'">
                  <img [src]="av" alt="Avatar disponible" />

                  <span *ngIf="form.get('profileImage')?.value === av" class="avatar-check">
                    ✓
                  </span>
                </button>
              </div>

              <p class="avatar-hint">
                Selecciona una imagen de perfil de las opciones disponibles.
              </p>
            </fieldset>

            <!-- Botones -->
            <div class="btn-wrapper">
              <button type="button" class="btn btn-secondary" (click)="cancel()" [disabled]="submitting">
                Cancelar
              </button>

              <button type="submit" class="btn btn-primary" [disabled]="submitting">
                <span *ngIf="submitting" class="spinner" aria-hidden="true"></span>
                <span>Dar de alta Administrador</span>
              </button>
            </div>
          </form>
        </section>
      </div>
    </main>
  </div>
</div>
</file>

