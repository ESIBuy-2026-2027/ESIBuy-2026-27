<file path="frontend/src/app/features/client/client-dashboard/client-dashboard.css">
:host {
  display: block;
  min-height: 100vh;
  color: #172b3a;
  font-family: Inter, "Segoe UI", sans-serif;
}

.client-layout {
  min-height: 100vh;
  background: var(--color-page-background);
}

/* Área de contenido */
.client-workspace {
  margin-left: 248px;
  min-height: 100vh;
}

.client-content {
  box-sizing: border-box;
  width: min(1040px, 100%);
  margin: 0 auto;
  padding: 42px 40px 64px;
}

.page-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  margin-bottom: 32px;
}

.page-heading h1 {
  margin: 6px 0 8px;
  color: var(--color-text-primary);
  font-size: clamp(24px, 3vw, 30px);
  letter-spacing: -0.8px;
}

.page-description {
  margin: 0;
  color: var(--color-text-secondary);
  font-size: 14px;
  line-height: 1.5;
}

.cart-count {
  display: inline-grid;
  min-width: 1.5rem;
  height: 1.5rem;
  place-items: center;
  border-radius: 999px;
  background: var(--color-brand-dark);
  color: #fff;
  font-size: 0.8rem;
}

.product-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(235px, 1fr));
  gap: 1rem;
}

.product-card {
  overflow: hidden;
  border: 1px solid #d9e3eb;
  border-radius: 14px;
  background: #fff;
  box-shadow: 0 8px 24px rgba(16, 44, 64, 0.05);
}

.product-image,
.product-image-placeholder {
  display: grid;
  width: 100%;
  height: 170px;
  place-items: center;
  object-fit: cover;
  background: #eaf3f5;
  color: var(--color-focus);
  font-size: 2rem;
  font-weight: 800;
}

.product-details {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  padding: 1rem;
}

.product-details h2 {
  margin: 0;
  color: var(--color-text-primary);
  font-size: 1.05rem;
}

.product-description {
  min-height: 2.7em;
  margin: 0.5rem 0;
  color: var(--color-text-secondary);
  font-size: 0.875rem;
  line-height: 1.4;
}

.product-stock {
  margin: 0.5rem 0 0;
  color: #356b56;
  font-size: 0.85rem;
}

.product-price {
  margin: 0.5rem 0 0.85rem;
  color: var(--color-text-primary);
  font-size: 1.15rem;
  font-weight: 750;
}

.product-details label {
  margin-bottom: 0.35rem;
  color: #496477;
  font-size: 0.85rem;
  font-weight: 650;
}

.product-details input {
  box-sizing: border-box;
  width: 100%;
  min-height: 40px;
  margin-bottom: 0.75rem;
  padding: 0.45rem 0.65rem;
  border: 1px solid #bdcdd7;
  border-radius: 7px;
  font: inherit;
}

.product-details input:focus-visible {
  outline: 3px solid var(--color-focus);
  outline-offset: 2px;
}

.add-to-cart {
  display: inline-flex;
  min-height: 42px;
  align-items: center;
  justify-content: center;
  padding: 0 1rem;
  border: 0;
  border-radius: 8px;
  background: var(--color-brand-accent);
  color: var(--color-brand-dark);
  font: inherit;
  font-weight: 650;
  cursor: pointer;
}

.add-to-cart:hover:not(:disabled) {
  background: var(--color-brand-accent-hover);
}

.add-to-cart:disabled {
  opacity: 0.65;
  cursor: wait;
}

.add-to-cart:focus-visible,
.primary-action:focus-visible {
  outline: 3px solid var(--color-focus);
  outline-offset: 2px;
}

.catalog-state,
.cart-notification {
  padding: 1rem 1.25rem;
  border: 1px solid #d9e3eb;
  border-radius: 10px;
  background: #fff;
  color: #496477;
}

.catalog-state.is-error,
