                      </label>
                      <input class="inline-input price-input" [id]="'price-' + product.id" type="number" min="0.01"
                        step="0.01" [ngModel]="inlineValue()"
                        (ngModelChange)="inlineValue.set($event === '' ? null : +$event)"
                        (keydown.enter)="saveInlineEdit(product)" (keydown.escape)="cancelInlineEdit()"
                        [disabled]="inlineSaving()">

                      <div class="inline-actions">
                        <button type="button" class="inline-save" (click)="saveInlineEdit(product)"
                          [disabled]="inlineSaving()" aria-label="Guardar precio">✓</button>
                        <button type="button" class="inline-cancel" (click)="cancelInlineEdit()"
                          [disabled]="inlineSaving()" aria-label="Cancelar edición del precio">×</button>
                      </div>
                    </div>
                    } @else {
                    <button type="button" class="editable-value price-value" (click)="startInlineEdit(product, 'price')"
                      [attr.aria-label]="'Modificar precio de ' + product.name" title="Modificar precio">
