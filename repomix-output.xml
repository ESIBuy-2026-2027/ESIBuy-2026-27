                </label>

                <label>
                  <span>Stock</span>
                  <select [ngModel]="stockFilter()" (ngModelChange)="stockFilter.set($event)">
                    <option value="all">Cualquier stock</option>
                    <option value="in-stock">En stock</option>
                    <option value="low-stock">Stock bajo</option>
                    <option value="out-of-stock">Sin stock</option>
                  </select>
                </label>

                <label>
                  <span>Categoría</span>
                  <select [ngModel]="categoryFilter()" (ngModelChange)="categoryFilter.set($event)">
                    <option value="all">Todas las categorías</option>
                    @for (category of categories(); track category.id) {
                    <option [value]="category.id">{{ category.name }}</option>
                    }
                  </select>
                </label>

                <button type="button" class="clear-filters-button" (click)="clearFilters()">
