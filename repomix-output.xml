      <a class="navigation-link is-disabled" role="link" aria-disabled="true"
          title="Próximamente" tabindex="-1">
          <svg class="navigation-icon" width="20" height="20" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
            aria-hidden="true">
            <path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2-5.6-3-5.6 3 1.1-6.2L3 9.6l6.2-.9L12 3Z"/>
          </svg>
          <span>Valoraciones</span>
      </a>
    </nav>
  </aside>

  <div class="workspace">
    @if (sidebarCollapsed()) {
      <button type="button" class="sidebar-toggle sidebar-toggle-open" (click)="toggleSidebar()"
        aria-label="Mostrar barra lateral" title="Mostrar barra lateral">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="m9 18 6-6-6-6"/>
        </svg>
      </button>
    }


    <main class="orders-content" aria-labelledby="orders-title">

      <div class="seller-main-card">
        <!--Encabezado principal-->
        <section class = "page-heading" aria-labelledby="orders-title">
           <div class="page-heading-copy">
            <p class="eyebrow">GESTIÓN DE VENTA</p>
            <h1 id="orders-title">Gestión de pedidos</h1>
            <p class="page-description">
              Gestiona y organiza tus pedidos en un vistazo
            </p>
          </div>
        </section>


        <div class="status-summary" aria-label="Resumen de pedidos por estado">
          @for (summary of statusSummary(); track summary.status) {
            <button type="button" class="status-summary-card"
              [class.is-selected]="selectedStatus() === summary.status"
              [class]="statusClass(summary.status)"
              [attr.aria-pressed]="selectedStatus() === summary.status"
              (click)="selectStatus(summary.status)">
              <span>{{ summary.label }}</span>
              <strong>{{ summary.count }}</strong>
            </button>
          }
        </div>

        <div class="orders-toolbar">
          <label class="orders-search">
            <span class="visually-hidden">Buscar pedidos</span>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="11" cy="11" r="6.5"></circle>
              <path d="m16 16 4.5 4.5"></path>
            </svg>
            <input type="search" [ngModel]="orderSearch()"
              (ngModelChange)="orderSearch.set($event)"
              placeholder="Buscar pedido, cliente o producto...">
          </label>
          <div class="orders-filter">
            <button type="button" class="secondary-button"
              [class.is-active]="selectedStatus() !== 'Todos' || dateFrom() || dateTo()"
              [attr.aria-expanded]="filtersOpen()" aria-controls="orders-filter-panel"
              (click)="toggleFilters()">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M4 5h16l-6.5 7.5v5l-3 1.5v-6.5L4 5z"></path>
              </svg>
              Filtrar
              @if (selectedStatus() !== 'Todos' || dateFrom() || dateTo()) {
                <span class="filter-indicator" aria-label="Filtro activo"></span>
              }
            </button>
            @if (filtersOpen()) {
              <div class="orders-filter-panel" id="orders-filter-panel">
                <button type="button" class="close-orders-filter" aria-label="Cerrar panel de filtros"
                  title="Cerrar" (click)="toggleFilters()">×</button>
                <label for="order-status-filter">Estado del pedido</label>
                <select id="order-status-filter" [ngModel]="selectedStatus()"
                  (ngModelChange)="selectedStatus.set($event)">
                  <option value="Todos">Todos los estados</option>
                  <option value="Pendiente">Pendiente</option>
                  <option value="En preparación">En preparación</option>
                  <option value="Enviado">Enviado</option>
                  <option value="Entregado">Entregado</option>
                  <option value="Cancelado">Cancelado</option>
                </select>
                <div class="date-filter-group">
                  <span>Fecha del pedido</span>
                  <div class="date-filter-fields">
                    <label for="order-date-from">Desde</label>
                    <input id="order-date-from" type="date" [ngModel]="dateFrom()"
                      (ngModelChange)="dateFrom.set($event)">
                    <label for="order-date-to">Hasta</label>
                    <input id="order-date-to" type="date" [ngModel]="dateTo()"
                      (ngModelChange)="dateTo.set($event)">
                  </div>
                </div>
                <button type="button" class="clear-order-filter" (click)="clearFilters()">
                  Limpiar filtro
                </button>
              </div>
            }
          </div>
          <span class="order-count">{{ visibleOrders().length }} pedidos</span>
        </div>

        <section aria-label="Pedidos de la tienda">
        @if (visibleOrders().length === 0) {
          <div class="empty-state">
            <span class="empty-icon" aria-hidden="true">⌕</span>
            <h3>No se encontraron pedidos</h3>
            <p>Prueba a cambiar la búsqueda o los filtros seleccionados.</p>
          </div>
        } @else {
          <div class="table-scroll">
            <table class="seller-data-table">
              <caption class="visually-hidden">Pedidos recientes</caption>
              <thead>
                <tr>
                  <th scope="col">ID pedido</th>
                  <th scope="col">Artículo</th>
                  <th scope="col">Comprador</th>
                  <th scope="col">Fecha</th>
                  <th scope="col">Estado</th>
                  <th scope="col">Total</th>
                  <th scope="col" class="action-column"><span class="visually-hidden">Acciones</span></th>
                </tr>
              </thead>
              <tbody>
                @for (order of visibleOrders(); track order.id) {
                  <tr>
                    <td class="order-id">#{{ order.id }}</td>
                    <td>
                      <div class="product-summary">
                        <span class="product-icon" aria-hidden="true">▦</span>
                        <span>{{ order.products }}</span>
                      </div>
                    </td>
                    <td>{{ order.customer }}</td>
                    <td class="order-date">{{ order.date }}</td>
                    <td>
                      <span class="status-badge" [class]="statusClass(order.status)">
                        <span class="status-dot" aria-hidden="true"></span>{{ order.status }}
                      </span>
                    </td>
                    <td class="order-total">{{ formatPrice(order.total) }}</td>
                    <td class="order-action">
                      <button type="button" class="details-button"
                        [class.action-button]="order.status === 'Pendiente'
                          || order.status === 'En preparación'"
                        (click)="openOrderDetails(order)"
                        [attr.aria-label]="orderActionLabel(order.status) + ' el pedido ' + order.id"
                        [title]="orderActionLabel(order.status)">
                        {{ orderActionLabel(order.status) }}
                      </button>
                    </td>
                  </tr>
                }
              </tbody>
            </table>
          </div>
        }
        </section>
      </div>
    </main>
  </div>
</div>

@if (selectedOrder(); as order) {
  <div class="order-detail-backdrop" (click)="closeOrderDetails()">
    <section class="order-detail-panel" role="dialog" aria-modal="true"
      aria-labelledby="order-detail-title" (click)="$event.stopPropagation()">
      <div class="order-detail-header">
        <div>
          <p class="eyebrow">DETALLE DEL PEDIDO</p>
          <h2 id="order-detail-title">#{{ order.id }}</h2>
          <span class="order-detail-date">{{ order.date }}</span>
        </div>
        <button type="button" class="close-detail-button" aria-label="Cerrar detalle del pedido"
          title="Cerrar" (click)="closeOrderDetails()">×</button>
      </div>

      <div class="order-detail-body">
        <section class="detail-section" aria-labelledby="detail-products-title">
          <h3 id="detail-products-title">Artículos</h3>
          @for (item of order.items; track item.name) {
            <div class="detail-product">
              <img [src]="item.imageUrl" [alt]="item.name">
              <div>
                <strong>{{ item.name }}</strong>
                <span>{{ item.quantity }} ud. · {{ formatPrice(item.price) }}</span>
              </div>
              <b>{{ formatPrice(item.price * item.quantity) }}</b>
            </div>
          }
          <div class="detail-total">
            <span>Subtotal</span>
            <strong>{{ formatPrice(order.total) }}</strong>
          </div>
        </section>

        <section class="detail-section" aria-labelledby="detail-status-title">
          <h3 id="detail-status-title">Estado del subpedido</h3>
          <label class="detail-status-field" for="detail-order-status">Actualizar estado</label>
          <select id="detail-order-status" [ngModel]="order.status"
            (ngModelChange)="updateOrderStatus($event)">
            <option value="Pendiente">Pendiente</option>
            <option value="En preparación">En preparación</option>
            <option value="Enviado">Enviado</option>
            <option value="Entregado">Entregado</option>
            <option value="Cancelado">Cancelado</option>
          </select>
        </section>

        <section class="detail-section detail-customer" aria-labelledby="detail-customer-title">
          <h3 id="detail-customer-title">Comprador y envío</h3>
          <strong>{{ order.customer }}</strong>
          <span>{{ order.customerEmail }}</span>
          <address>{{ order.shippingAddress }}</address>
        </section>
      </div>
    </section>
  </div>
}
</file>

<file path="frontend/src/app/features/products/seller-shared.css">
.seller-layout {
  --navy: #102c40;
  --teal: #42d6b2;
  --ink: #173247;
  --muted: #718694;
  --line: #dfe8ed;

  min-height: 100vh;
  color: var(--ink);
  font-family: Inter, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  font-size: 14px;
  background: #edf2f8;
  -webkit-font-smoothing: antialiased;
}

.seller-shell {
  --seller-sidebar-width: 248px;
  position: relative;
}

.seller-shell .app-sidebar {
  box-sizing: border-box;
  width: var(--seller-sidebar-width);
  background: #102c40;
  color: #edf5f8;
  transition: transform 0.25s ease;
}

.seller-shell .app-workspace {
  margin-left: var(--seller-sidebar-width);
}

.seller-shell.product-create-page {
  padding: 36px 36px 56px calc(var(--seller-sidebar-width) + 36px);
}

.seller-shell .app-sidebar-toggle {
  position: absolute;
  top: 30px;
  right: 12px;
  z-index: 2;
  display: grid;
  width: 28px;
  height: 28px;
  place-items: center;
  padding: 0;
  border: 0;
  border-radius: 7px;
  background: #1d4357;
  color: #edf5f8;
  cursor: pointer;
}

.seller-shell .app-sidebar-toggle svg,
.seller-shell .app-sidebar-toggle-open svg {
  width: 17px;
  height: 17px;
  fill: none;
  stroke: currentColor;
  stroke-linecap: round;
  stroke-linejoin: round;
  stroke-width: 2.5;
}

.seller-shell .app-sidebar-toggle:hover {
  background: #28546a;
}

.seller-shell .app-sidebar-toggle-open {
  position: fixed;
  top: 74px;
  left: 14px;
  z-index: 3;
  display: grid;
  width: 28px;
  height: 28px;
  place-items: center;
  padding: 0;
  border: 0;
  border-radius: 7px;
  background: #102c40;
  color: #edf5f8;
  cursor: pointer;
}

.seller-shell .app-sidebar-toggle-open[hidden] {
  display: none;
}

.seller-shell .app-sidebar .admin-brand,
.seller-shell .app-sidebar .client-brand,
.seller-shell .app-sidebar .brand {
  display: flex;
  align-items: center;
  gap: 11px;
  width: fit-content;
  margin: 0 0 54px 8px;
  color: #fff;
  font-size: 21px;
  font-weight: 750;
  letter-spacing: -0.7px;
  text-decoration: none;
}

.seller-shell .app-sidebar .brand-mark {
  display: grid;
  width: 34px;
  height: 34px;
  place-items: center;
  border-radius: 11px;
  background: #42d6b2;
  color: #102c40;
  font-size: 18px;
  font-weight: 800;
  box-shadow: 0 4px 12px rgb(25 157 130 / 20%);
}

.seller-shell .app-sidebar .brand-accent {
  color: #42d6b2;
}

.seller-shell .app-sidebar .sidebar-caption {
  margin: 0;
  padding: 0 10px 13px;
  color: #8396a4;
  font-size: 10px;
  font-weight: 750;
  letter-spacing: 1.15px;
}

.seller-shell .app-sidebar .admin-navigation,
.seller-shell .app-sidebar .client-navigation,
.seller-shell .app-sidebar .seller-navigation {
  display: grid;
  gap: 0;
}

.seller-shell .app-sidebar .navigation-link {
  box-sizing: border-box;
  display: flex;
  min-height: 44px;
  align-items: center;
  gap: 12px;
  padding: 0 12px;
  border-left: 3px solid transparent;
  border-radius: 8px;
  color: #c1d0d8;
  font-size: 13px;
  font-weight: 550;
  text-decoration: none;
}

.seller-shell .app-sidebar .navigation-link:hover,
.seller-shell .app-sidebar .navigation-link.is-active {
  background: #1d4357;
