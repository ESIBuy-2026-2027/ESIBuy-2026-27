import { HttpClient } from '@angular/common/http';
import { Component, computed, inject, OnInit, signal } from '@angular/core';
import { FormsModule } from '@angular/forms';
import { Location } from '@angular/common';
import { Router } from '@angular/router';
import { AuthService } from '../../../core/services/auth.service';
import { DeleteAccount } from '../../../shared/delete-account/delete-account';
import { Category, ProductsService } from '../../../core/services/products.service';
import { TwoFactorSettingsComponent } from '../../../shared/two-factor-settings/two-factor-settings';
import { ProfileShellComponent } from '../../../shared/profile-shell/profile-shell';
import type { ProfileNavigationItem } from '../../../shared/profile-shell/profile-shell';
import { SELLER_AVATARS } from '../../../core/constants/avatars';


interface SellerProfileResponse {
    firstName: string;
    lastName: string;
    email: string;
    phone: string | null;
    maskedNationalId: string | null;
    profileImage: string | null;
    businessName: string | null;
    defaultCategory: string | null;
    totpEnabled: boolean;
}

interface UpdateSellerProfileRequest {
    firstName: string;
    lastName: string;
    phone: string;
    profileImage: string;
    businessName: string;
    defaultCategory: string;
    nationalId?: string;
}

@Component({
    selector: 'app-seller-profile',
    standalone: true,
    imports: [FormsModule, DeleteAccount, TwoFactorSettingsComponent, ProfileShellComponent],
    templateUrl: './seller-profile.html',
    styleUrl: './seller-profile.css',
})
export class SellerProfile implements OnInit {
    private readonly authService = inject(AuthService);
    private readonly router = inject(Router);
    private readonly http = inject(HttpClient);
    private readonly location = inject(Location);
    private readonly productsService = inject(ProductsService);
    private readonly apiUrl = '/api/users/me/profile';

    readonly sellerAvatars: readonly string[] = SELLER_AVATARS;

    readonly selectedAvatar = signal(this.sellerAvatars[0]);

    readonly categories = signal<Category[]>([]);
    readonly categoriesLoading = signal(true);
    readonly categoriesError = signal(false);

    readonly profile = signal<SellerProfileResponse | null>(null);
    readonly loading = signal(true);
    readonly profileError = signal<string | null>(null);
    readonly logoutError = signal<string | null>(null);

    readonly editing = signal(false);
    readonly saving = signal(false);
    readonly editError = signal<string | null>(null);
    readonly editSuccess = signal<string | null>(null);

    editForm: UpdateSellerProfileRequest = this.emptyForm();

    readonly fullName = computed(() => {
        const profile = this.profile();
        return profile
            ? [profile.firstName, profile.lastName].filter(Boolean).join(' ')
            : '';
    });

    readonly initials = computed(() => {
        const profile = this.profile();
        if (!profile) return 'V';

        const first = profile.firstName?.trim().charAt(0) ?? '';
        const last = profile.lastName?.trim().charAt(0) ?? '';

        return `${first}${last}`.toUpperCase() || 'V';
    });

    readonly sellerEmail = computed(
        () => this.profile()?.email ?? this.authService.currentUser()?.email ?? '',
    );

    // Solo permite imágenes predefinidas de vendedor.
    readonly avatarImage = computed(() => {
        const path = this.normalizeAvatarPath(this.profile()?.profileImage);
        return this.sellerAvatars.includes(path) ? path : '';
    });

    // Durante la edición se muestra el avatar seleccionado.
    // En consulta se muestra el guardado, o el primero si no es válido.
    readonly displayAvatar = computed(() => {
        if (this.editing()) {
            return this.selectedAvatar();
        }

        return this.avatarImage() || this.sellerAvatars[0];
    });

    ngOnInit(): void {
        this.loadProfile();
        this.loadCategories();
    }

    readonly shellSections: ProfileNavigationItem[] = [
        { key: 'personal', label: 'Datos personales y negocio' },
        { key: 'security', label: 'Seguridad' },
    ];

    readonly activeSection = signal<'personal' | 'security'>('personal');

    readonly twoFactorEnabled = signal(false);

    selectSection(section: 'personal' | 'security'): void {
        this.activeSection.set(section);
    }

    onTwoFactorEnabledChange(enabled: boolean): void {
        this.twoFactorEnabled.set(enabled);

        const currentProfile = this.profile();

        if (currentProfile) {
            this.profile.set({
                ...currentProfile,
                totpEnabled: enabled,
            });
        }
    }

    private emptyForm(): UpdateSellerProfileRequest {
        return {
            firstName: '',
            lastName: '',
            phone: '',
            profileImage: this.sellerAvatars[0],
            businessName: '',
            defaultCategory: '',
            nationalId: '',
        };
    }

    private normalizeAvatarPath(path: string | null | undefined): string {
        return path?.replace(/^\/+/, '') ?? '';
    }

    selectAvatar(avatar: string): void {
        if (!this.editing() || this.saving()) return;

        if (this.sellerAvatars.includes(avatar)) {
            this.selectedAvatar.set(avatar);
            this.editForm.profileImage = avatar;
        }
    }

    loadProfile(): void {
        this.loading.set(true);
        this.profileError.set(null);

        this.http.get<SellerProfileResponse>(this.apiUrl, {
            withCredentials: true,
        }).subscribe({
            next: profile => {
                this.profile.set(profile);

                // Igual que en el perfil del cliente.
                this.twoFactorEnabled.set(profile.totpEnabled === true);

                const savedAvatar = this.avatarImage();
                const avatar = savedAvatar || this.sellerAvatars[0];

                this.selectedAvatar.set(avatar);

                this.editForm = {
                    firstName: profile.firstName ?? '',
                    lastName: profile.lastName ?? '',
                    phone: profile.phone ?? '',
                    profileImage: avatar,
                    businessName: profile.businessName ?? '',
                    defaultCategory: profile.defaultCategory ?? '',
                    nationalId: '',
                };

                this.loading.set(false);
            },
            error: () => {
                this.loading.set(false);
                this.profileError.set(
                    'No se ha podido cargar el perfil. Inténtalo de nuevo.',
                );
            },
        });
    }

    startEditing(): void {
        const profile = this.profile();
        if (!profile) return;

        const avatar = this.avatarImage() || this.sellerAvatars[0];

        this.selectedAvatar.set(avatar);

        this.editForm = {
            firstName: profile.firstName ?? '',
            lastName: profile.lastName ?? '',
            phone: profile.phone ?? '',
            profileImage: avatar,
            businessName: profile.businessName ?? '',
            defaultCategory: profile.defaultCategory ?? '',
            nationalId: '',
        };

        this.editError.set(null);
        this.editSuccess.set(null);
        this.editing.set(true);
    }

    cancelEditing(): void {
        const profile = this.profile();
        const avatar = this.avatarImage() || this.sellerAvatars[0];

        this.selectedAvatar.set(avatar);
        this.editing.set(false);
        this.editError.set(null);
        this.editForm = this.emptyForm();

        // No se pierden los datos del perfil al cancelar.
        if (profile) {
            this.editForm = {
                firstName: profile.firstName ?? '',
                lastName: profile.lastName ?? '',
                phone: profile.phone ?? '',
                profileImage: avatar,
                businessName: profile.businessName ?? '',
                defaultCategory: profile.defaultCategory ?? '',
                nationalId: '',
            };
        }
    }

    saveProfile(): void {
        if (this.saving()) return;

        this.editError.set(null);
        this.editSuccess.set(null);

        if (!this.selectedAvatar() || !this.sellerAvatars.includes(this.selectedAvatar())) {
            this.editError.set('Selecciona una imagen de perfil válida.');
            return;
        }

        const payload: UpdateSellerProfileRequest = {
            firstName: this.editForm.firstName.trim(),
            lastName: this.editForm.lastName.trim(),
            phone: this.editForm.phone.trim(),
            profileImage: this.selectedAvatar(),
            businessName: this.editForm.businessName.trim(),
            defaultCategory: this.editForm.defaultCategory.trim(),
        };

        const newNationalId = this.editForm.nationalId?.trim();
        if (newNationalId) {
            payload.nationalId = newNationalId;
        }

        this.saving.set(true);

        this.http.put<SellerProfileResponse>(this.apiUrl, payload, {
            withCredentials: true,
        }).subscribe({
            next: response => {
                // Si el backend no devuelve profileImage, conservamos
                // el avatar que acabamos de guardar.
                const profile: SellerProfileResponse = {
                    ...response,
                    profileImage: response.profileImage || payload.profileImage,
                };

                this.profile.set(profile);
                this.selectedAvatar.set(
                    this.normalizeAvatarPath(profile.profileImage)
                        ? this.normalizeAvatarPath(profile.profileImage)
                        : payload.profileImage,
                );

                this.saving.set(false);
                this.editing.set(false);
                this.editSuccess.set(
                    'Tus datos se han actualizado correctamente.',
                );
                this.editForm = this.emptyForm();
            },
            error: (error: {
                status?: number;
                error?: {
                    message?: string;
                    detail?: string;
                    errors?: Record<string, string>;
                };
            }) => {
                this.saving.set(false);

                const validationErrors = error.error?.errors
                    ? Object.values(error.error.errors).join('. ')
                    : null;

                let fallbackError = 'No se han podido guardar los cambios. Inténtalo de nuevo.';
                if (error.status === 409) {
                    fallbackError = 'Ya existe un vendedor con ese nombre comercial.';
                } else if (error.status === 400) {
                    fallbackError = 'Revisa los campos introducidos. Comprueba también que el teléfono tenga 9 dígitos.';
                }

                this.editError.set(
                    validationErrors
                    ?? error.error?.detail
                    ?? error.error?.message
                    ?? fallbackError,
                );
            },
        });
    }

    private loadCategories(): void {
        this.categoriesLoading.set(true);
        this.categoriesError.set(false);

        this.productsService.getCategories().subscribe({
            next: categories => {
                this.categories.set(categories);
                this.categoriesLoading.set(false);

                const currentCategory = this.editForm.defaultCategory;

                if (
                    currentCategory &&
                    categories.some(category => category.name === currentCategory)
                ) {
                    return;
                }

                if (categories.length > 0) {
                    this.editForm.defaultCategory = categories[0].name;
                }
            },
            error: () => {
                this.categoriesLoading.set(false);
                this.categoriesError.set(true);
            },
        });
    }

    goBack(): void {
        if (window.history.length > 1) {
            this.location.back();
        } else {
            window.history.replaceState(null, '', '/seller/catalog');
        }
    }

    logout(): void {
        this.logoutError.set(null);

        this.authService.logout().subscribe({
            next: () => void this.router.navigate(['/']),
            error: () => this.logoutError.set(
                'No se pudo cerrar la sesión. Inténtalo de nuevo.',
            ),
        });
    }
}
</file>

<file path="frontend/src/app/features/client/client-profile/client-profile.css">
:host {
    display: block;
    min-height: calc(100vh - var(--app-header-height, 56px));
    background: var(--color-page-background);
    color: #172b3a;
    font-family: Inter, "Segoe UI", sans-serif;
}

* {
    box-sizing: border-box;
}

/* ESTRUCTURA PRINCIPAL */

.profile-page {
    display: grid;
    width: min(1200px, 100%);
    grid-template-columns: 250px minmax(0, 1fr);
    align-items: start;
    gap: 24px;
    margin: 0 auto;
    padding: 40px 32px 64px;
}

/* BARRA LATERAL */

.profile-card {
    display: flex;
    min-width: 0;
    min-height: 460px;
    flex-direction: column;
    align-items: center;
    padding: 28px 14px 18px;
    border: 1px solid #d9e3eb;
    border-radius: 16px;
    background: #fff;
    box-shadow: 0 8px 24px rgb(16 44 64 / 5%);
}

.sidebar-profile {
    display: flex;
    width: 100%;
    flex-direction: column;
    align-items: center;
}

.avatar {
    display: grid;
    width: 76px;
    height: 76px;
    flex-shrink: 0;
    place-items: center;
    overflow: hidden;
    border-radius: 50%;
    background: var(--color-brand-dark);
    color: var(--color-brand-accent);
    font-size: 26px;
    font-weight: 750;
}

.avatar-image {
    display: block;
    width: 76px;
    height: 76px;
    border-radius: 50%;
    object-fit: cover;
}

.sidebar-name {
    margin: 14px 0 8px;
    color: var(--color-text-primary);
    font-size: 15px;
    font-weight: 750;
    text-align: center;
    overflow-wrap: anywhere;
}

.role-badge {
    display: inline-block;
    max-width: 100%;
    padding: 4px 12px;
    border-radius: 999px;
    background: #e8f1f5;
    color: #1f4561;
    font-size: 11px;
    font-weight: 700;
    text-align: center;
}

.premium-badge {
    background: var(--color-brand-accent);
    color: var(--color-brand-dark);
}

/* NAVEGACIÓN */

.sidebar-nav {
    display: grid;
    width: 100%;
    gap: 4px;
    margin-top: 24px;
}

.sidebar-nav .nav-item {
    display: block;
    width: 100%;
    padding: 11px 12px;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: #3a5871;
    font-family: inherit;
    font-size: 13px;
    font-weight: 550;
    text-align: left;
    text-decoration: none;
    cursor: pointer;
}

.sidebar-nav .nav-item.active {
    background: #dde8f0;
    color: var(--color-brand-dark);
    font-weight: 700;
}

.sidebar-nav .nav-item:not(.disabled):hover {
    background: #edf3f7;
    color: var(--color-brand-dark);
}

.sidebar-nav .nav-item.active:hover {
    background: #dde8f0;
}

.sidebar-nav .nav-item:focus-visible {
    outline: 3px solid rgb(66 214 178 / 35%);
    outline-offset: 2px;
}

.sidebar-nav .nav-item.disabled {
    color: #8396a4;
    cursor: not-allowed;
    opacity: 0.8;
}

/* PIE DE LA BARRA LATERAL */

.sidebar-footer {
    display: flex;
    width: 100%;
    flex-direction: column;
    gap: 6px;
    margin-top: auto;
    padding-top: 18px;
    border-top: 1px solid #e7edf0;
}

.sidebar-footer .form-error {
    margin-bottom: 8px;
}

.logout-button,
.sidebar-footer .back-button {
    display: flex;
    width: 100%;
    min-height: 40px;
    align-items: center;
    justify-content: flex-start;
    gap: 8px;
    padding: 10px 12px;
    border: 0;
    border-radius: 8px;
    background: transparent;
    font: inherit;
    font-size: 13px;
    font-weight: 550;
    text-align: left;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
}

.logout-button {
    color: var(--color-text-secondary);
}

.logout-button:hover {
    background: #c43434ba;
    color: #ffe2e2;
}

.sidebar-footer .back-button {
    color: #3a5871;
}

.sidebar-footer .back-button:hover {
    background: #dde8f0;
    color: var(--color-brand-dark);
}

.sidebar-footer .logout-button:focus-visible,
.sidebar-footer .back-button:focus-visible {
    outline: 3px solid rgb(66 214 178 / 35%);
    outline-offset: 2px;
}

/* CONTENIDO PRINCIPAL */

.profile-main {
    min-width: 0;
}

/* PANELES */

.panel {
    display: block;
    width: 100%;
    min-width: 0;
    padding: 26px 28px 30px;
    border: 1px solid #d9e3eb;
    border-radius: 16px;
    background: #fff;
    box-shadow: 0 8px 24px rgb(16 44 64 / 5%);
}

.panel-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 22px;
}

.panel-heading-text {
    min-width: 0;
}

.eyebrow {
    display: block;
    margin-bottom: 7px;
    color: #528477;
    font-size: 10px;
    font-weight: 750;
    letter-spacing: 1.1px;
}

.panel-title {
    margin: 0 0 6px;
    color: var(--color-text-primary);
    font-size: 20px;
    font-weight: 750;
    letter-spacing: -0.4px;
    overflow-wrap: anywhere;
}

.panel-description {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 13px;
    line-height: 1.6;
}

.loading-message {
    padding: 8px 0;
}

/* BANNER PREMIUM */

.premium-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    margin-bottom: 24px;
    padding: 22px 26px;
    border-radius: 16px;
    background: #0a3a4a;
    color: #fff;
}

.premium-banner-content {
    min-width: 0;
}

.premium-eyebrow {
    color: #5ccfc0;
    font-size: 11px;
    font-weight: 750;
    letter-spacing: 1px;
}

.premium-banner h2 {
    margin: 5px 0 7px;
    font-size: 18px;
    letter-spacing: -0.3px;
    overflow-wrap: anywhere;
}

.premium-banner p {
    margin: 0;
    color: #c9dfe6;
    font-size: 12px;
    line-height: 1.6;
}

.premium-action {
    display: inline-flex;
    min-height: 42px;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    padding: 0 18px;
    border: 0;
    border-radius: 8px;
    background: var(--color-brand-accent);
    color: var(--color-brand-dark);
    font: inherit;
    font-size: 13px;
    font-weight: 700;
    cursor: not-allowed;
    opacity: 0.65;
}

/* CAMPOS DEL FORMULARIO */

.section-title {
    margin: 26px 0 14px;
    padding-bottom: 10px;
    border-bottom: 1px solid #e7edf0;
    color: var(--color-text-primary);
    font-size: 15px;
    font-weight: 750;
}

.panel-heading+form>.section-title {
    margin-top: 0;
}

.field-grid {
    display: grid;
    width: 100%;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px 18px;
}

.field {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 6px;
}

.field label {
    color: #72828e;
    font-size: 11px;
    font-weight: 650;
}

.field label span {
    color: #c0392b;
}

.field input,
.field select {
    display: block;
    width: 100%;
    min-width: 0;
    min-height: 42px;
    padding: 10px 12px;
    border: 1px solid #dce6ea;
    border-radius: 8px;
    background: #f4f8f9;
    color: #203b4e;
    font: inherit;
    font-size: 13px;
    transition: border-color 0.2s ease, background-color 0.2s ease,
        box-shadow 0.2s ease;
}

.field input::placeholder {
    color: #9aaab3;
}

.field input[readonly] {
    cursor: default;
}

.field input:not([readonly]) {
    border-color: #9aafbf;
    background: #fff;
}

.field input:not([readonly]):focus,
.field select:focus {
    border-color: #42bfa3;
    outline: 3px solid rgb(66 214 178 / 22%);
    outline-offset: 1px;
}

.field input:disabled,
.field select:disabled {
    cursor: not-allowed;
    opacity: 0.7;
}

.field small {
    color: #72828e;
    font-size: 11px;
    line-height: 1.5;
}

/* SELECTOR DE AVATARES */

.avatar-section {
    margin-top: 26px;
}

.avatar-section .section-title {
    margin-top: 0;
}

.section-description {
    margin: 0 0 14px;
    color: var(--color-text-secondary);
    font-size: 12px;
    line-height: 1.6;
}

.avatar-selector-grid {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
}

.avatar-item {
    position: relative;
    display: block;
    width: 76px;
    height: 76px;
    flex: 0 0 76px;
    padding: 3px;
    overflow: hidden;
    border: 2px solid #dce6ea;
    border-radius: 50%;
    background: #f4f8f9;
    cursor: pointer;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.avatar-item img {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
}

.avatar-item:hover:not(:disabled) {
    border-color: #24b99b;
}

.avatar-item.selected {
    border-color: #24b99b;
    box-shadow: 0 0 0 3px rgb(66 214 178 / 20%);
}

.avatar-item:focus-visible {
    outline: 3px solid rgb(66 214 178 / 35%);
    outline-offset: 3px;
}

.avatar-item:disabled {
    cursor: not-allowed;
    opacity: 0.65;
}

.avatar-check {
    position: absolute;
    right: 0;
    bottom: 0;
    display: grid;
    width: 23px;
    height: 23px;
    place-items: center;
    border: 2px solid #fff;
    border-radius: 50%;
    background: #24b99b;
    color: #fff;
    font-size: 13px;
    font-weight: 800;
}

/* BOTONES */

.primary-button,
.secondary-button,
.back-button {
    display: inline-flex;
    min-height: 40px;
    align-items: center;
    justify-content: center;
    gap: 7px;
    padding: 9px 16px;
    border-radius: 8px;
    font: inherit;
    font-size: 13px;
    font-weight: 650;
    cursor: pointer;
    transition: background-color 0.2s ease, border-color 0.2s ease,
        color 0.2s ease, opacity 0.2s ease;
}

.primary-button {
    flex-shrink: 0;
    border: 0;
    background: var(--color-brand-dark);
    color: #fff;
}

.primary-button:hover:not(:disabled) {
    background: #173f56;
}

.secondary-button {
    border: 1px solid #d9e3eb;
    background: #fff;
    color: #3a5871;
}

.secondary-button:hover:not(:disabled) {
    border-color: #9aafbf;
    background: #f4f8f9;
}

.primary-button:disabled,
.secondary-button:disabled {
    cursor: not-allowed;
    opacity: 0.6;
}

.primary-button:focus-visible,
.secondary-button:focus-visible,
.back-button:focus-visible {
    outline: 3px solid rgb(66 214 178 / 35%);
    outline-offset: 2px;
}

.form-actions {
    display: flex;
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 26px;
}

/* MENSAJES */

.success-message {
    display: block;
    margin: 0 0 18px;
    padding: 12px 14px;
    border: 1px solid #a9ddc5;
    border-radius: 8px;
    background: #edf9f2;
    color: #17633c;
    font-size: 13px;
    line-height: 1.5;
}

.form-error {
    margin: 0 0 18px;
    padding: 12px 14px;
    border: 1px solid #f1aeb5;
    border-radius: 8px;
    background: #f8d7da;
    color: #842029;
    font-size: 13px;
    line-height: 1.5;
}

/* ZONA DE PELIGRO */

.danger-zone {
    margin-top: 1.5rem;
    border: 1px solid #e5b8b8;
}

.danger-zone .panel-title {
    color: #a52828;
}


/* Acciones de la barra lateral: estilo común en todos los perfiles */
.sidebar-footer .logout-button,
.sidebar-footer .back-button {
    display: flex;
    width: 100%;
    min-height: 40px;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 9px 12px;
    border: 1px solid transparent;
    border-radius: 8px;
    font: inherit;
    font-size: 13px;
    font-weight: 650;
    line-height: 1.25;
    text-align: center;
    cursor: pointer;
    transition: background-color 0.2s ease, border-color 0.2s ease,
        color 0.2s ease, box-shadow 0.2s ease;
}

.sidebar-footer .logout-button {
    border-color: #f0d5d5;
    background: #fff5f5;
    color: #a33131;
}

.sidebar-footer .logout-button:hover {
    border-color: #e9bebe;
    background: #ffe9e9;
    color: #8f2525;
}

.sidebar-footer .back-button:focus-visible {
    outline: 3px solid rgb(66 214 178 / 55%);
    outline-offset: 2px;
}

.sidebar-footer .logout-button:active,
.sidebar-footer .back-button:active {
    transform: translateY(1px);
}

@media (prefers-reduced-motion: reduce) {
    .sidebar-footer .logout-button,
    .sidebar-footer .back-button {
        transition: none;
    }
}

/* Estilos definitivos de los botones del perfil del cliente */
.profile-card .sidebar-footer button.back-button {
    background: #fff !important;
    border: 1px solid #d9e3eb !important;
    color: #31536b !important;
}

.profile-card .sidebar-footer button.back-button:hover {
    background: #f4f8fa !important;
    border-color: #c5d5e0 !important;
    color: var(--color-brand-dark) !important;
}

.profile-card .sidebar-footer button.logout-button {
    background: #fff5f5 !important;
    border: 1px solid #f0d5d5 !important;
    color: #a33131 !important;
}

.profile-card .sidebar-footer button.logout-button:hover {
    background: #ffe9e9 !important;
    border-color: #e9bebe !important;
    color: #8f2525 !important;
}
</file>

<file path="backend/src/main/java/es/uclm/esibuy/security/config/SecurityConfig.java">
package es.uclm.esibuy.security.config;

import java.io.IOException;
import java.util.List;

import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;
import org.springframework.http.HttpMethod;
import org.springframework.http.MediaType;
import org.springframework.security.config.Customizer;
import org.springframework.security.config.annotation.method.configuration.EnableMethodSecurity;
import org.springframework.security.config.annotation.web.builders.HttpSecurity;
import org.springframework.security.config.annotation.web.configuration.EnableWebSecurity;
import org.springframework.security.config.http.SessionCreationPolicy;
import org.springframework.security.crypto.bcrypt.BCryptPasswordEncoder;
import org.springframework.security.crypto.password.PasswordEncoder;
import org.springframework.security.web.SecurityFilterChain;
import org.springframework.security.web.authentication.UsernamePasswordAuthenticationFilter;
import org.springframework.security.web.context.HttpSessionSecurityContextRepository;
import org.springframework.security.web.context.SecurityContextRepository;
import org.springframework.security.web.csrf.CookieCsrfTokenRepository;
import org.springframework.security.web.csrf.CsrfFilter;
import org.springframework.security.web.csrf.CsrfToken;
import org.springframework.security.web.csrf.CsrfTokenRequestAttributeHandler;
import org.springframework.web.cors.CorsConfiguration;
import org.springframework.web.cors.CorsConfigurationSource;
import org.springframework.web.cors.UrlBasedCorsConfigurationSource;
import org.springframework.web.filter.OncePerRequestFilter;

import es.uclm.esibuy.common.filter.CorrelationIdFilter;
import jakarta.servlet.FilterChain;
import jakarta.servlet.ServletException;
import jakarta.servlet.http.HttpServletRequest;
import jakarta.servlet.http.HttpServletResponse;

@Configuration
@EnableWebSecurity
@EnableMethodSecurity
public class SecurityConfig {

        private static final Logger LOGGER = LoggerFactory.getLogger(SecurityConfig.class);
        private static final String ROLE_CLIENT = "CLIENT";
        private static final String ROLE_ADMIN = "ADMIN";
        private static final String ROLE_SELLER = "SELLER";

        @Bean
        SecurityContextRepository securityContextRepository() {
                return new HttpSessionSecurityContextRepository();
        }

        @Bean
        CookieCsrfTokenRepository csrfTokenRepository(
                        @Value("${server.servlet.session.cookie.secure:false}") boolean secureCookie,
                        @Value("${server.servlet.session.cookie.same-site:Lax}") String sameSite) {

                CookieCsrfTokenRepository repository = CookieCsrfTokenRepository.withHttpOnlyFalse();

                repository.setCookieCustomizer(cookie -> cookie
                                .path("/")
                                .secure(secureCookie)
                                .sameSite(sameSite));

                return repository;
        }

        @Bean
        SecurityFilterChain securityFilterChain(
                        HttpSecurity http,
                        SecurityContextRepository securityContextRepository,
                        CookieCsrfTokenRepository csrfTokenRepository) {
                try {
                        return http
                                        .cors(Customizer.withDefaults())
                                        .csrf(csrf -> csrf
                                                        .csrfTokenRepository(csrfTokenRepository)
                                                        .csrfTokenRequestHandler(
                                                                        new CsrfTokenRequestAttributeHandler()))
                                        .securityContext(context -> context
                                                        .securityContextRepository(securityContextRepository))
                                        .sessionManagement(session -> session
                                                        .sessionCreationPolicy(SessionCreationPolicy.IF_REQUIRED))
                                        .exceptionHandling(errors -> errors
                                                        .authenticationEntryPoint((request, response,
                                                                        exception) -> writeSecurityError(
                                                                                        request, response,
                                                                                        HttpServletResponse.SC_UNAUTHORIZED,
                                                                                        "Autenticación requerida"))
                                                        .accessDeniedHandler((request, response,
                                                                        exception) -> writeSecurityError(
                                                                                        request, response,
                                                                                        HttpServletResponse.SC_FORBIDDEN,
                                                                                        "No tiene permisos para realizar esta acción")))
                                        .authorizeHttpRequests(auth -> auth
                                                        .requestMatchers(HttpMethod.GET, "/api/categories",
                                                                        "/api/categorias")
                                                        .permitAll()
                                                        .requestMatchers(
                                                                        "/", "/api/users/register/**",
                                                                        "/api/users/login", "/actuator/health",
                                                                        "/api/users/login/verify-otp")
                                                        .permitAll()
                                                        .requestMatchers(HttpMethod.POST, "/api/users/admin")
                                                        .hasRole(ROLE_ADMIN)
                                                        .requestMatchers("/api/admin/**", "/api/v1/admin/**")
                                                        .hasRole(ROLE_ADMIN)
                                                        .requestMatchers(HttpMethod.GET, "/api/products/mine",
                                                                        "/api/products/summary",
                                                                        "/api/products/resumen")
                                                        .hasRole(ROLE_SELLER)
                                                        .requestMatchers(HttpMethod.POST, "/api/products")
                                                        .hasRole(ROLE_SELLER)
                                                        .requestMatchers(HttpMethod.PATCH, "/api/products/*/status")
                                                        .hasAnyRole(ROLE_SELLER, ROLE_ADMIN)
                                                        .requestMatchers(HttpMethod.GET, "/api/products",
                                                                        "/api/products/*")
                                                        .permitAll()
                                                        .requestMatchers("/api/catalog/**").hasRole(ROLE_CLIENT)
                                                        .requestMatchers("/api/products/**").hasRole(ROLE_SELLER)
                                                        .requestMatchers("/api/wishlist/**").hasRole(ROLE_CLIENT)
                                                        .requestMatchers(HttpMethod.GET, "/api/users/me/profile")
                                                        .hasAnyRole(ROLE_CLIENT, ROLE_SELLER, ROLE_ADMIN)
                                                        .requestMatchers(HttpMethod.DELETE, "/api/users/me")
                                                        .hasAnyRole(ROLE_CLIENT, ROLE_SELLER)
                                                        .requestMatchers(HttpMethod.PUT, "/api/users/me/profile")
                                                        .hasAnyRole(ROLE_CLIENT, ROLE_SELLER, ROLE_ADMIN)
                                                        .requestMatchers("/api/users/me/addresses/**")
                                                        .hasRole(ROLE_CLIENT)
                                                        .requestMatchers("/api/users/me/payment-methods/**")
                                                        .hasRole(ROLE_CLIENT)
                                                        .requestMatchers(
                                                                        HttpMethod.POST,
                                                                        "/api/auth/password-reset/request",
                                                                        "/api/auth/password-reset/confirm")
                                                        .permitAll()
                                                        .requestMatchers("/api/auth/password-reset/**").permitAll()
                                                        .anyRequest().authenticated())
                                        .addFilterBefore(new CorrelationIdFilter(),
                                                        UsernamePasswordAuthenticationFilter.class)
                                        .addFilterAfter(new CsrfCookieFilter(), CsrfFilter.class)
                                        .build();
                } catch (Exception exception) {
                        throw new IllegalStateException("No se pudo construir la configuracion de seguridad",
                                        exception);
                }
        }

        private void writeSecurityError(
                        HttpServletRequest request,
                        HttpServletResponse response,
                        int status,
                        String message) throws IOException {
                Object correlationId = request.getAttribute(CorrelationIdFilter.ATTRIBUTE);
                String id = correlationId == null ? "" : correlationId.toString();
                LOGGER.warn("Solicitud de seguridad rechazada. status={}, correlationId={}", status, id);
                response.setStatus(status);
                response.setContentType(MediaType.APPLICATION_JSON_VALUE);
                response.setHeader(CorrelationIdFilter.HEADER, id);
                response.getWriter().write("{\"success\":false,\"message\":\"" + message
                                + "\",\"correlationId\":\"" + id + "\"}");
        }

        @Bean
        CorsConfigurationSource corsConfigurationSource() {
                CorsConfiguration configuration = new CorsConfiguration();
                configuration.setAllowedOrigins(List.of(
                                "http://localhost:3000",
                                "http://localhost:5173",
                                "http://localhost:4200"));
                configuration.setAllowedMethods(List.of("GET", "POST", "PUT", "DELETE", "OPTIONS", "PATCH"));
                configuration.setAllowedHeaders(List.of("*"));
                configuration.setExposedHeaders(List.of("Retry-After", CorrelationIdFilter.HEADER));
                configuration.setAllowCredentials(true);

                UrlBasedCorsConfigurationSource source = new UrlBasedCorsConfigurationSource();
                source.registerCorsConfiguration("/**", configuration);
                return source;
        }

        @Bean
        PasswordEncoder passwordEncoder() {
                return new BCryptPasswordEncoder();
        }

        private static final class CsrfCookieFilter extends OncePerRequestFilter {

                @Override
                protected void doFilterInternal(
                                HttpServletRequest request,
                                HttpServletResponse response,
                                FilterChain filterChain) throws ServletException, IOException {
                        CsrfToken csrfToken = (CsrfToken) request.getAttribute(CsrfToken.class.getName());
                        if (csrfToken != null) {
                                csrfToken.getToken();
                        }
                        filterChain.doFilter(request, response);
                }
        }
}
