<file path="frontend/src/app/features/products/product-create/product-create.css">
:host {
  display: block;
  min-height: 100vh;
  background: var(--color-page-background);
  color: var(--color-text-primary);
  font-family: Inter, "Segoe UI", sans-serif;
}

/* Estructura general */

* {
  box-sizing: border-box;
}

.product-create-page {
  min-height: 100vh;
  padding: 36px 36px 56px 284px;
}

.product-create-content {
  width: 100%;
  max-width: 1120px;
  margin: 0 auto;
}

.product-create-card {
  overflow: hidden;
  width: 100%;
  padding: 30px;
  border: 1px solid #e4ebf1;
  border-radius: 16px;
  background: #ffffff;
  box-shadow:
    0 8px 28px rgb(25 48 70 / 5%),
    0 1px 3px rgb(25 48 70 / 3%);
}

/* La barra lateral y sus estilos se comparten en AppSidebarComponent. */

/* Cabecera de la página */

.page-header {
  margin-bottom: 28px;
  padding-bottom: 25px;
  border-bottom: 1px solid #edf1f4;
}

.back-link {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 25px;
  color: #496679;
  font-size: 13px;
  font-weight: 650;
  text-decoration: none;
  transition: color 0.18s ease;
}

.back-link span {
  font-size: 18px;
  line-height: 1;
}

.back-link:hover {
  color: #0d3f4f;
}

.page-heading-copy {
  display: grid;
  justify-items: start;
}

.page-kicker {
  display: inline-block;
  margin-bottom: 9px;
  color: #258f80;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 1.2px;
}

h1,
h2,
p {
  margin-top: 0;
}

.page-header h1 {
  margin-bottom: 9px;
  color: var(--color-brand-dark);
  font-size: clamp(25px, 3vw, 32px);
  font-weight: 750;
  letter-spacing: -1px;
  line-height: 1.2;
}

.page-description {
  max-width: 650px;
  margin-bottom: 0;
  color: #72828e;
  font-size: 13px;
  line-height: 1.7;
}

/* Formulario */

.product-form {
  display: grid;
  gap: 0;
}

.form-section {
  min-width: 0;
  padding: 26px 0;
  border-bottom: 1px solid #edf1f4;
}

.form-section:first-child {
  padding-top: 0;
}

.form-section:last-of-type {
  padding-bottom: 27px;
}

.section-heading {
  display: flex;
  align-items: flex-start;
  gap: 13px;
  margin-bottom: 24px;
}

.section-number {
  display: grid;
  width: 35px;
  height: 35px;
  flex: 0 0 35px;
  place-items: center;
  border: 1px solid #c8f0e6;
  border-radius: 10px;
  background: #e5faf4;
  color: #167b6c;
  font-size: 11px;
  font-weight: 800;
}

.section-heading h2 {
  margin: 1px 0 5px;
  color: var(--color-text-primary);
  font-size: 16px;
  font-weight: 750;
  letter-spacing: -0.2px;
}

.section-heading p {
  margin-bottom: 0;
  color: #72828e;
  font-size: 12px;
  line-height: 1.6;
}

.form-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 21px 20px;
}

.form-field {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 8px;
}

.full-width {
  grid-column: 1 / -1;
}

.form-field > label {
  color: #294355;
  font-size: 12px;
  font-weight: 700;
}

.form-field input,
.form-field select,
.form-field textarea {
  width: 100%;
  min-width: 0;
  min-height: 44px;
  padding: 11px 12px;
  border: 1px solid #dce5ec;
  border-radius: 9px;
  outline: none;
  background: #f9fbfd;
  color: #203b4e;
  font-family: inherit;
  font-size: 13px;
  transition:
    border-color 0.18s ease,
    box-shadow 0.18s ease,
    background-color 0.18s ease;
}

.form-field input::placeholder,
.form-field textarea::placeholder {
  color: #9aa8b3;
  opacity: 1;
}

.form-field textarea {
  min-height: 115px;
  resize: vertical;
  line-height: 1.6;
}

.form-field select[multiple] {
  min-height: 126px;
  padding: 6px;
  background: #fbfcfe;
}

.form-field select[multiple] option {
  padding: 9px;
  border-radius: 5px;
  color: #203b4e;
  background: #ffffff;
}

.form-field select[multiple] option:checked {
  background: #dffaf4;
  color: var(--color-text-primary);
}

.form-field input:hover,
.form-field select:hover,
.form-field textarea:hover {
  border-color: #bdcfd9;
}

.form-field input:focus,
.form-field select:focus,
.form-field textarea:focus {
  border-color: #42cbb0;
  outline: none;
  background: #ffffff;
  box-shadow: 0 0 0 3px rgb(66 214 178 / 15%);
}

.form-field input:disabled,
.form-field select:disabled,
.form-field textarea:disabled {
  cursor: not-allowed;
  opacity: 0.65;
}

/* Precio y porcentajes */

.input-with-suffix {
  position: relative;
  min-width: 0;
}

.input-with-suffix input {
  padding-right: 38px;
}

.input-with-suffix > span {
  position: absolute;
  top: 50%;
  right: 13px;
  color: #72828e;
  font-size: 13px;
  font-weight: 650;
  pointer-events: none;
  transform: translateY(-50%);
}

/* Ayudas y validaciones */

.field-hint,
.field-error {
  font-size: 11px;
  line-height: 1.55;
}

.field-hint {
  color: #7a8995;
}

.field-error {
  color: #b14a46;
  font-weight: 550;
}

.field-error[role="alert"] {
  display: block;
}

/* Imagen */
.image-preview {
  display: flex;
  width: 170px;
  height: 170px;
  max-width: 100%;
  align-items: center;
  justify-content: center;
  margin: 8px auto 0;
  overflow: hidden;
  border: 1px dashed #cbd9e2;
  border-radius: 12px;
  background: #f8fafc;
  transition:
    border-color 0.18s ease,
    background-color 0.18s ease;
}

.image-preview img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: contain;
  object-position: center;
  background: #ffffff;
}

.image-preview img[hidden] {
  display: none;
}

.image-preview-text {
  padding: 12px;
  color: #82909a;
  font-size: 11px;
  text-align: center;
  line-height: 1.5;
}

.image-preview.has-error {
  border-color: #e3b8b1;
  background: #fff7f5;
}

.image-preview.has-error .image-preview-text {
  color: #a84f41;
}

/* Visibilidad del producto */

.visibility-toggle {
  display: flex;
  grid-column: 1 / -1;
  align-items: flex-start;
  gap: 12px;
  padding: 16px;
  border: 1px solid #dceee9;
  border-radius: 10px;
  background: #f5fbf9;
  cursor: pointer;
  transition:
    border-color 0.18s ease,
    background-color 0.18s ease;
}

.visibility-toggle:hover {
  border-color: #b6e5d9;
  background: #f0faf6;
}

.visibility-toggle input {
  width: 17px;
  height: 17px;
  flex: 0 0 17px;
  margin: 2px 0 0;
  accent-color: #1ba98f;
  cursor: pointer;
}

.visibility-copy {
  display: grid;
  gap: 5px;
}

.visibility-toggle strong {
  color: #294355;
  font-size: 12px;
  font-weight: 750;
}

.visibility-toggle small {
  color: #72828e;
  font-size: 11px;
  line-height: 1.5;
}

/* Mensajes de carga, error y éxito */

.product-load-message {
  display: flex;
  min-height: 100px;
  align-items: center;
  justify-content: center;
  gap: 11px;
  padding: 22px;
  color: #647786;
  font-size: 13px;
}

.loading-indicator {
  width: 17px;
  height: 17px;
  flex: 0 0 17px;
  border: 2px solid #d8e9e7;
  border-top-color: #1ba98f;
  border-radius: 50%;
  animation: product-spinner 0.8s linear infinite;
}

@keyframes product-spinner {
  to {
    transform: rotate(360deg);
  }
}

.submit-error,
.submit-success {
  padding: 13px 15px;
  border-radius: 9px;
  font-size: 12px;
  line-height: 1.6;
}

.submit-error {
  border: 1px solid #f1d4d0;
  background: #fff7f5;
  color: #8d4d49;
}

.submit-error button {
  margin-left: 12px;
  padding: 0;
  border: 0;
  background: transparent;
  color: #773d39;
  cursor: pointer;
  font: inherit;
  font-weight: 750;
  text-decoration: underline;
}

.submit-error button:hover {
  color: #542a27;
}

.submit-success {
  display: block;
  margin-top: 22px;
  border: 1px solid #bfeae0;
  background: #effcf7;
  color: #14715f;
  font-weight: 650;
}

/* Acciones del formulario */

.form-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 14px;
  margin-top: 25px;
  padding-top: 2px;
}

.cancel-action {
  display: inline-flex;
  min-height: 43px;
  align-items: center;
  justify-content: center;
  padding: 0 17px;
  border: 1px solid #dce5ec;
  border-radius: 9px;
  background: #ffffff;
  color: #496679;
  font-size: 12px;
  font-weight: 700;
  text-decoration: none;
  transition:
    background-color 0.18s ease,
    border-color 0.18s ease,
    color 0.18s ease;
}

.cancel-action:hover {
  border-color: #bdcfd9;
  background: #f7fafc;
  color: var(--color-text-primary);
}

.submit-action {
  display: inline-flex;
  min-height: 43px;
  align-items: center;
  justify-content: center;
  padding: 0 20px;
  border: 1px solid var(--color-brand-accent);
  border-radius: 9px;
  background: var(--color-brand-accent);
  color: var(--color-brand-dark);
  cursor: pointer;
  font-family: inherit;
  font-size: 12px;
  font-weight: 800;
  box-shadow: 0 4px 10px rgb(66 214 178 / 15%);
  transition:
    background-color 0.18s ease,
    border-color 0.18s ease,
    box-shadow 0.18s ease,
    transform 0.18s ease;
}

.submit-action:hover:not(:disabled) {
  border-color: #2cc5a1;
  background: #2cc5a1;
  box-shadow: 0 5px 14px rgb(66 214 178 / 22%);
  transform: translateY(-1px);
}

.submit-action:active:not(:disabled) {
  transform: translateY(0);
}

.submit-action:disabled {
  cursor: not-allowed;
  opacity: 0.6;
  box-shadow: none;
}

/* Accesibilidad */

.back-link:focus-visible,
.cancel-action:focus-visible,
.submit-action:focus-visible,
.submit-error button:focus-visible,
.navigation-link:focus-visible {
  outline: 3px solid rgb(66 214 178 / 45%);
  outline-offset: 3px;
}

input:focus-visible,
select:focus-visible,
textarea:focus-visible {
  outline: none;
}

/* Pantallas medianas */

@media (max-width: 1000px) {
  .product-create-page {
    padding-right: 24px;
    padding-left: 272px;
  }

  .product-create-card {
    padding: 25px;
  }
}

/* Móvil y tablet estrecha */

@media (max-width: 760px) {
  .sidebar {
    width: 72px;
    align-items: center;
    padding: 24px 9px 18px;
  }

  .brand {
    justify-content: center;
    margin: 0 0 40px;
  }

  .brand > span:last-child,
  .sidebar-caption,
  .navigation-link > span:not(.navigation-icon),
  .navigation-link > span:first-child:not(.navigation-icon) {
    display: none;
  }

  .seller-navigation {
    width: 100%;
  }

  .navigation-link {
    justify-content: center;
    gap: 0;
    padding: 0;
  }

  .navigation-link.is-active {
    box-shadow: inset 3px 0 var(--color-brand-accent);
  }

  .product-create-page {
    padding: 24px 18px 40px 90px;
  }

  .product-create-card {
    padding: 22px;
    border-radius: 13px;
  }

  .page-header {
    margin-bottom: 22px;
    padding-bottom: 22px;
  }

  .back-link {
    margin-bottom: 22px;
  }

  .page-header h1 {
    font-size: 27px;
  }

  .form-section {
    padding: 22px 0;
  }

  .section-heading {
    margin-bottom: 19px;
  }

  .form-grid {
    gap: 18px 14px;
  }
}

/* Móvil */

@media (max-width: 520px) {
  .product-create-page {
    padding: 16px 12px 28px 82px;
  }

  .product-create-card {
    padding: 18px;
    border-radius: 12px;
  }

  .page-header h1 {
    font-size: 24px;
  }

  .page-description {
    font-size: 12px;
  }

  .form-grid {
    grid-template-columns: minmax(0, 1fr);
    gap: 17px;
  }

  .full-width,
  .visibility-toggle {
    grid-column: 1;
  }

  .section-heading h2 {
    font-size: 15px;
  }

  .section-heading p {
    font-size: 11px;
  }

  .form-actions {
    flex-wrap: wrap;
    gap: 10px;
  }

  .cancel-action,
  .submit-action {
    flex: 1;
    padding-inline: 10px;
  }

  .image-preview {
    width: 145px;
    height: 145px;
  }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}
</file>

<file path="frontend/src/app/features/products/seller-catalog/seller-catalog.spec.ts">
import { ComponentFixture, TestBed } from '@angular/core/testing';
import { provideRouter } from '@angular/router';
import { Observable, of, throwError } from 'rxjs';
import { ProductDetails, ProductsService } from '../../../core/services/products.service';
import { SellerCatalogService, SellerProduct } from '../../../core/services/seller-catalog.service';
import { SellerCatalog } from './seller-catalog';

describe('SellerCatalog', () => {
  let fixture: ComponentFixture<SellerCatalog>;
  const products: SellerProduct[] = [{
    id: 'product-1',
    name: 'Auriculares',
    categoryIds: ['category-1'],
    stock: 3,
    description: 'Auriculares inalámbricos',
    price: 19.99,
    discount: null,
    premiumDiscount: null,
    imageUrl: 'https://example.com/headphones.jpg',
    available: true,
    sellerId: 'seller-1',
  }];
  let productsResponse: Observable<SellerProduct[]>;
  let categoriesResponse: Observable<{ id: string; name: string }[]>;
  let catalogService: {
    getProducts: () => Observable<SellerProduct[]>;
  };
  let updateProduct: ReturnType<typeof vi.fn<
    (id: string, request: Parameters<ProductsService['updateProduct']>[1]) => Observable<ProductDetails>
  >>;

  beforeEach(async () => {
    productsResponse = of(products);
    categoriesResponse = of([{ id: 'category-1', name: 'Audio' }]);
    catalogService = {
      getProducts: () => productsResponse,
    };
    updateProduct = vi.fn((id: string, request: Parameters<ProductsService['updateProduct']>[1]) =>
      of({
        ...products[0],
        id,
        name: request.name,
        categoryIds: request.categoryIds,
        stock: request.stock ?? products[0].stock,
        description: request.description ?? null,
        price: request.price,
        discount: request.discount ?? null,
        premiumDiscount: request.premiumDiscount ?? null,
        imageUrl: request.imageUrl ?? null,
        available: request.available,
        sellerId: products[0].sellerId,
      }));
    await TestBed.configureTestingModule({
      imports: [SellerCatalog],
      providers: [
        provideRouter([]),
        { provide: SellerCatalogService, useValue: catalogService },
        { provide: ProductsService, useValue: { getCategories: () => categoriesResponse, updateProduct } },
      ],
    }).compileComponents();

    fixture = TestBed.createComponent(SellerCatalog);
    await fixture.whenStable();
  });

  it('should create the seller catalog page', () => {
    expect(fixture.componentInstance).toBeTruthy();
  });

  it('should render the seller product catalog and category names', () => {
    const element = fixture.nativeElement as HTMLElement;

    expect(element.querySelector('h1')?.textContent?.trim()).toBe('Catálogo');
    expect(element.querySelector('[aria-label="Productos del catálogo"]')).not.toBeNull();
    expect(
      Array.from(
        element.querySelectorAll('.app-navigation .navigation-link'),
        (link) => link.querySelector('span:last-child')?.textContent?.trim(),
      ),
    ).toEqual([
      'Mi catálogo',
      'Mis pedidos',
      'Estadísticas',
      'Valoraciones',
    ]);
    expect(element.textContent).toContain('Auriculares');
    expect(element.querySelector('.stock-badge')?.textContent?.replace(/\s+/g, ' ').trim()).toBe('Stock bajo · 3');
    expect(element.textContent).toContain('Publicado');
    expect(element.querySelector('thead')?.textContent).toContain('Categoría');
    expect(element.textContent).toContain('Audio');
    expect(element.textContent).not.toContain('INVENTARIO');
    expect(element.querySelector('.product-table caption')?.textContent).toContain('Productos del catálogo');
    expect(element.querySelector('.catalog-controls .catalog-search')).not.toBeNull();
    expect(element.querySelector('.catalog-controls .product-count')?.textContent).toContain('1 producto');
    const filterButton = element.querySelector<HTMLButtonElement>('.catalog-filter-button');
    expect(filterButton?.textContent).toContain('Filtrar');
    expect(filterButton).not.toBeNull();
    expect(element.querySelector<HTMLImageElement>('.product-image')?.alt).toBe('');
    expect(element.querySelector('input[type="search"]')?.hasAttribute('aria-label')).toBe(false);
    expect(element.querySelectorAll('.navigation-link[aria-disabled="true"]')).toHaveLength(2);
    expect(element.querySelectorAll('.navigation-link[title="Próximamente"]')).toHaveLength(2);

    expect(element.querySelector<HTMLAnchorElement>('.edit-button')?.getAttribute('href'))
      .toBe('/products/product-1/edit');
    expect(element.querySelector('.delete-button')).toBeNull();
  });

  it('should show the quantity alone for normal stock and keep labels for exceptional stock', () => {
    const component = fixture.componentInstance;
    const normalStockProduct = { ...products[0], stock: 100 };
    component.products.set([normalStockProduct]);
    fixture.detectChanges();

    const element = fixture.nativeElement as HTMLElement;
    expect(element.querySelector('.stock-badge')?.textContent?.trim()).toBe('100');
    expect(element.textContent).not.toContain('En stock');

    component.products.set([{ ...products[0], stock: 0 }]);
    fixture.detectChanges();
    expect(element.querySelector('.stock-badge')?.textContent?.replace(/\s+/g, ' ').trim()).toBe('Sin stock · 0');
  });

  it('should update price inline and replace the product after saving', async () => {
    const component = fixture.componentInstance;
    const element = fixture.nativeElement as HTMLElement;
    const priceButton = element.querySelector<HTMLButtonElement>('.price-value');

    priceButton?.click();
    fixture.detectChanges();
    const input = element.querySelector<HTMLInputElement>('.price-input');
    expect(input).not.toBeNull();
    input!.value = '24.5';
    input!.dispatchEvent(new Event('input'));
    fixture.detectChanges();
    element.querySelector<HTMLButtonElement>('.inline-save')?.click();
    await fixture.whenStable();
    fixture.detectChanges();

    expect(updateProduct).toHaveBeenCalledWith('product-1', expect.objectContaining({
      price: 24.5,
      stock: 3,
      categoryIds: ['category-1'],
    }));
    expect(component.products()[0].price).toBe(24.5);
    expect(element.querySelector('.price-value')?.textContent).toContain('24,50');
  });

  it('should reject negative inline stock without calling the API', () => {
    const component = fixture.componentInstance;
    component.startInlineEdit(products[0], 'stock');
    component.inlineValue.set(-1);
    component.saveInlineEdit(products[0]);

    expect(updateProduct).not.toHaveBeenCalled();
    expect(component.inlineError()).toBe('El stock debe ser un número entero no negativo.');
  });

  it('should toggle product visibility without removing it from the catalog', async () => {
    const component = fixture.componentInstance;
    const element = fixture.nativeElement as HTMLElement;

    element.querySelector<HTMLButtonElement>('.editable-availability')?.click();
    await fixture.whenStable();
    fixture.detectChanges();

    expect(updateProduct).toHaveBeenCalledWith('product-1', expect.objectContaining({
      available: false,
      price: 19.99,
      stock: 3,
    }));
    expect(component.products()[0].available).toBe(false);
    expect(element.querySelector('.editable-availability')?.textContent).toContain('Oculto');
    expect(element.textContent).toContain('Auriculares');
  });

  it('should link to the product creation route', () => {
    const element = fixture.nativeElement as HTMLElement;
    const createLinks = element.querySelectorAll('a[href="/products/new"]');

    expect(createLinks.length).toBeGreaterThan(0);
  });

  it('should show an empty state when the seller has no products', async () => {
    fixture.destroy();
    productsResponse = of([]);

    fixture = TestBed.createComponent(SellerCatalog);
    fixture.detectChanges();
    await fixture.whenStable();

    expect((fixture.nativeElement as HTMLElement).textContent).toContain('Aún no tienes productos');
  });

  it('should show a retry option when the product list cannot be loaded', async () => {
    fixture.destroy();
    productsResponse = throwError(() => new Error('API unavailable'));

    fixture = TestBed.createComponent(SellerCatalog);
    fixture.detectChanges();
    await fixture.whenStable();

    const element = fixture.nativeElement as HTMLElement;
    expect(element.textContent).toContain('No se pudieron cargar tus productos');
    expect(element.querySelector('.catalog-error button')).not.toBeNull();
  });

  it('should show a retry option when category names cannot be loaded', async () => {
    fixture.destroy();
    categoriesResponse = throwError(() => new Error('API unavailable'));

    fixture = TestBed.createComponent(SellerCatalog);
    fixture.detectChanges();
    await fixture.whenStable();

    const element = fixture.nativeElement as HTMLElement;
    expect(element.textContent).toContain('No se pudieron cargar los nombres de las categorías');
    expect(element.textContent).toContain('No disponible');
  });
});
</file>

<file path="frontend/src/app/features/products/seller-orders/seller-orders.ts">
import { isPlatformBrowser } from '@angular/common';
import { Component, computed, inject, PLATFORM_ID, signal } from '@angular/core';
import { FormsModule } from '@angular/forms';
import { RouterLink, RouterLinkActive } from '@angular/router';

type OrderStatus = 'Pendiente' | 'En preparación' | 'Enviado' | 'Entregado' | 'Cancelado';

interface SellerOrderItem {
  name: string;
  quantity: number;
  price: number;
  imageUrl: string;
}

interface SellerOrder {
  id: string;
  date: string;
  dateValue: string;
  customer: string;
  products: string;
  total: number;
