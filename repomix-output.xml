<file path="frontend/src/app/app.html">
<header class="app-header">
  <a class="app-brand" routerLink="/">
    <span class="brand-text">ESI<span class="brand-accent">Buy</span></span>
  </a>
  @if (authService.currentUser(); as user) {
  <div class="app-session">
    @if (user.role === 'CLIENT') {
      <a routerLink="/client/catalog" class="session-nav-button" role="button" (click)="closeProfileMenu()">Catálogo</a>
    } @else if (user.role === 'SELLER') {
      <a routerLink="/seller/catalog" class="session-nav-button" role="button" (click)="closeProfileMenu()">Catálogo</a>
    } @else if (user.role === 'ADMIN') {
      <a routerLink="/admin/usuarios" class="session-nav-button" role="button" (click)="closeProfileMenu()">Gestión Usuarios</a>
    }

    @if (user.role === 'CLIENT') {
    <a class="header-cart" routerLink="/client/cart" [attr.aria-label]="'Carrito, ' + cartService.itemCount() + ' artículos'">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
        stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="9" cy="21" r="1" />
        <circle cx="20" cy="21" r="1" />
        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" />
      </svg>
      <span>Carrito</span>
      <span class="header-cart-count">{{ cartService.itemCount() }}</span>
    </a>
    }
    <div class="go-profile">
      <button type="button" class="profile-button" (click)="toggleProfileMenu(); $event.stopPropagation()"
        title="Perfil" aria-haspopup="menu" [attr.aria-expanded]="profileMenuOpen()" aria-controls="profile-menu">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
          stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="8" r="3.5" />
          <path d="M4.5 20a7.5 7.5 0 0 1 15 0" />
        </svg>
        <svg class="profile-chevron" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m4 6 4 4 4-4" />
        </svg>
        <span class="visually-hidden">Perfil</span>
      </button>
      @if (profileMenuOpen()) {
      <div id="profile-menu" class="profile-menu" aria-label="Opciones de cuenta" (click)="$event.stopPropagation()"
        (keydown)="$event.stopPropagation()">
        <p class="profile-menu-email">{{ user.email }}</p>
        @if (user.role === 'CLIENT') {
          <button type="button" class="profile-menu-item" (click)="goClientCatalog()">
            Catálogo
          </button>
        } @else if (user.role === 'SELLER') {
          <button type="button" class="profile-menu-item" (click)="goCatalog()">
            Catálogo
          </button>
        } @else if (user.role === 'ADMIN') {
          <button type="button" class="profile-menu-item" (click)="goUsersManagement()">
            Gestión Usuarios
          </button>
        }
        <button type="button" class="profile-menu-item" (click)="goToProfile()">
          Perfil
        </button>
        <button type="button" class="profile-menu-item" (click)="logout()">
          Cerrar sesión
        </button>
      </div>
      }
    </div>
  </div>
  } @else {
  <div class="app-auth-nav">
    <a routerLink="/login" class="auth-nav-link">Iniciar sesión</a>
    <a routerLink="/register" class="auth-nav-button">Registrarse</a>
  </div>
  }
</header>

@if (logoutError(); as error) {
<p class="logout-error" role="alert">{{ error }}</p>
}

@if (toastService.toast(); as t) {
<div class="app-toast" [class.is-success]="t.type === 'success'" [class.is-error]="t.type === 'error'" [class.is-info]="t.type === 'info'" role="status" aria-live="polite">
  <span>{{ t.text }}</span>
  <button type="button" class="toast-close" (click)="toastService.clear()" aria-label="Cerrar notificación">×</button>
</div>
}

