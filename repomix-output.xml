    const mockProfile = {
        firstName: 'Ana',
        lastName: 'García',
        email: 'ana@esibuy.com',
        phone: '600123456',
        maskedNationalId: '***4567*',
        profileImage: 'assets/images/avatars/av_client_1.jpeg',
        customerType: 'STANDARD',
        birthDate: '1990-01-01',
        totpEnabled: false,
    };

    beforeEach(async () => {
