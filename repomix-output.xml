  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
  transition: background 0.15s;
}

.reset-filter-btn:hover {
  background: #f0fdfa;
}

/* RESULTADOS */
.results-header {
  margin-bottom: 16px;
}

.product-count {
  font-size: 13px;
  font-weight: 700;
  color: #64748b;
}

.catalog-message,
.catalog-error,
.empty-state {
  background: #ffffff;
  border-radius: 12px;
  padding: 56px 24px;
  text-align: center;
  box-shadow: 0 2px 6px rgba(16, 44, 64, 0.04);
}

.spinner {
  width: 32px;
  height: 32px;
  margin: 0 auto 12px;
  border: 3px solid #e2e8f0;
  border-top-color: #42d6b2;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.empty-icon {
  font-size: 40px;
  color: #94a3b8;
  display: block;
  margin-bottom: 10px;
}

.empty-state h3 {
  margin: 0 0 6px;
  color: #102c40;
  font-size: 18px;
}

.empty-state p {
  margin: 0 0 16px;
  color: #64748b;
  font-size: 14px;
}

.secondary-action {
  padding: 8px 16px;
  background: #102c40;
  color: #ffffff;
  border: none;
  border-radius: 8px;
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  text-decoration: none;
}

/* CUADRÍCULA DE PRODUCTOS */
.product-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  gap: 24px;
}

.product-card {
  background: #ffffff;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 2px 6px rgba(16, 44, 64, 0.05);
  display: flex;
  flex-direction: column;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
  cursor: pointer;
  text-decoration: none;
  color: inherit;
}

.product-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 8px 20px rgba(16, 44, 64, 0.12);
}

.product-image-container {
  position: relative;
  width: 100%;
  aspect-ratio: 4 / 3;
  background: #f1f5f9;
  display: grid;
  place-items: center;
  overflow: hidden;
}

.product-card-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.product-img-fallback {
  font-size: 36px;
  color: #cbd5e1;
}

.rating-tag {
  position: absolute;
  top: 10px;
  left: 10px;
  background: rgba(16, 44, 64, 0.85);
  backdrop-filter: blur(4px);
  color: #facc15;
  font-size: 11px;
  font-weight: 750;
  padding: 3px 8px;
  border-radius: 6px;
  z-index: 2;
}

/* CORAZÓN CENTRADO EN HOVER */
.heart-center-button {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) scale(0.85);
  z-index: 5;
  width: 48px;
  height: 48px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 0 6px 16px rgba(0, 0, 0, 0.18);
  border: none;
  display: grid;
  place-items: center;
  cursor: pointer;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.2s ease, transform 0.2s ease, background 0.15s;
}

.heart-svg {
  width: 24px;
  height: 24px;
  fill: transparent;
  stroke: #475569;
  stroke-width: 2;
  transition: stroke 0.15s, fill 0.15s;
}

.product-card:hover .heart-center-button,
.product-image-container:hover .heart-center-button {
  opacity: 1;
  pointer-events: auto;
  transform: translate(-50%, -50%) scale(1);
}

.heart-center-button:hover {
  background: #ffffff;
  transform: translate(-50%, -50%) scale(1.1);
}

.heart-center-button:hover .heart-svg {
  stroke: #e11d48;
}

.heart-center-button.is-favorite .heart-svg {
  fill: #e11d48;
  stroke: #e11d48;
}

.heart-center-button.is-favorite {
  opacity: 0.9;
  pointer-events: auto;
}

.product-card-body {
  padding: 16px;
  display: flex;
  flex-direction: column;
  flex: 1;
}

.product-card-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 4px;
  margin-bottom: 8px;
}

.tag-badge {
  background: #f1f5f9;
  color: #475569;
  font-size: 11px;
  font-weight: 600;
  padding: 2px 7px;
  border-radius: 4px;
}

.product-card-title {
  margin: 0 0 6px;
  font-size: 16px;
  font-weight: 750;
  color: #102c40;
  line-height: 1.3;
}

.product-card-desc {
  margin: 0 0 14px;
  font-size: 13px;
  color: #64748b;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.product-card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: auto;
  padding-top: 12px;
  border-top: 1px solid #f1f5f9;
}

.price-stock-wrap {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.product-card-price {
  font-size: 18px;
  font-weight: 850;
  color: #102c40;
}

.stock-pill {
  font-size: 11px;
  font-weight: 700;
  color: #0d9488;
}

.stock-pill.stock-low {
  color: #d97706;
}

.stock-pill.stock-empty {
  color: #dc2626;
}

.view-detail-btn {
  font-size: 12px;
  font-weight: 700;
  color: #0d9488;
}

.product-card:hover .view-detail-btn {
  text-decoration: underline;
}

.card-btn-group {
  display: flex;
  align-items: center;
  gap: 10px;
}

.add-to-cart-action-btn {
  background: #0d9488;
  color: #ffffff;
  border: none;
  border-radius: 6px;
  padding: 6px 12px;
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
  transition: background 0.15s ease, transform 0.1s;
}

.add-to-cart-action-btn:hover:not(:disabled) {
  background: #0f766e;
  transform: translateY(-1px);
}

.add-to-cart-action-btn:disabled {
  background: #cbd5e1;
  color: #94a3b8;
  cursor: not-allowed;
}

.primary-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  background: #42d6b2;
  color: #102c40;
  padding: 0.45rem 1rem;
  border-radius: 6px;
  text-decoration: none;
  font-size: 0.88rem;
  font-weight: 650;
  white-space: nowrap;
  transition: background 0.15s ease, transform 0.15s ease;
}

.primary-action:hover {
  background: #36c4a1;
  transform: translateY(-1px);
}

.cart-btn-icon {
  width: 1.15rem;
  height: 1.15rem;
}

.cart-count {
  background: #102c40;
  color: #ffffff;
  padding: 2px 7px;
  border-radius: 999px;
  font-size: 11px;
  font-weight: 700;
}

.visually-hidden {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  border: 0;
}

@media (max-width: 768px) {
  .sidebar {
    position: static;
    width: 100%;
    padding: 16px 20px;
  }
  .workspace {
    margin-left: 0;
    padding: 20px;
  }
  .filter-controls-row {
    flex-direction: column;
    align-items: stretch;
  }
  .filter-control select {
    min-width: 100%;
  }
}
</file>

<file path="frontend/src/app/features/client/client-catalog/client-catalog.html">
<div class="seller-layout seller-shell" [class.app-sidebar-collapsed]="sidebarCollapsed()">
  <aside class="sidebar app-sidebar" aria-label="Panel del cliente">
    <button type="button" class="app-sidebar-toggle" (click)="toggleSidebar()"
      aria-label="Ocultar barra lateral"><span aria-hidden="true">‹</span></button>
    <a class="brand" routerLink="/" aria-label="ESIBuy">
      <span class="brand-mark" aria-hidden="true">E</span>
      <span>ESI<span class="brand-accent">Buy</span></span>
    </a>

    <div class="sidebar-caption">ÁREA DE CLIENTE</div>
    <nav class="seller-navigation" aria-label="Navegación del cliente">
      <a class="navigation-link is-active" routerLink="/client/catalog" aria-current="page">
        <svg class="navigation-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z" />
          <path d="M3 6h18" />
          <path d="M16 10a4 4 0 0 1-8 0" />
        </svg>
        <span>Catálogo</span>
      </a>

      <a class="navigation-link" routerLink="/client/wishlist">
        <svg class="navigation-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path
            d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z" />
        </svg>
        <span>Lista de deseos</span>
      </a>

      <a class="navigation-link" routerLink="/client/orders">
        <svg class="navigation-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="9" cy="21" r="1" />
          <circle cx="20" cy="21" r="1" />
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" />
        </svg>
        <span>Mis compras</span>
      </a>

      <a class="navigation-link" routerLink="/client/cart">
        <svg class="navigation-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="9" cy="21" r="1" />
          <circle cx="20" cy="21" r="1" />
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" />
        </svg>
        <span>Carrito</span>
      </a>

      <a class="navigation-link" routerLink="/client/profile">
        <svg class="navigation-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" />
          <circle cx="12" cy="7" r="4" />
        </svg>
        <span>Perfil</span>
      </a>
    </nav>
  </aside>

  <button type="button" class="app-sidebar-toggle-open" (click)="toggleSidebar()"
    aria-label="Mostrar barra lateral" [hidden]="!sidebarCollapsed()"><span aria-hidden="true">›</span></button>

  <div class="workspace app-workspace">
    <main class="catalog-content">
      <section class="page-heading" aria-labelledby="catalog-title">
        <div>
          <h1 id="catalog-title">Catálogo de productos</h1>
          <p class="page-description">Explora la oferta de ESIBuy, encuentra lo que buscas y guarda tus favoritos.</p>
        </div>
        <a class="primary-action" routerLink="/client/cart">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
            stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="cart-btn-icon">
            <circle cx="9" cy="21" r="1" />
            <circle cx="20" cy="21" r="1" />
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" />
          </svg>
          <span>Ver carrito</span> <span class="cart-count">({{ cartService.itemCount() }})</span>
        </a>
      </section>

      <!-- BARRA DE FILTROS COMBINABLES CON RECUADRO NOTABLE -->
      <section class="filter-bar" aria-label="Filtros del catálogo">
        <div class="filter-group search-group">
          <label for="catalog-search" class="visually-hidden">Buscar producto</label>
          <div class="search-input-wrapper">
            <svg class="search-icon" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="2"></circle>
              <path d="m16 16 4.5 4.5" fill="none" stroke="currentColor" stroke-width="2"></path>
            </svg>
            <input id="catalog-search" type="search" placeholder="Buscar por nombre o palabra clave..."
              [ngModel]="searchQuery()" (ngModelChange)="searchQuery.set($event); onFilterChange()" />
          </div>
        </div>

        <div class="filter-controls-row">
          <div class="filter-control">
            <label for="filter-category" class="filter-label">Categoría</label>
            <select id="filter-category" [ngModel]="selectedCategory()" (ngModelChange)="selectedCategory.set($event); onFilterChange()">
              <option value="">Todas las categorías</option>
              @for (cat of categories(); track cat.id) {
                <option [value]="cat.id">{{ cat.name }}</option>
              }
            </select>
          </div>

          <div class="filter-control price-control">
            <span class="filter-label">Precio (€)</span>
            <div class="price-inputs">
              <input type="number" min="0" placeholder="Mín" [ngModel]="minPrice()"
                (ngModelChange)="minPrice.set($event); onFilterChange()" aria-label="Precio mínimo" />
              <span class="price-sep">-</span>
              <input type="number" min="0" placeholder="Máx" [ngModel]="maxPrice()"
                (ngModelChange)="maxPrice.set($event); onFilterChange()" aria-label="Precio máximo" />
            </div>
          </div>

          <div class="filter-control">
            <label for="filter-rating" class="filter-label">Valoración mínima</label>
            <select id="filter-rating" [ngModel]="minRating()" (ngModelChange)="minRating.set($event); onFilterChange()">
              <option [ngValue]="null">Cualquier valoración</option>
              <option [ngValue]="4">4 estrellas o más (★★★★☆)</option>
              <option [ngValue]="3">3 estrellas o más (★★★☆☆)</option>
              <option [ngValue]="2">2 estrellas o más (★★☆☆☆)</option>
              <option [ngValue]="1">1 estrella o más (★☆☆☆☆)</option>
            </select>
          </div>

          <div class="filter-control checkbox-control">
            <label class="checkbox-label">
              <input type="checkbox" [ngModel]="onlyInStock()" (ngModelChange)="onlyInStock.set($event); onFilterChange()" />
              <span>Solo en stock</span>
            </label>
          </div>

          <button type="button" class="reset-filter-btn" (click)="resetFilters()" title="Limpiar todos los filtros">
            Limpiar filtros
          </button>
        </div>
      </section>

      <!-- RESULTADOS -->
      <section class="products-region" aria-label="Listado de productos">
        <div class="results-header">
          @if (!loading() && !error()) {
            <span class="product-count">{{ products().length }} productos disponibles</span>
          }
        </div>

        @if (loading()) {
          <div class="catalog-message">
            <div class="spinner"></div>
            <span>Cargando productos…</span>
          </div>
        } @else if (error()) {
          <div class="catalog-error" role="alert">
            <span>No se pudieron cargar los productos. Inténtalo de nuevo.</span>
            <button type="button" (click)="loadProducts()">Reintentar</button>
          </div>
        } @else if (products().length === 0) {
          <div class="empty-state">
            <span class="empty-icon" aria-hidden="true">⌕</span>
            <h3>No se encontraron productos</h3>
            <p>Prueba a modificar los filtros o los términos de búsqueda.</p>
            <button type="button" class="secondary-action" (click)="resetFilters()">Restablecer filtros</button>
          </div>
        } @else {
          <div class="product-grid">
            @for (product of products(); track product.id) {
              <article class="product-card" [routerLink]="['/products', product.id]">
                <div class="product-image-container">
                  @if (product.imageUrl) {
                    <img class="product-card-img" [src]="product.imageUrl" [alt]="product.name" loading="lazy" />
                  } @else {
                    <div class="product-img-fallback" aria-hidden="true">▦</div>
                  }

                  <!-- CORAZÓN CENTRADO AL HACER HOVER -->
                  <button type="button" class="heart-center-button"
                    [class.is-favorite]="wishlistService.isFavorite(product.id)"
                    (click)="toggleFavorite(product.id, $event)"
                    [attr.aria-label]="wishlistService.isFavorite(product.id) ? 'Quitar de la lista de deseos' : 'Añadir a la lista de deseos'"
                    [title]="wishlistService.isFavorite(product.id) ? 'En tu lista de deseos' : 'Guardar en lista de deseos'">
                    <svg viewBox="0 0 24 24" class="heart-svg" aria-hidden="true">
                      <path
                        d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" />
                    </svg>
                  </button>

                  <span class="rating-tag">★ {{ (product.rating ?? 5.0).toFixed(1) }}</span>
                </div>

                <div class="product-card-body">
                  <div class="product-card-tags">
                    @for (catId of product.categoryIds; track catId) {
                      <span class="tag-badge">{{ categoryName(catId) }}</span>
                    }
                  </div>

                  <h3 class="product-card-title">{{ product.name }}</h3>
                  <p class="product-card-desc">{{ product.description || 'Sin descripción' }}</p>

                  
                  <span class="view-detail-btn">Ver detalle →</span>
                  
                  <div class="product-card-footer">
                    <div class="price-stock-wrap">
                      <span class="product-card-price">{{ formatPrice(product.price) }}</span>
                      <span class="stock-pill" [class.stock-empty]="product.stock === 0" [class.stock-low]="stockStatus(product.stock) === 'Stock bajo'">
                        {{ stockStatus(product.stock) }}
                      </span>
                    </div>

                    <div class="card-btn-group">
                      <button type="button" class="add-to-cart-action-btn"
                        [disabled]="product.stock === 0"
                        (click)="addToCart(product, $event)">
                        Añadir al carrito
                      </button>
                    </div>
                  </div>
                </div>
              </article>
            }
          </div>
        }
      </section>
    </main>
  </div>
</div>
</file>

<file path="frontend/src/app/features/client/client-catalog/client-catalog.spec.ts">
import { ComponentFixture, TestBed } from '@angular/core/testing';
import { provideRouter } from '@angular/router';
import { of } from 'rxjs';
import { describe, beforeEach, it, expect, vi } from 'vitest';
import { ClientCatalog } from './client-catalog';
import { ProductsService, ProductItem, Category } from '../../products/products.service';
import { WishlistService } from '../../../core/services/wishlist.service';
import { ToastService } from '../../../core/services/toast.service';
import { CartService } from '../cart/cart.service';

describe('ClientCatalog', () => {
  let component: ClientCatalog;
  let fixture: ComponentFixture<ClientCatalog>;
  let productsServiceMock: any;
  let wishlistServiceMock: any;
  let toastServiceMock: any;
  let cartServiceMock: any;

  const mockCategories: Category[] = [
    { id: 'cat-1', name: 'Electrónica' },
    { id: 'cat-2', name: 'Hogar' },
  ];

  const mockProducts: ProductItem[] = [
    {
      id: 'p-1',
      name: 'Auriculares Bluetooth',
      categoryIds: ['cat-1'],
      stock: 10,
      description: 'Gran calidad de sonido',
      price: 29.99,
      available: true,
      sellerId: 's-1',
      rating: 4.8,
    },
    {
      id: 'p-2',
      name: 'Cafetera Express',
      categoryIds: ['cat-2'],
      stock: 2,
      description: 'Café rápido',
      price: 89.99,
      available: true,
      sellerId: 's-2',
      rating: 4.5,
    },
  ];

  beforeEach(async () => {
    productsServiceMock = {
      getCategories: vi.fn(() => of(mockCategories)),
      getPublicCatalog: vi.fn(() => of(mockProducts)),
    };

    wishlistServiceMock = {
      refreshIfClient: vi.fn(),
      isFavorite: vi.fn((id: string) => id === 'p-1'),
      toggleWishlist: vi.fn(() => of({ message: 'Lista actualizada', inWishlist: true })),
    };

    toastServiceMock = {
      show: vi.fn(),
    };

    cartServiceMock = {
      itemCount: vi.fn(() => 2),
      addItem: vi.fn(() => of({})),
    };

    await TestBed.configureTestingModule({
      imports: [ClientCatalog],
      providers: [
        provideRouter([]),
        { provide: ProductsService, useValue: productsServiceMock },
        { provide: WishlistService, useValue: wishlistServiceMock },
        { provide: ToastService, useValue: toastServiceMock },
        { provide: CartService, useValue: cartServiceMock },
      ],
    }).compileComponents();

    fixture = TestBed.createComponent(ClientCatalog);
    component = fixture.componentInstance;
    fixture.detectChanges();
    await fixture.whenStable();
  });

  it('should create and render heading and navigation links in exact order', () => {
    expect(component).toBeTruthy();
    const el: HTMLElement = fixture.nativeElement;

    expect(el.querySelector('#catalog-title')?.textContent).toContain('Catálogo de productos');
    expect(el.querySelector('.primary-action')?.textContent).toContain('Ver carrito');

    const navLinks = Array.from(el.querySelectorAll('.navigation-link'));
    expect(navLinks.length).toBe(5);
    expect(navLinks[0].textContent).toContain('Catálogo');
    expect(navLinks[0].classList.contains('is-active')).toBe(true);
    expect(navLinks[1].textContent).toContain('Lista de deseos');
    expect(navLinks[2].textContent).toContain('Mis compras');
    expect(navLinks[3].textContent).toContain('Carrito');
    expect(navLinks[4].textContent).toContain('Perfil');
  });

  it('should toggle sidebar collapsed state', () => {
    expect(component.sidebarCollapsed()).toBe(false);
    component.toggleSidebar();
    expect(component.sidebarCollapsed()).toBe(true);
  });

  it('should add product to cart and show toast', () => {
    const el: HTMLElement = fixture.nativeElement;
    const addBtn = el.querySelector('.add-to-cart-action-btn') as HTMLButtonElement;
    expect(addBtn).not.toBeNull();
    addBtn?.click();

    expect(cartServiceMock.addItem).toHaveBeenCalledWith('p-1', 1);
    expect(toastServiceMock.show).toHaveBeenCalledWith('Producto añadido al carrito', 'success');
  });

  it('should render products and allow toggling favorite with feedback', () => {
    fixture.detectChanges();
    const el: HTMLElement = fixture.nativeElement;

    const cards = el.querySelectorAll('.product-card');
    expect(cards.length).toBe(2);

    const firstTitle = cards[0].querySelector('.product-card-title')?.textContent;
    expect(firstTitle).toContain('Auriculares Bluetooth');

    // Click heart on first product
    const heartBtn = cards[0].querySelector('.heart-center-button') as HTMLButtonElement;
    expect(heartBtn).not.toBeNull();
    heartBtn?.click();

    expect(wishlistServiceMock.toggleWishlist).toHaveBeenCalledWith('p-1');
    expect(toastServiceMock.show).toHaveBeenCalledWith('Lista actualizada', 'success');
  });

  it('should reload products when filters change', () => {
    component.searchQuery.set('Cafetera');
    component.onFilterChange();

    expect(productsServiceMock.getPublicCatalog).toHaveBeenCalledWith(
      expect.objectContaining({ query: 'Cafetera' })
    );
  });
});
