<div class="admin-layout seller-shell" [class.app-sidebar-collapsed]="sidebarCollapsed()">
    <aside class="admin-sidebar admin-sidebar--shared app-sidebar" aria-label="Panel de administración">
        <button type="button" class="app-sidebar-toggle" (click)="toggleSidebar()" aria-label="Ocultar barra lateral">
            <span aria-hidden="true">‹</span>
        </button>

        <a routerLink="/" class="admin-brand back-home-button" aria-label="ESIBuy">
            <span class="brand-mark" aria-hidden="true">E</span>
            <span>ESI<span class="brand-accent">Buy</span></span>
        </a>

        <p class="sidebar-caption">GESTIÓN DE ADMINISTRACIÓN</p>

        <nav class="admin-navigation" aria-label="Navegación de administración">
            <a class="navigation-link" routerLink="/admin/usuarios" routerLinkActive="is-active"
                [routerLinkActiveOptions]="{ exact: true }" ariaCurrentWhenActive="page">
                <svg class="navigation-icon" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M16 20v-1.5a4.5 4.5 0 0 0-4.5-4.5h-3A4.5 4.5 0 0 0 4 18.5V20"></path>
                    <circle cx="10" cy="7" r="3"></circle>
                    <path d="M16 11a3 3 0 1 0 0-6"></path>
                    <path d="M16 14h1a4 4 0 0 1 4 4v2"></path>
                </svg>
                <span>Usuarios</span>
            </a>

            <a class="navigation-link" routerLink="/admin/altas" routerLinkActive="is-active"
                [routerLinkActiveOptions]="{ exact: true }" ariaCurrentWhenActive="page">
                <span class="navigation-icon text-icon" aria-hidden="true">＋</span>
                <span>Dar de alta Administrador</span>
            </a>

            <a class="navigation-link" routerLink="/admin/categorias" routerLinkActive="is-active"
                [routerLinkActiveOptions]="{ exact: true }" ariaCurrentWhenActive="page">
                <svg class="navigation-icon" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M20 13 11 22l-9-9V2h11l9 9a1.4 1.4 0 0 1-2 2Z"></path>
                    <circle cx="7" cy="7" r="1.2"></circle>
                </svg>
                <span>Categorías</span>
            </a>
        </nav>
    </aside>

    <button type="button" class="app-sidebar-toggle-open" (click)="toggleSidebar()" aria-label="Mostrar barra lateral"
        [hidden]="!sidebarCollapsed()">
        <span aria-hidden="true">›</span>
    </button>

    <div class="admin-workspace app-workspace">
        <main class="admin-content">
            <div class="users-main-card">

                <section class="page-heading" aria-labelledby="admin-title">
                    <div class="page-heading-copy">
                        <p class="eyebrow">PANEL DE ADMINISTRACIÓN</p>
                        <h1 id="admin-title">Gestión de usuarios</h1>
                        <p class="page-description">
                            Administra las cuentas registradas y controla su acceso a ESIBuy.
                        </p>
                    </div>

                    <a routerLink="/admin/altas" class="primary-action" id="btnDarAltaAdmin">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M12 4v16m8-8H4"></path>
                        </svg>
                        <span>Dar de alta Administrador</span>
                    </a>
                </section>

                @if (successMessage()) {
                <output class="success-alert" aria-live="polite">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="m5 12 4 4L19 6"></path>
                    </svg>
                    <span>{{ successMessage() }}</span>
                </output>
                }

                <section class="filters-bar" aria-label="Filtros de usuarios">
                    <label class="search-field">
                        <span class="visually-hidden">Buscar usuario por nombre</span>
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <circle cx="11" cy="11" r="6.5"></circle>
                            <path d="m16 16 4.5 4.5"></path>
                        </svg>
                        <input type="search" [ngModel]="nameSearch()" (ngModelChange)="nameSearch.set($event)"
                            placeholder="Buscar por nombre..." aria-label="Buscar usuario por nombre">
                    </label>

                    <div class="filter-controls">
                        <label class="visually-hidden" for="filter-role">Filtrar por rol</label>
                        <select id="filter-role" [(ngModel)]="roleFilter" (change)="applyFilters()">
                            <option value="">Todos los roles</option>
                            <option value="CLIENTE">Clientes</option>
                            <option value="VENDEDOR">Vendedores</option>
                            <option value="ADMIN">Administradores</option>
                        </select>

                        <label class="visually-hidden" for="filter-status">Filtrar por estado</label>
                        <select id="filter-status" [(ngModel)]="statusFilter" (change)="applyFilters()">
                            <option value="">Cualquier estado</option>
                            <option value="activo">Activos</option>
                            <option value="inactivo">Inactivos</option>
                            <option value="bloqueado">Bloqueados</option>
                        </select>
                    </div>
                </section>

                @if (loading()) {
                <output class="loading-spinner" aria-live="polite">
                    <span class="spinner" aria-hidden="true"></span>
                    <p>Cargando información de usuarios...</p>
                </output>
                }

                @if (error()) {
                <div class="error-alert" role="alert">
                    <strong>⚠️ Error:</strong> {{ error() }}
                </div>
                }

                @if (!loading() && !error()) {
                <div class="table-container">
                    <table class="user-table">
                        <thead>
                            <tr>
                                <th class="col-user" scope="col">Usuario</th>
                                <th class="col-contact" scope="col">Contacto</th>
                                <th class="col-role" scope="col">Rol</th>
                                <th class="col-status" scope="col">Estado</th>
                                <th class="col-date" scope="col">Registro</th>
                                <th class="col-actions" scope="col">Acciones</th>
                            </tr>
                        </thead>

                        <tbody>
                            @for (user of filteredUsers(); track user.email) {
                            <tr>
                                <td class="col-user">
                                    <div class="user-cell-wrapper">
                                        <img [src]="getAvatarUrl(user.profileImage)" alt="" class="avatar-img">

                                        <div class="user-info">
                                            <span class="user-name" [title]="user.firstName + ' ' + user.lastName">
                                                {{ user.firstName }} {{ user.lastName }}
                                            </span>

                                            <span class="user-id">
                                                DNI: {{ user.nationalId || 'N/A' }}
                                            </span>

                                            @if (
                                            user.role === 'SELLER' &&
                                            (user.sellerProfile?.headquarters ||
                                            user.sellerProfile?.businessName)
                                            ) {
                                            <span class="user-site" [title]="user.sellerProfile?.headquarters ||
                                                                user.sellerProfile?.businessName">
                                                Sede: {{ user.sellerProfile?.headquarters ||
                                                user.sellerProfile?.businessName }}
                                            </span>
                                            }
                                        </div>
                                    </div>
                                </td>

                                <td class="col-contact">
                                    <div class="contact-item email-text" [title]="user.email">
                                        {{ user.email }}
                                    </div>

                                    <div class="contact-item text-muted phone-text">
                                        <svg class="phone-icon" viewBox="0 0 24 24" aria-hidden="true">
                                            <path
                                                d="M7.5 3.5h2l1.2 4.2-1.8 1.8a14.7 14.7 0 0 0 5.6 5.6l1.8-1.8 4.2 1.2v2c0 1.1-.9 2-2 2C11.6 18.5 5.5 12.4 5.5 5.5c0-1.1.9-2 2-2Z">
                                            </path>
                                        </svg>
                                        <span>{{ user.phone || 'Sin teléfono' }}</span>
                                    </div>
                                </td>

                                <td class="col-role">
                                    <span class="badge" [ngClass]="getRoleBadgeClass(user.role)">
                                        {{ user.role || 'DESCONOCIDO' }}
                                    </span>

                                    @if (user.role === 'ADMIN' && user.adminProfile?.headquarters) {
                                    <div class="text-muted sede-text" [title]="user.adminProfile.headquarters">
                                        <svg class="location-icon" viewBox="0 0 24 24" aria-hidden="true">
                                            <path d="M12 21s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12Z"></path>
                                            <circle cx="12" cy="9" r="2.5"></circle>
                                        </svg>
                                        <span>{{ user.adminProfile.headquarters }}</span>
                                    </div>
                                    }
                                </td>

                                <td class="col-status">
                                    @if (getUserStatus(user) === 'bloqueado') {
                                    <div class="status-indicator blocked-status">
                                        <span class="status-dot blocked"></span>
                                        <span>Bloqueado</span>
                                    </div>
                                    } @else {
                                    <button type="button" class="status-indicator status-clickable"
                                        [class.status-active]="getUserStatus(user) === 'activo'"
                                        [class.status-inactive]="getUserStatus(user) === 'inactivo'" [disabled]="!canChangeStatus(user) ||
                                                        updatingStatus() === user.id" (click)="changeUserStatus(
                                                        user,
                                                        getUserStatus(user) === 'activo' ? 'desactivar' : 'activar'
                                                    )" [attr.aria-label]="getUserStatus(user) === 'activo'
                                                        ? 'Desactivar usuario ' + user.firstName + ' ' + user.lastName
                                                        : 'Activar usuario ' + user.firstName + ' ' + user.lastName">
                                        <span class="status-dot" [ngClass]="getStatusClass(user)"></span>
                                        <span>{{ getStatusText(user) }}</span>
                                    </button>
                                    }
                                </td>

                                <td class="col-date text-muted">
                                    {{ user.createdAt | date:'dd/MM/yyyy' }}
                                </td>

                                <td class="col-actions">
                                    <div class="actions-wrapper">
                                        <button class="btn-icon btn-edit" type="button" title="Modificar usuario"
                                            [routerLink]="['/admin/usuarios', user.id, 'editar']" [attr.aria-label]="'Modificar usuario ' +
                                                        user.firstName + ' ' + user.lastName">
                                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                                <path d="M12 20h9"></path>
                                                <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"></path>
                                            </svg>
                                        </button>

                                        @if (getUserStatus(user) !== 'bloqueado') {
                                        <button class="btn-icon btn-lock" type="button" [disabled]="!canChangeStatus(user) ||
                                                            updatingStatus() === user.id"
                                            (click)="changeUserStatus(user, 'bloquear')" [title]="canChangeStatus(user)
                                                            ? 'Bloquear usuario'
                                                            : 'No puedes cambiar tu propia cuenta'" [attr.aria-label]="'Bloquear usuario ' +
                                                            user.firstName + ' ' + user.lastName">
                                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                                <rect x="5" y="10" width="14" height="10" rx="2"></rect>
                                                <path d="M8 10V7a4 4 0 0 1 8 0v3"></path>
                                            </svg>
                                        </button>
                                        } @else {
                                        <button class="btn-icon btn-lock is-blocked" type="button" [disabled]="!canChangeStatus(user) ||
                                                            updatingStatus() === user.id"
                                            (click)="changeUserStatus(user, 'desbloquear')" [title]="canChangeStatus(user)
                                                            ? 'Desbloquear usuario'
                                                            : 'No puedes cambiar tu propia cuenta'" [attr.aria-label]="'Desbloquear usuario ' +
                                                            user.firstName + ' ' + user.lastName">
                                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                                <rect x="5" y="10" width="14" height="10" rx="2"></rect>
                                                <path d="M16 10V7a4 4 0 0 0-7.5-1.8"></path>
                                            </svg>
                                        </button>
                                        }

                                        @if (user.role === 'ADMIN') {
                                        <button class="btn-icon btn-delete" type="button" [disabled]="!canDelete(user)"
                                            (click)="openConfirmation(user)" [title]="canDelete(user)
                                                            ? 'Eliminar administrador'
                                                            : 'No puedes eliminar tu propia cuenta'" [attr.aria-label]="'Eliminar administrador ' +
                                                            user.firstName + ' ' + user.lastName">
                                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                                <path d="M3 6h18"></path>
                                                <path d="M8 6V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2"></path>
                                                <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path>
                                                <path d="M10 11v6M14 11v6"></path>
                                            </svg>
                                        </button>
                                        } @else {
                                        <span class="action-spacer" aria-hidden="true"></span>
                                        }
                                    </div>
                                </td>
                            </tr>
                            } @empty {
                            <tr>
                                <td colspan="6">
                                    <div class="empty-state">
                                        <span class="empty-state-mark" aria-hidden="true">⌕</span>
                                        <p>No se encontraron usuarios con los criterios indicados.</p>
                                        <span>Prueba a cambiar los filtros o el término de búsqueda.</span>
                                    </div>
                                </td>
                            </tr>
                            }
                        </tbody>
                    </table>
                </div>
                }
            </div>

            @if (pendingUser(); as usuario) {
            <div class="modal-backdrop">
                <section #deleteDialog class="delete-dialog" role="alertdialog" aria-modal="true"
                    aria-labelledby="delete-dialog-title" aria-describedby="delete-dialog-description" tabindex="-1">

                    <div class="dialog-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24">
                            <path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6"></path>
                            <path d="M10 11v5M14 11v5"></path>
                        </svg>
                    </div>

                    @if (confirmationStep() === 1) {
                    <p class="dialog-eyebrow">ACCIÓN IRREVERSIBLE</p>
                    <h2 id="delete-dialog-title">Retirar cuenta</h2>
                    <p id="delete-dialog-description">
                        ¿Quieres iniciar la eliminación de la cuenta de
                        <strong>{{ usuario.firstName }} {{ usuario.lastName }}</strong>
                        ({{ usuario.email }})?
                    </p>
                    <p class="delete-warning">
                        Esta acción eliminará la cuenta de la plataforma y no se puede deshacer.
                    </p>

                    <div class="dialog-actions">
                        <button class="btn-secondary" type="button" (click)="cancelConfirmation()">
                            Cancelar
                        </button>
                        <button class="btn-danger" type="button" (click)="confirmFirstStep()">
                            Continuar
                        </button>
                    </div>
                    } @else {
                    <p class="dialog-eyebrow">ÚLTIMO PASO</p>
                    <h2 id="delete-dialog-title">Confirmación final</h2>
                    <p id="delete-dialog-description">
                        Confirma la eliminación definitiva de <strong>{{ usuario.email }}</strong>.
                    </p>

                    @if (deletionError()) {
                    <p class="error-alert" role="alert">{{ deletionError() }}</p>
                    }

                    <div class="dialog-actions">
                        <button class="btn-secondary" type="button" [disabled]="deleting()"
                            (click)="cancelConfirmation()">
                            Volver
                        </button>
                        <button class="btn-danger" type="button" [disabled]="deleting()" (click)="deleteUser()">
                            {{ deleting() ? 'Eliminando...' : 'Eliminar definitivamente' }}
                        </button>
                    </div>
                    }
                </section>
            </div>
            }
        </main>
    </div>
</div>
</file>

<file path="frontend/src/app/features/client/cart/cart.css">
:host {
  display: block;
  min-height: calc(100vh - var(--app-header-height));
  background: var(--color-page-background);
  color: var(--color-text-primary);
  font-family: Inter, "Segoe UI", sans-serif;
}

.cart-page {
  box-sizing: border-box;
  width: min(1040px, 100%);
  margin: 0 auto;
  padding: 42px 32px 64px;
}

.cart-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  margin-bottom: 28px;
}

.eyebrow {
  margin: 0;
  color: #71899a;
  font-size: 0.7rem;
  font-weight: 750;
  letter-spacing: 0.08em;
}

.cart-heading h1 {
  margin: 0.35rem 0;
  font-size: clamp(1.5rem, 4vw, 2rem);
}

.cart-heading p:last-child {
  margin: 0;
  color: var(--color-text-secondary);
}

.cart-content {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(220px, 280px);
  align-items: start;
  gap: 1.25rem;
}

.cart-items,
.cart-total,
.empty-cart {
  border: 1px solid #d9e3eb;
  border-radius: 14px;
  background: #fff;
  box-shadow: 0 8px 24px rgba(16, 44, 64, 0.05);
}

.cart-items {
  padding: 0 1.25rem;
}

.cart-item {
  display: flex;
  align-items: center;
  gap: 1.25rem;
  padding: 1.1rem 0;
}

.cart-item + .cart-item {
  border-top: 1px solid #e6edf1;
}

.card-media {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76px;
  height: 76px;
  flex: 0 0 76px;
  border-radius: 10px;
  overflow: hidden;
  background: #f1f5f9;
  border: 1px solid #e2e8f0;
}

.product-thumb {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.thumb-fallback {
  font-size: 1.8rem;
  color: #94a3b8;
  display: flex;
  align-items: center;
  justify-content: center;
}

.item-information {
  flex: 1 1 auto;
  min-width: 0;
}

.item-information h2 {
  margin: 0;
  font-size: 1rem;
}

.item-information p {
  margin: 0.35rem 0 0;
  color: var(--color-text-secondary);
  font-size: 0.875rem;
}

.quantity-controls {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin-top: 0.75rem;
}

.quantity-action,
.remove-action {
  min-height: 36px;
  border: 1px solid #cbd9e2;
  border-radius: 7px;
  background: #fff;
  color: var(--color-text-primary);
  font: inherit;
  cursor: pointer;
}

.quantity-action {
  width: 36px;
  font-size: 1.1rem;
}

.remove-action {
  padding: 0 0.75rem;
  color: #a61b1b;
}

.quantity-action:disabled,
.remove-action:disabled {
  cursor: wait;
  opacity: 0.55;
}

.quantity-action:focus-visible,
.remove-action:focus-visible {
  outline: 3px solid var(--color-focus);
  outline-offset: 2px;
}

.quantity-value {
  min-width: 1.5rem;
  text-align: center;
  font-variant-numeric: tabular-nums;
}

.item-subtotal {
  flex: 0 0 auto;
  font-weight: 700;
}

.cart-total {
  padding: 1rem 1.25rem;
}

.cart-total p {
  display: flex;
  justify-content: space-between;
  gap: 1rem;
  color: var(--color-text-secondary);
}

.cart-total .total-line {
  padding-top: 1rem;
  border-top: 1px solid #e6edf1;
  color: var(--color-text-primary);
  font-size: 1.1rem;
}

.checkout-action {
  width: 100%;
  margin-top: 0.75rem;
  border: 0;
}

.checkout-panel,
.order-confirmation {
  border: 1px solid #d9e3eb;
  border-radius: 14px;
  background: #fff;
  box-shadow: 0 8px 24px rgba(16, 44, 64, 0.05);
}

.checkout-panel {
  padding: 1.5rem;
}

.checkout-panel h2,
.order-confirmation h2 {
  margin-top: 0;
}

.checkout-fields {
  display: grid;
  gap: 0.5rem;
  max-width: 620px;
  margin: 1.25rem 0;
}

.checkout-fields label {
  margin-top: 0.5rem;
  color: #496477;
  font-weight: 650;
}

.checkout-fields select {
  box-sizing: border-box;
  width: 100%;
  min-height: 42px;
  padding: 0.5rem;
  border: 1px solid #bdcdd7;
  border-radius: 7px;
  background: #fff;
  color: var(--color-text-primary);
  font: inherit;
}

.checkout-fields select:focus-visible {
  outline: 3px solid var(--color-focus);
  outline-offset: 2px;
}

.checkout-items {
  margin-top: 1.5rem;
}

.checkout-items table {
  width: 100%;
  border-collapse: collapse;
  text-align: left;
}

.checkout-items th,
.checkout-items td {
  padding: 0.7rem 0.5rem;
  border-bottom: 1px solid #e6edf1;
}

.checkout-items td:last-child {
  text-align: right;
}

.checkout-total {
  display: flex;
  justify-content: space-between;
  gap: 1rem;
  font-size: 1.1rem;
}

.checkout-notice {
  color: var(--color-text-secondary);
}

.checkout-actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 0.75rem;
  margin-top: 1.5rem;
}

.checkout-actions button:disabled {
  cursor: wait;
  opacity: 0.65;
}

.order-confirmation {
  max-width: 680px;
  margin: 2rem auto;
  padding: 2rem;
  text-align: center;
}

.order-confirmation > p {
  color: var(--color-text-secondary);
}

.order-confirmation .order-number {
  overflow-wrap: anywhere;
  margin: 1.5rem 0 0.5rem;
  color: var(--color-text-primary);
  font-size: 1.1rem;
}

.order-confirmation .order-number strong {
  color: var(--color-focus);
}

.order-confirmation .order-total {
  margin-bottom: 1.5rem;
  color: var(--color-text-primary);
}

.empty-cart {
  padding: 2.5rem 1.5rem;
  text-align: center;
}

.empty-cart p,
.cart-state {
  color: var(--color-text-secondary);
}

.cart-state.is-error {
  color: #a61b1b;
}

.primary-action,
.secondary-action {
  display: inline-flex;
  min-height: 42px;
  align-items: center;
  justify-content: center;
  padding: 0 1rem;
  border: 0;
  border-radius: 8px;
  font: inherit;
  font-weight: 650;
  text-decoration: none;
  cursor: pointer;
}

.primary-action {
  background: var(--color-brand-accent);
  color: var(--color-brand-dark);
}

.secondary-action {
  background: #fff;
  color: var(--color-text-primary);
  box-shadow: inset 0 0 0 1px #cbd9e2;
}

.primary-action:hover {
  background: var(--color-brand-accent-hover);
}

.primary-action:focus-visible,
.secondary-action:focus-visible {
  outline: 3px solid var(--color-focus);
  outline-offset: 2px;
}

@media (max-width: 520px) {
  .checkout-panel {
    padding: 1rem;
  }

  .checkout-items {
    overflow-x: auto;
  }

  .checkout-items table {
    min-width: 420px;
  }

  .checkout-actions {
    flex-direction: column-reverse;
  }
}

@media (max-width: 680px) {
  .cart-page {
    padding: 28px 18px 48px;
  }

  .cart-heading {
    align-items: flex-start;
    flex-direction: column;
  }

  .cart-content {
    grid-template-columns: 1fr;
  }
}
</file>

<file path="frontend/src/app/features/client/cart/cart.html">
<main class="cart-page">
  <header class="cart-heading">
    <div>
      <p class="eyebrow">ÁREA DE CLIENTE</p>
      <h1>Mi carrito</h1>
      <p>Revisa los artículos y el importe de tu compra.</p>
    </div>
    <a routerLink="/client/dashboard" class="secondary-action">Seguir comprando</a>
  </header>

  @if (cartService.loading()) {
  <p class="cart-state" role="status">Cargando carrito…</p>
  } @else if (cartService.loadError(); as error) {
  <p class="cart-state is-error" role="alert">{{ error }}</p>
  <button class="secondary-action" type="button" (click)="cartService.load()">
    Reintentar
  </button>
  } @else if (orderConfirmation(); as order) {
  <section class="order-confirmation" aria-labelledby="order-confirmation-title">
    <p class="eyebrow">COMPRA COMPLETADA</p>
    <h2 id="order-confirmation-title">¡Gracias por tu pedido!</h2>
    <p>Tu pedido se ha confirmado correctamente.</p>
    <p class="order-number">
      Identificador de pedido: <strong>{{ order.pedidoId }}</strong>
    </p>
    <p class="order-total">
      Total pagado: <strong>{{ formatPrice(order.precioTotal) }}</strong>
    </p>
    <a routerLink="/client/dashboard" class="primary-action">Volver al catálogo</a>
  </section>
  } @else if (cartService.cart(); as cart) {
  @if (actionError(); as error) {
  <p class="cart-state is-error" role="alert">{{ error }}</p>
  }

  @if (checkoutLoading()) {
  <p class="cart-state" role="status">Cargando opciones de pago…</p>
  } @else if (checkoutOpen()) {
  @if (checkoutSummary(); as summary) {
  <section class="checkout-panel" aria-labelledby="checkout-title">
    <h2 id="checkout-title">Confirmación del pedido</h2>

    @if (summary.direcciones.length === 0 || summary.metodosPago.length === 0) {
    <p class="checkout-notice" role="status">
      Guarda una dirección de envío y un método de pago en tu perfil para continuar.
    </p>
    <a routerLink="/client/profile" class="secondary-action">Ir a mi perfil</a>
    } @else {
    <div class="checkout-fields">
      <label for="shipping-address">Dirección de envío</label>
      <select id="shipping-address" name="shippingAddress" [ngModel]="selectedAddressId()"
        (ngModelChange)="selectedAddressId.set($event)">
        @for (address of summary.direcciones; track address.id) {
        <option [value]="address.id">
          {{ address.recipientName }} — {{ address.street }}, {{ address.postalCode }} {{ address.city }}
        </option>
        }
      </select>

      <label for="payment-method">Método de pago</label>
      <select id="payment-method" name="paymentMethod" [ngModel]="selectedPaymentMethodId()"
        (ngModelChange)="selectedPaymentMethodId.set($event)">
        @for (method of summary.metodosPago; track method.id) {
        <option [value]="method.id">
          {{ method.cardBrand || method.type }}{{ method.lastFourDigits ? ' ···· ' + method.lastFourDigits : '' }}
        </option>
        }
      </select>
    </div>

    <div class="checkout-items">
      <h3>Resumen de compra</h3>
      <table>
        <thead>
          <tr>
            <th scope="col">Producto</th>
            <th scope="col">Cantidad</th>
            <th scope="col">Subtotal</th>
          </tr>
        </thead>
        <tbody>
          @for (item of summary.items; track item.productoId) {
          <tr>
            <th scope="row">{{ item.nombre }}</th>
            <td>{{ item.cantidad }}</td>
            <td>{{ formatPrice(item.subtotal) }}</td>
          </tr>
          }
        </tbody>
      </table>
      <p class="checkout-total">
        Total <strong>{{ formatPrice(summary.precioTotal) }}</strong>
      </p>
    </div>
    }

    <div class="checkout-actions">
      <button class="secondary-action" type="button" [disabled]="processingOrder()" (click)="cancelarCheckout()">
        Volver al carrito
      </button>

      @if (summary.direcciones.length > 0 && summary.metodosPago.length > 0) {
      <button class="primary-action" type="button"
        [disabled]="processingOrder() || !selectedAddressId() || !selectedPaymentMethodId()"
        (click)="confirmarPedido()">
        {{ processingOrder() ? 'Procesando pedido y pago…' : 'Confirmar y pagar' }}
      </button>
      }
    </div>
  </section>
  }
  } @else if (cart.items.length === 0) {
  <section class="empty-cart">
    <h2>Tu carrito está vacío</h2>
    <p>Explora el catálogo para encontrar algo que te guste.</p>
    <a routerLink="/client/dashboard" class="primary-action">Ver productos</a>
  </section>
  } @else {
  <section class="cart-content" aria-label="Contenido del carrito">
    <div class="cart-items">
      @for (item of cart.items; track item.productoId) {
      <article class="cart-item">
        <div class="card-media">
          @if (item.imageUrl) {
          <img [src]="item.imageUrl" [alt]="item.nombre" class="product-thumb">
          } @else {
          <div class="thumb-fallback" aria-hidden="true">▦</div>
          }
        </div>

        <div class="item-information">
          <h2>{{ item.nombre }}</h2>
          <p>{{ formatPrice(item.precioUnitario) }} por unidad</p>

          <div class="quantity-controls" [attr.aria-busy]="busyItemIds().has(item.productoId)">

            <button class="quantity-action" type="button" [disabled]="busyItemIds().has(item.productoId)"
              [attr.aria-label]="'Reducir cantidad de ' + item.nombre"
              (click)="changeQuantity(item.productoId, item.cantidad - 1)">
              −
            </button>

            <span class="quantity-value" [attr.aria-label]="'Cantidad: ' + item.cantidad">
              {{ item.cantidad }}
            </span>

            <button class="quantity-action" type="button" [disabled]="busyItemIds().has(item.productoId)"
              [attr.aria-label]="'Aumentar cantidad de ' + item.nombre"
              (click)="changeQuantity(item.productoId, item.cantidad + 1)">
              +
            </button>

            <button class="remove-action" type="button" [disabled]="busyItemIds().has(item.productoId)"
              [attr.aria-label]="'Eliminar ' + item.nombre + ' del carrito'" (click)="removeItem(item.productoId)">
              Eliminar
            </button>

            @if (busyItemIds().has(item.productoId)) {
            <span class="cart-state" role="status">Actualizando…</span>
            }
          </div>
        </div>

        <p class="item-subtotal">{{ formatPrice(item.subtotal) }}</p>
      </article>
      }
    </div>

    <aside class="cart-total" aria-label="Resumen del carrito">
      <p>
        Artículos <span>{{ cartService.itemCount() }}</span>
      </p>
      <p class="total-line">
        Total <strong>{{ formatPrice(cart.precioTotal) }}</strong>
      </p>
      <button class="primary-action checkout-action" type="button" [disabled]="checkoutLoading()"
        (click)="iniciarCheckout()">
        {{ checkoutLoading() ? 'Cargando checkout…' : 'Continuar con la compra' }}
      </button>
    </aside>
  </section>
  }
  } @else {
  <p class="cart-state" role="status">Cargando carrito…</p>
  }
</main>
</file>

