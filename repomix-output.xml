            <h2>Aún no tienes productos</h2>
            <p>Añade tu primer producto para empezar a mostrar tu oferta en ESIBuy.</p>
            <a class="secondary-action" routerLink="/products/new">
              Crear mi primer producto
            </a>
          </div>
          } @else if (visibleProducts().length === 0) {
          <div class="empty-state">
            <span class="empty-icon" aria-hidden="true">⌕</span>
            <h2>No se encontraron productos</h2>
            <p>Prueba a cambiar el nombre de búsqueda o los filtros seleccionados.</p>
            <button type="button" class="secondary-action" (click)="clearFilters()">
              Limpiar filtros
            </button>
          </div>
          } @else {
          @if (categoriesError()) {
          <div class="catalog-error category-error" role="alert">
            <span>No se pudieron cargar los nombres de las categorías.</span>
            <button type="button" (click)="loadCategories()">Reintentar</button>
          </div>
          }

          <div class="table-scroll">
            <table class="seller-data-table product-table">
              <caption class="visually-hidden">Productos de mi catálogo</caption>
              <thead>
                <tr>
                  <th scope="col">Producto</th>
                  <th scope="col">Categoría</th>
                  <th scope="col">Precio</th>
                  <th scope="col">Stock</th>
                  <th scope="col">Visibilidad</th>
                  <th scope="col" class="action-column">
                    <span class="visually-hidden">Acciones</span>
                  </th>
                </tr>
              </thead>

              <tbody>
                @for (product of visibleProducts(); track product.id) {
                <tr>
