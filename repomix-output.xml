<file path="frontend/src/app/shared/delete-account/delete-account.css">
:host {
    display: block;
    font-family: Inter, "Segoe UI", sans-serif;
}

.danger-zone {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: 22px 28px;
    border: 1px solid #f0c9c6;
    border-radius: 16px;
    background: #fdf5f4;
}

.danger-text h2 {
    margin: 0 0 6px;
    color: #8f1d17;
    font-size: 16px;
    font-weight: 750;
}

.danger-text p {
    margin: 0;
    max-width: 560px;
    color: #6b4a47;
    font-size: 13px;
    line-height: 1.5;
}

