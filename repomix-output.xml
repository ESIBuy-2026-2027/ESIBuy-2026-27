import { HttpErrorResponse } from '@angular/common/http';
import { CommonModule } from '@angular/common';
import { ChangeDetectorRef, Component, Input, OnDestroy, computed } from '@angular/core';
import { FormBuilder, FormGroup, ReactiveFormsModule, Validators } from '@angular/forms';
import { ActivatedRoute, Router, RouterLink } from '@angular/router';
import { finalize } from 'rxjs';
import { AuthService, AuthenticatedUser, UserRole } from '../../../core/services/auth.service';

@Component({
  selector: 'app-login',
  standalone: true,
  imports: [CommonModule, ReactiveFormsModule, RouterLink],
  templateUrl: './login.html',
  styleUrl: './login.css'
})
export class Login implements OnDestroy {
  @Input() embedded = false;

  readonly currentUser = computed<AuthenticatedUser | null>(() => {
    if (typeof this.authService?.currentUser === 'function') {
      return this.authService.currentUser();
    }
    return null;
  });

  readonly loginForm: FormGroup;
  successMessage: string | null = null;
  serverError: string | null = null;
  retryAfterSeconds = 0;
  loading = false;
  showPassword = false;
  requires2FA = false;

  private retryCountdownId: ReturnType<typeof setInterval> | null = null;
  private retryBaseMessage: string | null = null;

  constructor(
    private readonly fb: FormBuilder,
    private readonly route: ActivatedRoute,
    private readonly router: Router,
    private readonly authService: AuthService,
    private readonly changeDetectorRef: ChangeDetectorRef
  ) {
    this.loginForm = this.fb.group({
      email: ['', [
        Validators.required,
        Validators.email,
        Validators.maxLength(120)
      ]],
      password: ['', [
        Validators.required,
        Validators.maxLength(128),
      ]],
      totpCode: ['']
    });

    if (this.route.snapshot.queryParamMap.get('expired') === 'true') {
      this.serverError = 'Tu sesión ha expirado';
    }
    if (this.route.snapshot.queryParamMap.get('deleted') === 'true') {
      this.successMessage = 'Tu cuenta se ha eliminado correctamente.';
    }
  }

  onSubmit() {
    if (this.loginForm.invalid || this.loading || this.retryAfterSeconds > 0) {
      this.loginForm.markAllAsTouched();
      return;
    }

    if (this.requires2FA) {
      const codeVal = this.loginForm.get('totpCode')?.value;
      if (!codeVal || codeVal.trim().length === 0) {
        this.loginForm.get('totpCode')?.setErrors({ required: true });
        this.loginForm.markAllAsTouched();
        return;
      }
    }

    this.serverError = null;
    this.loading = true;

    this.authService.login(this.loginForm.value).pipe(
      finalize(() => {
        this.loading = false;
        this.changeDetectorRef.markForCheck();
      })
    ).subscribe({
      next: (response) => {
        if (response.requires2fa) {
          this.requires2FA = true;
          this.serverError = null;
          const totpCtrl = this.loginForm.get('totpCode');
          totpCtrl?.setValidators([Validators.required]);
          totpCtrl?.updateValueAndValidity();
          this.changeDetectorRef.markForCheck();
          return;
        }

        if (response.role === 'ADMIN') {
          void this.router.navigate(['/admin/usuarios']);
        } else if (response.role === 'SELLER') {
          void this.router.navigate(['/seller/catalog']);
        } else if (response.role === 'CLIENT') {
          void this.router.navigate(['/client/catalog']);
        } else {
          void this.router.navigate(['/']);
        }
      },
      error: (error: unknown) => {
        const message = error instanceof HttpErrorResponse
          && typeof error.error?.message === 'string'
          ? error.error.message
          : 'Error en el servidor al iniciar sesión. Revisa tus credenciales.';

        if (error instanceof HttpErrorResponse && error.status === 429) {
          const retryAfterSeconds = this.getRetryAfterSeconds(error);
          if (retryAfterSeconds !== null) {
            this.startRetryCountdown(message, retryAfterSeconds);
            return;
          }
        }

        this.serverError = message;
        this.changeDetectorRef.markForCheck();
      }
    });
  }

  cancel2FA() {
    this.requires2FA = false;
    this.loginForm.get('totpCode')?.setValue('');
    this.loginForm.get('totpCode')?.clearValidators();
    this.loginForm.get('totpCode')?.updateValueAndValidity();
  }

  ngOnDestroy(): void {
    this.clearRetryCountdown();
  }

  private getRetryAfterSeconds(error: HttpErrorResponse): number | null {
    const retryAfter = error.headers.get('Retry-After');
    if (!retryAfter) {
      return null;
    }

    const seconds = Number(retryAfter);
    if (Number.isFinite(seconds) && seconds > 0) {
      return Math.ceil(seconds);
    }

    const retryAt = Date.parse(retryAfter);
    if (!Number.isNaN(retryAt)) {
      const remainingSeconds = Math.ceil((retryAt - Date.now()) / 1000);
      return remainingSeconds > 0 ? remainingSeconds : null;
    }

    return null;
  }

  private startRetryCountdown(message: string, seconds: number): void {
    this.clearRetryCountdown();
    this.retryBaseMessage = message;
    this.retryAfterSeconds = seconds;
    this.updateRetryMessage();
    this.changeDetectorRef.markForCheck();
    this.retryCountdownId = setInterval(() => {
      this.retryAfterSeconds -= 1;
      if (this.retryAfterSeconds <= 0) {
        this.retryAfterSeconds = 0;
        this.serverError = this.retryBaseMessage;
        this.clearRetryCountdown();
        this.changeDetectorRef.markForCheck();
        return;
      }
      this.updateRetryMessage();
      this.changeDetectorRef.markForCheck();
    }, 1000);
  }

  private updateRetryMessage(): void {
    this.serverError = `${this.retryBaseMessage} Puedes volver a intentarlo en ${this.retryAfterSeconds} segundos.`;
  }

  private clearRetryCountdown(): void {
    if (this.retryCountdownId !== null) {
      clearInterval(this.retryCountdownId);
      this.retryCountdownId = null;
    }
  }

  showForgotPasswordMessage(): void {
    void this.router.navigate(['/recuperar-password']);
  }

  getUserDisplayName(user: AuthenticatedUser | null): string {
    if (!user?.email) {
      return 'Usuario';
    }
    const namePart = user.email.split('@')[0];
    return namePart.charAt(0).toUpperCase() + namePart.slice(1);
  }

  getDashboardRoute(role?: UserRole): string {
    switch (role) {
      case 'ADMIN':
        return '/admin/usuarios';
      case 'SELLER':
        return '/seller/catalog';
      case 'CLIENT':
        return '/client/catalog';
      default:
        return '/';
    }
  }

  getDashboardButtonText(role?: UserRole): string {
    switch (role) {
      case 'ADMIN':
        return 'Ir al panel de administración';
      case 'SELLER':
        return 'Ir a mi catálogo de vendedor';
      case 'CLIENT':
        return 'Ir a mi catálogo';
      default:
        return 'Ir a mi panel';
    }
  }

  getRoleLabel(role?: UserRole): string {
    switch (role) {
      case 'ADMIN':
        return 'Administrador';
      case 'SELLER':
        return 'Vendedor';
      case 'CLIENT':
        return 'Cliente';
      default:
        return 'Usuario';
    }
  }

  logout(): void {
    if (typeof this.authService?.logout === 'function') {
      this.authService.logout().subscribe({
        next: () => {
          void this.router.navigate(['/']);
          this.changeDetectorRef.markForCheck();
        },
        error: () => {
          this.authService.clearCurrentUser?.();
          void this.router.navigate(['/']);
          this.changeDetectorRef.markForCheck();
        }
      });
    }
  }
}
</file>

<file path="frontend/src/app/features/products/product-create/product-create.ts">
import { httpErrorMessage } from '../../../core/utils/http-error-message';
import { DestroyRef, Component, OnInit, inject, signal } from '@angular/core';
import { HttpErrorResponse } from '@angular/common/http';
import { ReactiveFormsModule, FormControl, FormGroup, Validators } from '@angular/forms';
import { Router, ActivatedRoute, RouterLink } from '@angular/router';
import { takeUntilDestroyed } from '@angular/core/rxjs-interop';
import { isPlatformBrowser } from '@angular/common';
import { PLATFORM_ID } from '@angular/core';
import { Category, ProductCreateRequest, ProductsService } from '../../../core/services/products.service';
import { AppSidebarComponent } from '../../../shared/app-sidebar/app-sidebar';

interface ProductFormControls {
  nombre: FormControl<string>;
  categoriaIds: FormControl<string[]>;
  stock: FormControl<number | null>;
  descripcion: FormControl<string>;
  precio: FormControl<number | null>;
  descuento: FormControl<number | null>;
  descuentoPremium: FormControl<number | null>;
  imagen: FormControl<string>;
  disponible: FormControl<boolean | null>;
}

type ProductFormField = keyof ProductFormControls;

const SERVER_FIELD_TO_FORM_FIELD: Readonly<Partial<Record<string, ProductFormField>>> = {
  name: 'nombre',
  nombre: 'nombre',
  categoryIds: 'categoriaIds',
  categoriaIds: 'categoriaIds',
  stock: 'stock',
  description: 'descripcion',
  descripcion: 'descripcion',
  price: 'precio',
  precio: 'precio',
  discount: 'descuento',
  descuento: 'descuento',
  premiumDiscount: 'descuentoPremium',
  descuentoPremium: 'descuentoPremium',
  imageUrl: 'imagen',
  imagen: 'imagen',
  available: 'disponible',
  disponible: 'disponible',
};

@Component({
  selector: 'app-product-create',
  standalone: true,
  imports: [ReactiveFormsModule, RouterLink, AppSidebarComponent],
  templateUrl: './product-create.html',
  styleUrl: './product-create.css',
})
export class ProductCreate implements OnInit {
  private readonly productsService = inject(ProductsService);
  private readonly router = inject(Router);
  private readonly destroyRef = inject(DestroyRef);
  private readonly route = inject(ActivatedRoute);
  private readonly platformId = inject(PLATFORM_ID);

  readonly productId = this.route.snapshot.paramMap.get('id');

  readonly sidebarCollapsed = signal(this.readSidebarPreference());

  readonly form = new FormGroup<ProductFormControls>({
    nombre: new FormControl('', {
      nonNullable: true,
      validators: [
        Validators.required,
        Validators.pattern(/\S/),
        Validators.maxLength(150),
      ],
    }),
    categoriaIds: new FormControl<string[]>({ value: [], disabled: true }, {
      nonNullable: true,
      validators: [Validators.required],
    }),
    stock: new FormControl<number | null>(null, [
      Validators.min(0),
      Validators.pattern(/^\d+$/),
    ]),
    descripcion: new FormControl('', {
      nonNullable: true,
      validators: [Validators.maxLength(2000)],
    }),
    precio: new FormControl<number | null>(null, [
      Validators.required,
      Validators.min(Number.MIN_VALUE),
    ]),
    descuento: new FormControl<number | null>(null, [
      Validators.min(0),
      Validators.max(100),
    ]),
    descuentoPremium: new FormControl<number | null>(null, [
      Validators.min(0),
      Validators.max(100),
    ]),
    imagen: new FormControl('', {
      nonNullable: true,
      validators: [
        Validators.maxLength(2000),
        Validators.pattern(/^$|^https?:\/\/\S+$/i),
      ],
    }),
    disponible: new FormControl<boolean | null>(true, [Validators.required]),
  });

  categories: Category[] = [];
  categoriesLoading = true;
  categoriesError = false;

  submitting = signal(false);
  submitSuccess = signal(false);
  submitError = signal<string | null>(null);
  productLoading = signal(false);
  productLoadError = signal<string | null>(null);
  imageError = signal(false);

  serverFieldErrors: Partial<Record<ProductFormField, string>> = {};

  get previewUrl(): string {
    const control = this.form.controls.imagen;
    const value = (control.value ?? '').trim();
    return value && !control.hasError('pattern') ? value : '';
  }

  ngOnInit(): void {
    this.form.valueChanges
      .pipe(takeUntilDestroyed(this.destroyRef))
      .subscribe(() => {
        this.submitSuccess.set(false);
        this.serverFieldErrors = {};
        this.submitError.set(null);
      });

    this.productsService.getCategories()
      .pipe(takeUntilDestroyed(this.destroyRef))
      .subscribe({
        next: (categories) => {
          this.categories = categories;
          this.categoriesLoading = false;

          if (categories.length > 0) {
            this.form.controls.categoriaIds.enable();
          }
        },
        error: () => {
          this.categoriesError = true;
          this.categoriesLoading = false;
        },
      });

    if (this.productId) {
      this.loadProduct();
    }
  }

  toggleSidebar(): void {
    const collapsed = !this.sidebarCollapsed();
    this.sidebarCollapsed.set(collapsed);

    if (isPlatformBrowser(this.platformId)) {
      localStorage.setItem('seller-sidebar-collapsed', String(collapsed));
    }
  }

  private readSidebarPreference(): boolean {
    if (!isPlatformBrowser(this.platformId)) {
      return false;
    }

    return localStorage.getItem('seller-sidebar-collapsed') === 'true';
  }

  loadProduct(): void {
    if (!this.productId) {
      return;
    }

    this.productLoading.set(true);
    this.productLoadError.set(null);

    this.productsService.getProduct(this.productId)
      .pipe(takeUntilDestroyed(this.destroyRef))
      .subscribe({
        next: (product) => {
          this.form.patchValue({
            nombre: product.name,
            categoriaIds: product.categoryIds,
            stock: product.stock,
            descripcion: product.description ?? '',
            precio: product.price,
            descuento: product.discount,
            descuentoPremium: product.premiumDiscount,
            imagen: product.imageUrl ?? '',
            disponible: product.available,
          });

          this.productLoading.set(false);
        },
        error: (error: unknown) => {
          this.productLoading.set(false);
          this.productLoadError.set(this.getLoadErrorMessage(error));
        },
      });
  }

  onSubmit(): void {
    this.submitSuccess.set(false);
    this.submitError.set(null);

    if (
      this.form.invalid ||
      this.productLoading() ||
      this.productLoadError() ||
      this.categoriesLoading ||
      this.categoriesError ||
      this.categories.length === 0 ||
      this.submitting()
    ) {
      this.form.markAllAsTouched();
      return;
    }

    this.submitting.set(true);

    const request = this.toRequest();
    const saveRequest = this.productId
      ? this.productsService.updateProduct(this.productId, request)
      : this.productsService.createProduct(request);

    saveRequest
      .pipe(takeUntilDestroyed(this.destroyRef))
      .subscribe({
        next: () => {
          this.submitting.set(false);
          this.submitSuccess.set(true);
          this.router.navigate(['/seller/catalog']);
        },
        error: (error: unknown) => {
          this.submitting.set(false);
          this.handleSubmitError(error);
        },
      });
  }

  private handleSubmitError(error: unknown): void {
    this.serverFieldErrors = {};

    if (!(error instanceof HttpErrorResponse) || !this.isRecord(error.error)) {
      this.submitError.set('No se pudo guardar el producto. Inténtalo de nuevo.');
      return;
    }

    const response = error.error;
    const message = typeof response['message'] === 'string'
      ? response['message']
      : null;
    const unrecognizedErrors = this.parseFieldErrors(response['errors']);

    if (this.isCategoryErrorMessage(message)) {
      this.serverFieldErrors.categoriaIds = message;
      this.submitError.set(message);
      return;
    }

    this.submitError.set(
      this.resolveSubmitErrorMessage(message, unrecognizedErrors, error.status),
    );
  }

  private parseFieldErrors(errorsPayload: unknown): string[] {
    if (!this.isRecord(errorsPayload)) {
      return [];
    }

    const unrecognizedErrors: string[] = [];

    for (const [field, fieldError] of Object.entries(errorsPayload)) {
      if (typeof fieldError === 'string') {
        this.assignFieldError(field, fieldError, unrecognizedErrors);
      }
    }

    return unrecognizedErrors;
  }

  private assignFieldError(
    field: string,
    error: string,
    unrecognizedErrors: string[],
  ): void {
    const matchingField = SERVER_FIELD_TO_FORM_FIELD[field];

    if (matchingField) {
      this.serverFieldErrors[matchingField] = error;
    } else {
      unrecognizedErrors.push(`${field}: ${error} `);
    }
  }

  private isCategoryErrorMessage(message: string | null): message is string {
    return Boolean(
      message &&
      /categor[ií]as?/i.test(message) &&
      /no existen|no existe|no válid/i.test(message),
    );
  }

  private resolveSubmitErrorMessage(
    message: string | null,
    unrecognizedErrors: string[],
    status: number,
  ): string {
    if (unrecognizedErrors.length > 0) {
      return [message, ...unrecognizedErrors].filter(Boolean).join('. ');
    }

    if (Object.keys(this.serverFieldErrors).length > 0) {
      return 'Revisa los campos marcados y vuelve a intentarlo.';
    }

    return message || this.getFallbackError(status);
  }

  private getFallbackError(status: number): string {
    const sharedMessage = httpErrorMessage(status, {
      401: 'Tu sesión ha caducado. Inicia sesión de nuevo para guardar el producto.',
    });

    if (sharedMessage) {
      return sharedMessage;
    }

    if (status === 403) {
      return 'No tienes permiso para guardar este producto.';
    }

    if (status >= 500) {
      return 'El servidor no pudo guardar el producto. Inténtalo de nuevo más tarde.';
    }

    return 'No se pudo guardar el producto. Inténtalo de nuevo.';
  }

  private getLoadErrorMessage(error: unknown): string {
    if (error instanceof HttpErrorResponse) {
      if (error.status === 401) {
        return httpErrorMessage(error, {
          401: 'Tu sesión ha caducado. Inicia sesión de nuevo para editar productos.',
        }) ?? 'No se pudo cargar el producto. Inténtalo de nuevo.';
      }

      if (error.status === 403) {
        return 'No tienes permiso para editar productos.';
      }

      if (error.status === 404) {
        return 'El producto ya no existe o no tienes permiso para editarlo.';
      }

      if (error.status === 0) {
        return httpErrorMessage(error)
          ?? 'No se pudo cargar el producto. Inténtalo de nuevo.';
      }
    }

    return 'No se pudo cargar el producto. Inténtalo de nuevo.';
  }

  private isRecord(value: unknown): value is Record<string, unknown> {
    return typeof value === 'object' && value !== null && !Array.isArray(value);
  }

  private toRequest(): ProductCreateRequest {
    const value = this.form.getRawValue();

    const request: ProductCreateRequest = {
      name: value.nombre.trim(),
      categoryIds: value.categoriaIds,
      price: value.precio ?? 0,
      available: value.disponible ?? false,
    };

    if (value.stock !== null) {
      request.stock = value.stock;
    }

    if (value.descripcion.trim()) {
      request.description = value.descripcion.trim();
    }

    if (value.descuento !== null) {
      request.discount = value.descuento;
    }

    if (value.descuentoPremium !== null) {
      request.premiumDiscount = value.descuentoPremium;
    }

    if (value.imagen.trim()) {
      request.imageUrl = value.imagen.trim();
    }

    return request;
  }
}
</file>

<file path="frontend/src/app/features/products/seller-catalog/seller-catalog.ts">
import { isPlatformBrowser } from '@angular/common';
import { httpErrorMessage } from '../../../core/utils/http-error-message';
import { AppSidebarComponent } from '../../../shared/app-sidebar/app-sidebar';
import { HttpErrorResponse } from '@angular/common/http';
import { Component, OnInit, PLATFORM_ID, computed, inject, signal } from '@angular/core';
import { FormsModule } from '@angular/forms';
import { RouterLink } from '@angular/router';
import { Category, ProductCreateRequest, ProductsService } from '../../../core/services/products.service';
import { SellerCatalogService, SellerProduct } from '../../../core/services/seller-catalog.service';

const LOW_STOCK_THRESHOLD = 5;
type InlineField = 'price' | 'stock';
type VisibilityFilter = 'all' | 'published' | 'hidden';
type StockFilter = 'all' | 'in-stock' | 'low-stock' | 'out-of-stock';

@Component({
  selector: 'app-seller-catalog',
  standalone: true,
  imports: [FormsModule, RouterLink],
  templateUrl: './seller-catalog.html',
  styleUrl: './seller-catalog.css',
})
export class SellerCatalog implements OnInit {
  private readonly platformId = inject(PLATFORM_ID);
  private readonly catalogService = inject(SellerCatalogService);
  private readonly productsService = inject(ProductsService);
  private readonly currencyFormatter = new Intl.NumberFormat('es-ES', {
    style: 'currency',
    currency: 'EUR',
  });

  products = signal<SellerProduct[]>([]);
  productsLoading = signal(true);
  productsError = signal(false);
  categories = signal<Category[]>([]);
  categoriesLoading = signal(true);
  categoriesError = signal(false);
  productSearch = signal('');
  filtersOpen = signal(false);
  visibilityFilter = signal<VisibilityFilter>('all');
  stockFilter = signal<StockFilter>('all');
  categoryFilter = signal('all');
  inlineEdit = signal<{ productId: string; field: InlineField } | null>(null);
  inlineValue = signal<number | null>(null);
  inlineSaving = signal(false);
  inlineError = signal<string | null>(null);
  visibilitySaving = signal<string | null>(null);
  visibilityError = signal<string | null>(null);
  sidebarCollapsed = signal(this.readSidebarPreference());
  visibleProducts = computed(() => {
    const query = this.productSearch().trim().toLocaleLowerCase();
    return this.products()
      .filter((product) => product.name.toLocaleLowerCase().includes(query))
      .filter((product) => {
        const visibility = this.visibilityFilter();
        const matchesVisibility = visibility === 'all'
          || (visibility === 'published' && product.available)
          || (visibility === 'hidden' && !product.available);

        const stock = this.stockFilter();
        const matchesStock = stock === 'all'
          || (stock === 'in-stock' && product.stock !== null && product.stock > LOW_STOCK_THRESHOLD)
          || (stock === 'low-stock' && product.stock !== null
            && product.stock > 0 && product.stock <= LOW_STOCK_THRESHOLD)
          || (stock === 'out-of-stock' && product.stock === 0);

        const selectedCategory = this.categoryFilter();
        const matchesCategory = selectedCategory === 'all'
          || product.categoryIds.includes(selectedCategory);

        return matchesVisibility && matchesStock && matchesCategory;
      });
  });

  ngOnInit(): void {
    this.loadProducts();
    this.loadCategories();
  }

  loadProducts(): void {
    this.productsLoading.set(true);
    this.productsError.set(false);

    this.catalogService.getProducts().subscribe({
      next: (products) => {
        this.products.set(products);
        this.productsLoading.set(false);
      },
      error: () => {
        this.productsLoading.set(false);
        this.productsError.set(true);
      },
    });
  }

  loadCategories(): void {
    this.categoriesLoading.set(true);
    this.categoriesError.set(false);

    this.productsService.getCategories().subscribe({
      next: (categories) => {
        this.categories.set(categories);
        this.categoriesLoading.set(false);
      },
      error: () => {
        this.categoriesLoading.set(false);
        this.categoriesError.set(true);
      },
    });
  }

  categoryName(categoryId: string): string {
    return this.categories().find((category) => category.id === categoryId)?.name
      ?? 'Categoría no disponible';
  }

  toggleFilters(): void {
    this.filtersOpen.update((isOpen) => !isOpen);
  }

  clearFilters(): void {
    this.visibilityFilter.set('all');
    this.stockFilter.set('all');
    this.categoryFilter.set('all');
  }

  toggleSidebar(): void {
    const collapsed = !this.sidebarCollapsed();
    this.sidebarCollapsed.set(collapsed);

    if (isPlatformBrowser(this.platformId)) {
      localStorage.setItem('seller-sidebar-collapsed', String(collapsed));
    }
  }

  hasActiveFilters(): boolean {
    return this.visibilityFilter() !== 'all'
      || this.stockFilter() !== 'all'
      || this.categoryFilter() !== 'all';
  }

  private readSidebarPreference(): boolean {
    if (!isPlatformBrowser(this.platformId)) {
      return false;
    }

    return localStorage.getItem('seller-sidebar-collapsed') === 'true';
  }

  stockStatus(stock: number): string {
    if (stock === 0) {
      return 'Sin stock';
    }
    return stock <= LOW_STOCK_THRESHOLD ? 'Stock bajo' : 'En stock';
  }

  formatPrice(price: number): string {
    return this.currencyFormatter.format(price);
  }

  toggleVisibility(product: SellerProduct): void {
    if (this.inlineSaving() || this.visibilitySaving()) {
      return;
    }

    this.visibilitySaving.set(product.id);
    this.visibilityError.set(null);
    this.productsService.updateProduct(
      product.id,
      this.toUpdateRequest(product, null, null, !product.available),
    ).subscribe({
      next: (updatedProduct) => {
        this.products.update((products) => products.map((currentProduct) =>
          currentProduct.id === updatedProduct.id ? updatedProduct : currentProduct));
        this.visibilitySaving.set(null);
      },
      error: (error: unknown) => {
        this.visibilitySaving.set(null);
        this.visibilityError.set(this.getInlineErrorMessage(error));
      },
    });
  }

  startInlineEdit(product: SellerProduct, field: InlineField): void {
    if (this.inlineSaving()) {
      return;
    }
    this.inlineEdit.set({ productId: product.id, field });
    this.inlineValue.set(field === 'price' ? product.price : product.stock);
    this.inlineError.set(null);
  }

  cancelInlineEdit(): void {
    if (!this.inlineSaving()) {
      this.inlineEdit.set(null);
      this.inlineValue.set(null);
      this.inlineError.set(null);
    }
  }

  saveInlineEdit(product: SellerProduct): void {
    const edit = this.inlineEdit();
    const value = this.inlineValue();
    if (!edit || edit.productId !== product.id || value === null || !Number.isFinite(value)) {
      this.inlineError.set(edit?.field === 'price'
        ? 'Introduce un precio válido.'
        : 'Introduce un stock válido.');
      return;
    }
    if (edit.field === 'price' && value <= 0) {
      this.inlineError.set('El precio debe ser mayor que 0.');
      return;
    }
    if (edit.field === 'stock' && (!Number.isInteger(value) || value < 0)) {
      this.inlineError.set('El stock debe ser un número entero no negativo.');
      return;
    }

    const request = this.toUpdateRequest(product, edit.field, value, product.available);
    this.inlineSaving.set(true);
    this.inlineError.set(null);
    this.productsService.updateProduct(product.id, request).subscribe({
      next: (updatedProduct) => {
        this.products.update((products) => products.map((currentProduct) =>
          currentProduct.id === updatedProduct.id ? updatedProduct : currentProduct));
        this.inlineSaving.set(false);
        this.inlineEdit.set(null);
        this.inlineValue.set(null);
      },
      error: (error: unknown) => {
        this.inlineSaving.set(false);
        this.inlineError.set(this.getInlineErrorMessage(error));
      },
    });
  }

  isEditing(productId: string, field: InlineField): boolean {
    const edit = this.inlineEdit();
    return edit?.productId === productId && edit.field === field;
  }

  private toUpdateRequest(
    product: SellerProduct,
    field: InlineField | null,
    value: number | null,
    available: boolean): ProductCreateRequest {
    const request: ProductCreateRequest = {
      name: product.name,
      categoryIds: product.categoryIds,
      price: field === 'price' && value !== null ? value : product.price,
      available,
    };
    if (product.stock !== null) {
      request.stock = field === 'stock' && value !== null ? value : product.stock;
    }
    if (product.description) {
      request.description = product.description;
    }
    if (product.discount !== null) {
      request.discount = product.discount;
    }
    if (product.premiumDiscount !== null) {
      request.premiumDiscount = product.premiumDiscount;
    }
    if (product.imageUrl) {
      request.imageUrl = product.imageUrl;
    }
    return request;
  }

  private getInlineErrorMessage(error: unknown): string {
    if (error instanceof HttpErrorResponse) {
      if (error.status === 401) {
        return httpErrorMessage(error) ?? 'No se pudo guardar el cambio. Inténtalo de nuevo.';
      }
      if (error.status === 403) {
        return 'No tienes permiso para modificar este producto.';
      }
      if (error.status === 404) {
        return 'El producto ya no existe o no tienes permiso para modificarlo.';
      }
      if (error.status === 0) {
        return httpErrorMessage(error) ?? 'No se pudo guardar el cambio. Inténtalo de nuevo.';
      }
      if (typeof error.error?.message === 'string') {
        return error.error.message;
      }
    }
    return 'No se pudo guardar el cambio. Inténtalo de nuevo.';
  }
}
