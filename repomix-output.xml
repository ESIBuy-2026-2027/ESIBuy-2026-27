<div class="recovery-page">
    <main class="recovery-card">
        <a routerLink="/login" class="brand" aria-label="ESIBuy, ir al inicio de sesión">
            <strong>ESI</strong><span>Buy</span>
        </a>

        <header class="recovery-header">
            @if (step === 'request') {
            <span class="eyebrow">RECUPERAR ACCESO</span>
            <h1>¿Has olvidado tu contraseña?</h1>
            <p>
                Introduce el correo electrónico asociado a tu cuenta
                para solicitar la recuperación de tu contraseña.
            </p>
            } @else if (step === 'token') {
            <span class="eyebrow">RECUPERAR ACCESO</span>
            <h1>Validar código de recuperación</h1>
            <p>
                Introduce el código de recuperación para comprobar que
                es válido antes de establecer una nueva contraseña.
            </p>
            } @else if (step === 'password') {
            <span class="eyebrow">RECUPERAR ACCESO</span>
            <h1>Crear una nueva contraseña</h1>
            <p>
                El código es válido. Elige una contraseña segura
                para volver a acceder a tu cuenta.
            </p>
            } @else {
            <h1>Contraseña actualizada</h1>
            <p>
                El proceso de recuperación ha finalizado.
                Ya puedes acceder a tu cuenta con la nueva contraseña.
            </p>
            }
        </header>

        @if (successMessage && step !== 'success') {
        <div class="message message-success" role="status" aria-live="polite">
            {{ successMessage }}
        </div>
        }

        @if (errorMessage) {
        <div class="message message-error" role="alert" aria-live="assertive">
            {{ errorMessage }}
        </div>
        }

        @if (step === 'request') {
        <form [formGroup]="requestForm" (ngSubmit)="requestPasswordReset()" novalidate>
            <div class="form-group">
                <label for="reset-email">Correo electrónico</label>

                <input id="reset-email" type="email" formControlName="email" placeholder="usuario@dominio.com"
                    autocomplete="email" [attr.aria-invalid]="
                            requestForm.controls.email.invalid &&
                            requestForm.controls.email.touched
                        " />

                @if (
                requestForm.controls.email.touched &&
                requestForm.controls.email.hasError('required')
                ) {
                <span class="error">
                    El correo electrónico es obligatorio.
                </span>
                }

                @if (
                requestForm.controls.email.touched &&
                requestForm.controls.email.hasError('email')
                ) {
                <span class="error">
                    Introduce un correo electrónico válido.
                </span>
                }

                @if (
                requestForm.controls.email.touched &&
                requestForm.controls.email.hasError('maxlength')
                ) {
                <span class="error">
                    El correo electrónico no puede superar los 254 caracteres.
                </span>
                }
            </div>

            <button class="btn-submit" type="submit" [disabled]="loading || requestSubmitted">
                {{
                loading
                ? 'Enviando solicitud…'
                : requestSubmitted
                ? 'Solicitud enviada'
                : 'Recuperar contraseña'
                }}
            </button>
        </form>

        @if (requestSubmitted) {
        <form class="token-form" [formGroup]="resetForm" (ngSubmit)="validateRecoveryToken()" novalidate>
            <div class="form-group">
                <label for="reset-token">Código de recuperación</label>

                <input id="reset-token" type="text" formControlName="token" placeholder="Introduce el código recibido"
                    autocomplete="off" autocapitalize="off" spellcheck="false" [attr.aria-invalid]="
                                resetForm.controls.token.invalid &&
                                resetForm.controls.token.touched
                            " />

                @if (
                resetForm.controls.token.touched &&
                resetForm.controls.token.hasError('required')
                ) {
                <span class="error">
                    El código de recuperación es obligatorio.
                </span>
                }

                @if (
                resetForm.controls.token.touched &&
                resetForm.controls.token.hasError('maxlength')
                ) {
                <span class="error">
                    El código de recuperación no es válido.
                </span>
                }
            </div>

            <button class="btn-submit" type="submit" [disabled]="loading">
                {{ loading ? 'Validando código…' : 'Validar código' }}
            </button>
        </form>
        }
        }

        @if (step === 'token') {
        <form [formGroup]="resetForm" (ngSubmit)="validateRecoveryToken()" novalidate>
            <div class="form-group">
                <label for="reset-token">Código de recuperación</label>

                <input id="reset-token" type="text" formControlName="token" placeholder="Introduce el código recibido"
                    autocomplete="off" autocapitalize="off" spellcheck="false" [attr.aria-invalid]="
                            resetForm.controls.token.invalid &&
                            resetForm.controls.token.touched
                        " />

                @if (
                resetForm.controls.token.touched &&
                resetForm.controls.token.hasError('required')
                ) {
                <span class="error">
                    El código de recuperación es obligatorio.
                </span>
                }

                @if (
                resetForm.controls.token.touched &&
                resetForm.controls.token.hasError('maxlength')
                ) {
                <span class="error">
                    El código de recuperación no es válido.
                </span>
                }
            </div>

            <button class="btn-submit" type="submit" [disabled]="loading">
                {{ loading ? 'Validando código…' : 'Validar código' }}
            </button>
        </form>

        <button class="text-link" type="button" (click)="backToEmailRequest()">
            Volver a solicitar la recuperación
        </button>
        }

        @if (step === 'password') {
        <form [formGroup]="resetForm" (ngSubmit)="confirmPasswordReset()" novalidate>
            <div class="form-group">
                <label for="new-password">Nueva contraseña</label>

                <div class="password-wrapper">
                    <input id="new-password" [type]="showPassword ? 'text' : 'password'" formControlName="newPassword"
                        placeholder="Introduce la nueva contraseña"
                        [attr.autocomplete]="showPassword ? 'off' : 'new-password'" [attr.aria-invalid]="
                                resetForm.controls.newPassword.invalid &&
                                resetForm.controls.newPassword.touched
                            " />

                    <button type="button" class="password-toggle" (click)="togglePasswordVisibility()"
                        [attr.aria-label]="showPassword ? 'Ocultar contraseñas' : 'Mostrar contraseñas'"
                        [attr.aria-pressed]="showPassword">
                        @if (!showPassword) {
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z" fill="none"
                                stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                            <circle cx="12" cy="12" r="2.5" fill="none" stroke="currentColor" stroke-width="2" />
                        </svg>
                        } @else {
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M3 3l18 18" fill="none" stroke="currentColor" stroke-width="2"
                                stroke-linecap="round" />
                            <path
                                d="M10.6 6.2A10.5 10.5 0 0 1 12 6c6 0 9.5 6 9.5 6a17.5 17.5 0 0 1-3.2 3.8M6.2 6.2C3.9 7.8 2.5 12 2.5 12s3.5 6 9.5 6c1.4 0 2.7-.3 3.8-.8"
                                fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                stroke-linejoin="round" />
                        </svg>
                        }
                    </button>
                </div>

                @if (
                resetForm.controls.newPassword.touched &&
                resetForm.controls.newPassword.hasError('required')
                ) {
                <span class="error">La contraseña es obligatoria.</span>
                }

                @if (
                resetForm.controls.newPassword.touched &&
                (
                resetForm.controls.newPassword.hasError('minlength') ||
                resetForm.controls.newPassword.hasError('maxlength')
                )
                ) {
                <span class="error">
                    Debe tener entre 12 y 128 caracteres.
                </span>
                }

                @if (
                resetForm.controls.newPassword.touched &&
                resetForm.controls.newPassword.hasError('pattern')
                ) {
                <span class="error">
                    Incluye mayúsculas, minúsculas, números y caracteres especiales, sin espacios.
                </span>
                }
            </div>

            <div class="form-group">
                <label for="confirm-password">Confirmar contraseña</label>

                <div class="password-wrapper">
                    <input id="confirm-password" [type]="showPassword ? 'text' : 'password'"
                        formControlName="confirmPassword" placeholder="Repite la nueva contraseña"
                        [attr.autocomplete]="showPassword ? 'off' : 'new-password'" [attr.aria-invalid]="
                                (
                                    resetForm.controls.confirmPassword.invalid ||
                                    resetForm.hasError('passwordMismatch')
                                ) &&
                                resetForm.controls.confirmPassword.touched
                            " />
                </div>

                @if (
                resetForm.controls.confirmPassword.touched &&
                resetForm.controls.confirmPassword.hasError('required')
                ) {
                <span class="error">Confirma la nueva contraseña.</span>
                }

                @if (
                resetForm.controls.confirmPassword.touched &&
                resetForm.hasError('passwordMismatch')
                ) {
                <span class="error">Las contraseñas no coinciden.</span>
                }
            </div>

            <p class="privacy-note password-hint">
                Usa entre 12 y 128 caracteres, incluyendo mayúsculas,
                minúsculas, números y caracteres especiales. No se permiten espacios.
            </p>

            <button class="btn-submit" type="submit" [disabled]="loading">
                {{ loading ? 'Actualizando contraseña…' : 'Guardar nueva contraseña' }}
            </button>
        </form>

        <button class="text-link" type="button" (click)="backToTokenEntry()">
            Volver a validar el código
        </button>
        }

        @if (step === 'success') {
        <div class="message message-success" role="status" aria-live="polite">
            {{ successMessage }}
        </div>

        <a routerLink="/login" class="btn-submit login-success-link">
            Ir a iniciar sesión
        </a>
        }

        @if (step !== 'success') {
        <a routerLink="/login" class="back-link">
            ← Volver al inicio de sesión
        </a>
        }
    </main>
</div>
</file>

<file path="frontend/src/app/features/identity/password-recovery/password-recovery.ts">
import { CommonModule } from '@angular/common';
import { HttpErrorResponse } from '@angular/common/http';
import { ChangeDetectorRef, Component } from '@angular/core';
import {
    AbstractControl,
    FormBuilder,
    ReactiveFormsModule,
    ValidationErrors,
    Validators,
} from '@angular/forms';
import { ActivatedRoute, RouterLink } from '@angular/router';
import { finalize } from 'rxjs';
import { AuthService } from '../../../core/services/auth.service';

const passwordPattern =
    /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[^A-Za-z0-9])\S+$/;

type RecoveryStep = 'request' | 'token' | 'password' | 'success';

function passwordMatchValidator(
    control: AbstractControl,
): ValidationErrors | null {
    const password = control.get('newPassword')?.value;
    const confirmation = control.get('confirmPassword')?.value;

    if (!password || !confirmation) {
        return null;
    }

    return password === confirmation ? null : { passwordMismatch: true };
}

@Component({
    selector: 'app-password-recovery',
    standalone: true,
    imports: [CommonModule, ReactiveFormsModule, RouterLink],
    templateUrl: './password-recovery.html',
    styleUrl: './password-recovery.css',
})
export class PasswordRecovery {
    readonly requestForm;
    readonly resetForm;

    readonly tokenFromUrl: string;

    step: RecoveryStep = 'request';
    loading = false;
    showPassword = false;
    requestSubmitted = false;

    errorMessage: string | null = null;
    successMessage: string | null = null;

    constructor(
        private readonly fb: FormBuilder,
        private readonly route: ActivatedRoute,
        private readonly authService: AuthService,
        private readonly changeDetectorRef: ChangeDetectorRef,
    ) {
        this.tokenFromUrl =
            this.route.snapshot.queryParamMap.get('token') ?? '';

        // Si el enlace incluye un token, primero se debe validar.
        this.step = this.tokenFromUrl ? 'token' : 'request';

        this.requestForm = this.fb.group({
            email: [
                '',
                [
                    Validators.required,
                    Validators.email,
                    Validators.maxLength(254),
                ],
            ],
        });

        this.resetForm = this.fb.group(
            {
                token: [
                    this.tokenFromUrl,
                    [
                        Validators.required,
                        Validators.maxLength(128),
                    ],
                ],
                newPassword: [
                    '',
                    [
                        Validators.required,
                        Validators.minLength(12),
                        Validators.maxLength(128),
                        Validators.pattern(passwordPattern),
                    ],
                ],
                confirmPassword: ['', [Validators.required]],
            },
            {
                validators: passwordMatchValidator,
            },
        );
    }

    useRecoveryCode(): void {
        this.clearMessages();
        this.step = 'token';

        if (!this.tokenFromUrl) {
            this.resetForm.controls.token.reset('');
        }

        this.changeDetectorRef.markForCheck();
    }

    backToEmailRequest(): void {
        if (this.loading) {
            return;
        }

        this.clearMessages();
        this.step = 'request';
        this.changeDetectorRef.markForCheck();
    }

    backToTokenEntry(): void {
        if (this.loading) {
            return;
        }

        this.clearMessages();
        this.resetForm.controls.newPassword.reset('');
        this.resetForm.controls.confirmPassword.reset('');
        this.step = 'token';
        this.changeDetectorRef.markForCheck();
    }

    togglePasswordVisibility(): void {
        this.showPassword = !this.showPassword;
    }

    requestPasswordReset(): void {
        this.clearMessages();

        if (
            this.requestForm.invalid ||
            this.loading ||
            this.requestSubmitted
        ) {
            this.requestForm.markAllAsTouched();
            return;
        }

        const email = String(
            this.requestForm.controls.email.value ?? '',
        ).trim();

        this.loading = true;

        this.authService
            .requestPasswordReset(email)
            .pipe(
                finalize(() => {
                    this.loading = false;
                    this.changeDetectorRef.markForCheck();
                }),
            )
            .subscribe({
                next: (response) => {
                    this.requestSubmitted = true;
                    this.successMessage =
                        response?.message ||
                        'Si existe una cuenta asociada a ese correo, recibirás instrucciones para recuperar el acceso.';

                    this.changeDetectorRef.markForCheck();
                },
                error: (error: unknown) => {
                    this.errorMessage = this.getErrorMessage(
                        error,
                        'No se ha podido procesar la solicitud. Inténtalo de nuevo más tarde.',
                    );

                    this.changeDetectorRef.markForCheck();
                },
            });
    }

    validateRecoveryToken(): void {
        this.clearMessages();

        const tokenControl = this.resetForm.controls.token;
        tokenControl.markAsTouched();

        if (tokenControl.invalid || this.loading) {
            return;
        }

        const token = String(tokenControl.value ?? '').trim();

        if (!token) {
            this.errorMessage = 'Introduce el código de recuperación.';
            return;
        }

        this.loading = true;

        this.authService
            .validatePasswordResetToken(token)
            .pipe(
                finalize(() => {
                    this.loading = false;
                    this.changeDetectorRef.markForCheck();
                }),
            )
            .subscribe({
                next: (response) => {
                    // Solo se muestran las contraseñas tras validar el token.
                    this.resetForm.controls.token.setValue(token);
                    this.step = 'password';
                    this.successMessage =
                        response?.message ||
                        'El código es válido. Ya puedes establecer una nueva contraseña.';

                    this.changeDetectorRef.markForCheck();
                },
                error: (error: unknown) => {
                    this.errorMessage = this.getErrorMessage(
                        error,
                        'El código no es válido o ha caducado. Compruébalo e inténtalo de nuevo.',
                    );

                    this.changeDetectorRef.markForCheck();
                },
            });
    }

    confirmPasswordReset(): void {
        this.clearMessages();

        if (this.resetForm.invalid || this.loading) {
            this.resetForm.markAllAsTouched();
            return;
        }

        const token = String(
            this.resetForm.controls.token.value ?? '',
        ).trim();

        const newPassword = String(
            this.resetForm.controls.newPassword.value ?? '',
        );

        this.loading = true;

        this.authService
            .confirmPasswordReset(token, newPassword)
            .pipe(
                finalize(() => {
                    this.loading = false;
                    this.changeDetectorRef.markForCheck();
                }),
            )
            .subscribe({
                next: (response) => {
                    this.step = 'success';
                    this.successMessage =
                        response?.message ||
                        'La contraseña se ha actualizado correctamente. Ya puedes iniciar sesión.';

                    this.resetForm.disable();
                    this.changeDetectorRef.markForCheck();
                },
                error: (error: unknown) => {
                    this.errorMessage = this.getErrorMessage(
                        error,
                        'No se ha podido restablecer la contraseña. Comprueba el código e inténtalo de nuevo.',
                    );

                    this.changeDetectorRef.markForCheck();
                },
            });
    }

    private clearMessages(): void {
        this.errorMessage = null;
        this.successMessage = null;
    }

    private getErrorMessage(error: unknown, fallback: string): string {
        if (
            error instanceof HttpErrorResponse &&
            typeof error.error?.message === 'string'
        ) {
            return error.error.message;
        }

        return fallback;
    }
}
</file>

<file path="frontend/src/app/features/products/product-create/product-create.spec.ts">
import { HttpErrorResponse } from '@angular/common/http';
import { ComponentFixture, TestBed } from '@angular/core/testing';
import { ActivatedRoute, provideRouter } from '@angular/router';
import { Observable, of, throwError } from 'rxjs';
import { Category, CreatedProduct, ProductCreateRequest, ProductDetails, ProductsService } from '../../../core/services/products.service';
import { ProductCreate as ProductCreateComponent } from './product-create';

describe('ProductCreate', () => {
  const categories: Category[] = [
    { id: 'category-tech', name: 'Electrónica' },
    { id: 'category-home', name: 'Hogar' },
  ];
  let fixture: ComponentFixture<ProductCreateComponent>;
  let productService: Pick<ProductsService, 'getCategories' | 'createProduct' | 'getProduct' | 'updateProduct'>;
  let createProduct: ReturnType<typeof vi.fn<(request: ProductCreateRequest) => Observable<CreatedProduct>>>;
  let getProduct: ReturnType<typeof vi.fn<(id: string) => Observable<ProductDetails>>>;
  let updateProduct: ReturnType<typeof vi.fn<
    (id: string, request: ProductCreateRequest) => Observable<ProductDetails>
  >>;
  let categoriesResponse: Observable<Category[]>;
  let routeProductId: string | null;

  beforeEach(async () => {
    categoriesResponse = of(categories);
    routeProductId = null;
    createProduct = vi.fn<(request: ProductCreateRequest) => Observable<CreatedProduct>>(
      () => of({ id: 'product-1' }),
    );
    getProduct = vi.fn<(id: string) => Observable<ProductDetails>>(() => of({
      id: 'product-1',
      name: 'Auriculares',
      categoryIds: ['category-tech'],
      stock: 3,
      description: 'Inalámbricos',
      price: 19.99,
      discount: 5,
      premiumDiscount: 10,
      imageUrl: 'https://example.com/auriculares.png',
      available: true,
      sellerId: 'seller-1',
    }));
    updateProduct = vi.fn<
      (id: string, request: ProductCreateRequest) => Observable<ProductDetails>
    >(() => of({
      id: 'product-1',
      name: 'Auriculares',
      categoryIds: ['category-tech'],
      stock: 3,
      description: 'Inalámbricos',
      price: 19.99,
      discount: 5,
      premiumDiscount: 10,
      imageUrl: 'https://example.com/auriculares.png',
      available: true,
      sellerId: 'seller-1',
    }));
    productService = {
      getCategories: () => categoriesResponse,
      createProduct,
      getProduct,
      updateProduct,
    };

    await TestBed.configureTestingModule({
      imports: [ProductCreateComponent],
      providers: [
        provideRouter([{ path: 'seller/catalog', children: [] }]),
        {
          provide: ActivatedRoute,
          useValue: { snapshot: { paramMap: { get: (key: string) => key === 'id' ? routeProductId : null } } },
        },
        { provide: ProductsService, useValue: productService },
      ],
    }).compileComponents();
    fixture = TestBed.createComponent(ProductCreateComponent);
    fixture.detectChanges();
    await fixture.whenStable();
    fixture.detectChanges();
  });

  it('should load existing categories and render every product field', () => {
    const element = fixture.nativeElement as HTMLElement;

    expect(element.querySelector('h1')?.textContent).toContain('Añadir producto');
    const options = element.querySelectorAll<HTMLOptionElement>('select[formControlName="categoriaIds"] option');
    expect(options.length).toBe(2);
    expect(options[0].textContent).toBe('Electrónica');
    fixture.componentInstance.form.controls.categoriaIds.setValue(['category-tech']);
    fixture.detectChanges();
    expect(options[0].selected).toBe(true);
    for (const field of [
      'nombre',
      'categoriaIds',
      'stock',
      'descripcion',
      'precio',
      'descuento',
      'descuentoPremium',
      'imagen',
      'disponible',
    ]) {
      expect(element.querySelector(`[formControlName="${field}"]`)).not.toBeNull();
    }
  });

  it('should show validation errors for required and invalid product fields', () => {
    fixture.componentInstance.form.setValue({
      nombre: '   ',
      categoriaIds: [],
      stock: -1,
      descripcion: 'x'.repeat(2001),
      precio: 0,
      descuento: 101,
      descuentoPremium: -1,
      imagen: 'not-a-url',
      disponible: null,
    });

    fixture.componentInstance.onSubmit();
    fixture.detectChanges();

    expect(fixture.componentInstance.form.invalid).toBe(true);
    expect(fixture.componentInstance.form.controls.nombre.touched).toBe(true);
    expect(fixture.componentInstance.form.controls.categoriaIds.touched).toBe(true);
    expect(fixture.componentInstance.form.controls.stock.hasError('min')).toBe(true);
    expect(fixture.componentInstance.form.controls.descripcion.hasError('maxlength')).toBe(true);
    expect(fixture.componentInstance.form.controls.precio.hasError('min')).toBe(true);
    expect(fixture.componentInstance.form.controls.descuento.hasError('max')).toBe(true);
    expect(fixture.componentInstance.form.controls.descuentoPremium.hasError('min')).toBe(true);
    expect(fixture.componentInstance.form.controls.imagen.hasError('pattern')).toBe(true);
    expect(fixture.componentInstance.form.controls.disponible.hasError('required')).toBe(true);
    expect(createProduct).not.toHaveBeenCalled();
  });

  it('should confirm product creation on the same page', async () => {
    fixture.componentInstance.form.setValue({
      nombre: '  Auriculares  ',
      categoriaIds: ['category-tech', 'category-home'],
      stock: 7,
      descripcion: 'Auriculares inalámbricos',
      precio: 19.99,
      descuento: null,
      descuentoPremium: 15,
      imagen: 'https://example.com/auriculares.png',
      disponible: true,
    });

    fixture.componentInstance.onSubmit();
    await fixture.whenStable();

    expect(createProduct).toHaveBeenCalledWith({
      name: 'Auriculares',
      categoryIds: ['category-tech', 'category-home'],
      stock: 7,
      description: 'Auriculares inalámbricos',
      price: 19.99,
      premiumDiscount: 15,
      imageUrl: 'https://example.com/auriculares.png',
      available: true,
    } satisfies ProductCreateRequest);
    expect(fixture.componentInstance.submitting()).toBe(false);
    expect(fixture.componentInstance.submitSuccess()).toBe(true);
    expect((fixture.nativeElement as HTMLElement).textContent).toContain('Producto registrado correctamente.');
  });

  it('should preload and update the selected product', async () => {
    fixture.destroy();
    routeProductId = 'product-1';
    fixture = TestBed.createComponent(ProductCreateComponent);
    fixture.detectChanges();
    await fixture.whenStable();
    fixture.detectChanges();

    const component = fixture.componentInstance;
    expect(getProduct).toHaveBeenCalledWith('product-1');
    expect(component.form.getRawValue()).toEqual({
      nombre: 'Auriculares',
      categoriaIds: ['category-tech'],
      stock: 3,
      descripcion: 'Inalámbricos',
      precio: 19.99,
      descuento: 5,
      descuentoPremium: 10,
      imagen: 'https://example.com/auriculares.png',
      disponible: true,
    });

    component.form.controls.nombre.setValue('Auriculares actualizados');
    component.onSubmit();
    await fixture.whenStable();

    expect(updateProduct).toHaveBeenCalledWith('product-1', expect.objectContaining({
      name: 'Auriculares actualizados',
      categoryIds: ['category-tech'],
      price: 19.99,
      available: true,
    }));
    expect(createProduct).not.toHaveBeenCalled();
    expect((fixture.nativeElement as HTMLElement).textContent).toContain('Producto actualizado correctamente.');
  });

  it('should show all backend validation errors under their fields', () => {
    createProduct.mockReturnValue(throwError(() => new HttpErrorResponse({
      status: 400,
      error: {
        message: 'La solicitud contiene errores',
        errors: {
          name: 'El nombre no puede estar vacío.',
          price: 'El precio debe ser mayor que 0.',
        },
      },
    })));
    fixture.componentInstance.form.setValue({
      nombre: 'Producto',
      categoriaIds: ['category-tech'],
      stock: null,
      descripcion: '',
      precio: 5,
      descuento: null,
      descuentoPremium: null,
      imagen: '',
      disponible: true,
    });

    fixture.componentInstance.onSubmit();
    fixture.detectChanges();

    const element = fixture.nativeElement as HTMLElement;
    expect(element.textContent).toContain('El nombre no puede estar vacío.');
    expect(element.textContent).toContain('El precio debe ser mayor que 0.');
    expect(fixture.componentInstance.serverFieldErrors).toEqual({
      nombre: 'El nombre no puede estar vacío.',
      precio: 'El precio debe ser mayor que 0.',
    });
  });

  it('should show the backend message when a selected category does not exist', () => {
    const message = 'No existen las categorías indicadas: category-unknown';
    createProduct.mockReturnValue(throwError(() => new HttpErrorResponse({
      status: 400,
      error: { message },
    })));
    fixture.componentInstance.form.setValue({
      nombre: 'Producto',
      categoriaIds: ['category-unknown'],
      stock: null,
      descripcion: '',
      precio: 5,
      descuento: null,
      descuentoPremium: null,
      imagen: '',
      disponible: true,
    });

    fixture.componentInstance.onSubmit();
    fixture.detectChanges();

    expect(fixture.componentInstance.submitError()).toBe(message);
    expect(fixture.componentInstance.serverFieldErrors.categoriaIds).toBe(message);
  });

  it('should omit blank optional fields when submitting', () => {
    fixture.componentInstance.form.setValue({
      nombre: 'Producto nuevo',
      categoriaIds: ['category-tech'],
      stock: null,
      descripcion: '',
      precio: 5,
      descuento: null,
      descuentoPremium: null,
      imagen: '',
      disponible: true,
    });

    fixture.componentInstance.onSubmit();

    expect(createProduct).toHaveBeenCalledWith({
      name: 'Producto nuevo',
      categoryIds: ['category-tech'],
      price: 5,
      available: true,
    } satisfies ProductCreateRequest);
  });

  it('should surface category loading failures instead of showing fake categories', () => {
    categoriesResponse = new Observable<Category[]>((subscriber) => {
      subscriber.error(new HttpErrorResponse({ status: 503 }));
    });
    fixture.destroy();

    const errorFixture = TestBed.createComponent(ProductCreateComponent);
    errorFixture.detectChanges();
    errorFixture.detectChanges();

    const element = errorFixture.nativeElement as HTMLElement;
    expect(element.querySelectorAll('select[formControlName="categoriaIds"] option').length).toBe(0);
    expect(element.querySelector<HTMLSelectElement>('select[formControlName="categoriaIds"]')?.disabled).toBe(true);
    expect(element.querySelector('select[formControlName="categoriaIds"]')?.getAttribute('size')).toBe('1');
    expect(element.textContent).toContain('No se pudieron cargar las categorías');
  });

  it('should explain when the backend has no categories available', async () => {
    fixture.destroy();
    categoriesResponse = of([]);

    const emptyFixture = TestBed.createComponent(ProductCreateComponent);
    emptyFixture.detectChanges();
    await emptyFixture.whenStable();
    emptyFixture.detectChanges();

    const element = emptyFixture.nativeElement as HTMLElement;
    expect(element.textContent).toContain('No hay categorías disponibles en este momento.');
    expect(element.querySelector<HTMLSelectElement>('select[formControlName="categoriaIds"]')?.disabled).toBe(true);
    expect(element.querySelector<HTMLButtonElement>('button[type="submit"]')?.disabled).toBe(true);
    emptyFixture.componentInstance.onSubmit();
    expect(createProduct).not.toHaveBeenCalled();
  });
});
</file>

