  display: flex;
  align-items: center;
  gap: 6px;
}

.price-inputs-row input {
  width: 76px;
  padding: 9px 10px;
  border: 1px solid #cbd5e1;
  border-radius: 8px;
  font-size: 13px;
  outline: none;
}

.price-inputs-row input:focus {
  border-color: #42d6b2;
}

.price-inputs-row .sep {
  color: #94a3b8;
  font-weight: bold;
}

.stock-item {
  justify-content: flex-end;
  padding-bottom: 9px;
}

.product-cards-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
  gap: 24px;
}

.showcase-card {
  background: #ffffff;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 2px 6px rgba(16, 44, 64, 0.05);
  display: flex;
  flex-direction: column;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
  cursor: pointer;
  text-decoration: none;
  color: inherit;
}

.showcase-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 8px 20px rgba(16, 44, 64, 0.12);
}

.card-media-wrapper {
  position: relative;
  width: 100%;
  aspect-ratio: 4 / 3;
  background: #f1f5f9;
  display: grid;
  place-items: center;
  overflow: hidden;
}

.card-photo {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.photo-placeholder {
  font-size: 36px;
  color: #cbd5e1;
}

.rating-badge {
  position: absolute;
  top: 10px;
  left: 10px;
  background: rgba(16, 44, 64, 0.85);
  backdrop-filter: blur(4px);
  color: #facc15;
  font-size: 11px;
  font-weight: 750;
  padding: 3px 8px;
  border-radius: 6px;
  z-index: 2;
}

/* CORAZÓN CENTRADO EN HOVER */
.center-heart-action {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) scale(0.85);
  z-index: 5;
  width: 48px;
  height: 48px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 0 6px 16px rgba(0, 0, 0, 0.18);
  border: none;
  display: grid;
  place-items: center;
  cursor: pointer;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.2s ease, transform 0.2s ease, background 0.15s;
}

.heart-svg-icon {
  width: 24px;
  height: 24px;
  fill: transparent;
  stroke: #475569;
  stroke-width: 2;
  transition: stroke 0.15s, fill 0.15s;
}

.showcase-card:hover .center-heart-action,
.card-media-wrapper:hover .center-heart-action {
  opacity: 1;
  pointer-events: auto;
  transform: translate(-50%, -50%) scale(1);
}

.center-heart-action:hover {
  background: #ffffff;
  transform: translate(-50%, -50%) scale(1.1);
}

.center-heart-action:hover .heart-svg-icon {
  stroke: #e11d48;
}

.center-heart-action.is-favorite {
  opacity: 0.9;
  pointer-events: auto;
}

.center-heart-action.is-favorite .heart-svg-icon {
  fill: #e11d48;
  stroke: #e11d48;
}

.card-content {
  padding: 16px;
  display: flex;
  flex-direction: column;
  flex: 1;
}

.card-category-list {
  display: flex;
  flex-wrap: wrap;
  gap: 4px;
  margin-bottom: 8px;
}

.cat-pill {
  background: #f1f5f9;
  color: #475569;
  font-size: 11px;
  font-weight: 600;
  padding: 2px 7px;
  border-radius: 4px;
}

.card-title {
  margin: 0 0 6px;
  font-size: 16px;
  font-weight: 750;
  color: #102c40;
  line-height: 1.3;
}

.card-desc {
  margin: 0 0 14px;
  font-size: 13px;
  color: #64748b;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.card-price-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: auto;
  padding-top: 12px;
  border-top: 1px solid #f1f5f9;
}

.price-stock-wrap {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.card-price {
  font-size: 18px;
  font-weight: 850;
  color: #102c40;
}

.stock-pill {
  font-size: 11px;
  font-weight: 700;
  color: #0d9488;
}

.stock-pill.stock-low {
  color: #d97706;
}

.stock-pill.stock-empty {
  color: #dc2626;
}

.card-btn-group {
  display: flex;
  align-items: center;
  gap: 10px;
}

.add-to-cart-action-btn {
  background: #0d9488;
  color: #ffffff;
  border: none;
  border-radius: 6px;
  padding: 6px 12px;
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
  transition: background 0.15s ease, transform 0.1s;
}

.add-to-cart-action-btn:hover:not(:disabled) {
  background: #0f766e;
  transform: translateY(-1px);
}

.add-to-cart-action-btn:disabled {
  background: #cbd5e1;
  color: #94a3b8;
  cursor: not-allowed;
}

.detail-link {
  font-size: 12px;
  font-weight: 700;
  color: #0d9488;
}

.showcase-card:hover .detail-link {
  text-decoration: underline;
}

/* Status message boxes */
.status-box {
  background: #ffffff;
  border-radius: 12px;
  padding: 48px 24px;
  text-align: center;
  box-shadow: 0 2px 6px rgba(16, 44, 64, 0.05);
}

.empty-glyph {
  font-size: 40px;
  color: #94a3b8;
  display: block;
  margin-bottom: 8px;
}

.btn-retry,
.btn-reset {
  margin-top: 12px;
  padding: 8px 18px;
  background: #102c40;
  color: #ffffff;
  border: none;
  border-radius: 8px;
  font-size: 13px;
  font-weight: 650;
  cursor: pointer;
}

.spinner {
  width: 32px;
  height: 32px;
  margin: 0 auto 12px;
  border: 3px solid #cbd5e1;
  border-top-color: #0d9488;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.visually-hidden {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  border: 0;
}
