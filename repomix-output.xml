<main class="seller-layout product-create-layout" [class.sidebar-collapsed]="sidebarCollapsed()">
  <app-shared-sidebar variant="seller-compact"></app-shared-sidebar>

  <div class="workspace">
    @if (sidebarCollapsed()) {
    <button type="button" class="sidebar-toggle sidebar-toggle-open" (click)="toggleSidebar()"
      aria-label="Mostrar barra lateral" title="Mostrar barra lateral">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="m9 18 6-6-6-6" />
      </svg>
    </button>
    }

    <div class="product-create-page">
      <div class="product-create-content">
        <section class="product-create-card" aria-labelledby="product-page-title">
          <header class="page-header">
            <a class="back-link" routerLink="/seller/catalog">
              <span aria-hidden="true">←</span>
              Volver al catálogo
            </a>

            <div class="page-heading-copy">
              <span class="page-kicker">CATÁLOGO DE PRODUCTOS</span>

              <h1 id="product-page-title">
                {{ productId ? 'Editar producto' : 'Añadir producto' }}
              </h1>

              <p class="page-description">
                {{ productId
                ? 'Actualiza los datos del producto de tu tienda en ESIBuy.'
                : 'Completa los datos del producto que quieres ofrecer en ESIBuy.' }}
              </p>
            </div>
          </header>

          @if (productLoading()) {
          <output class="product-load-message">
            <span class="loading-indicator" aria-hidden="true"></span>
            Cargando producto…
          </output>
          } @else if (productLoadError(); as error) {
          <div class="submit-error" role="alert">
            <span>{{ error }}</span>
            <button type="button" (click)="loadProduct()">Reintentar</button>
          </div>
          } @else {
          <form class="product-form" [formGroup]="form" (ngSubmit)="onSubmit()" novalidate>
            <section class="form-section" aria-labelledby="product-information-heading">
              <div class="section-heading">
                <div>
                  <h2 id="product-information-heading">Información del producto</h2>
                  <p>Los campos marcados con * son obligatorios.</p>
                </div>
              </div>

              <div class="form-grid">
                <div class="form-field full-width">
                  <label for="nombre">Nombre del producto *</label>
                  <input id="nombre" type="text" formControlName="nombre" maxlength="150"
                    placeholder="Ej.: Auriculares inalámbricos" autocomplete="off" />

                  @if (form.controls.nombre.touched && form.controls.nombre.hasError('required')) {
                  <span class="field-error">El nombre es obligatorio.</span>
                  } @else if (form.controls.nombre.touched && form.controls.nombre.hasError('pattern')) {
                  <span class="field-error">El nombre no puede contener solo espacios.</span>
                  } @else if (form.controls.nombre.touched && form.controls.nombre.hasError('maxlength')) {
                  <span class="field-error">El nombre no puede superar los 150 caracteres.</span>
                  }

                  @if (serverFieldErrors.nombre) {
                  <span class="field-error" role="alert">{{ serverFieldErrors.nombre }}</span>
                  }
                </div>

                <div class="form-field full-width">
                  <label for="categoriaIds">Categorías *</label>
                  <span id="categories-hint" class="field-hint">
                    Puedes seleccionar varias categorías. Usa Ctrl o ⌘ para elegir más de una.
                  </span>

                  <select id="categoriaIds" formControlName="categoriaIds" multiple
                    [size]="categories.length > 0 ? 4 : 1" aria-describedby="categories-hint">
                    @for (category of categories; track category.id) {
                    <option [value]="category.id">{{ category.name }}</option>
                    }
                  </select>

                  @if (categoriesLoading) {
                  <output class="field-hint">Cargando categorías…</output>
                  } @else if (categoriesError) {
                  <span class="field-error" role="alert">
                    No se pudieron cargar las categorías. Vuelve a intentarlo más tarde.
                  </span>
                  } @else if (categories.length === 0) {
                  <output class="field-hint">
                    No hay categorías disponibles en este momento.
                  </output>
                  } @else if (form.controls.categoriaIds.touched && form.controls.categoriaIds.hasError('required')) {
                  <span class="field-error">Selecciona al menos una categoría.</span>
                  }

                  @if (serverFieldErrors.categoriaIds) {
                  <span class="field-error" role="alert">
                    {{ serverFieldErrors.categoriaIds }}
                  </span>
                  }
                </div>

                <div class="form-field">
                  <label for="precio">Precio (€) *</label>
                  <div class="input-with-suffix">
                    <input id="precio" type="number" formControlName="precio" min="0" step="0.01" placeholder="0,00" />
                    <span aria-hidden="true">€</span>
                  </div>

                  @if (form.controls.precio.touched && form.controls.precio.hasError('required')) {
                  <span class="field-error">El precio es obligatorio.</span>
                  } @else if (form.controls.precio.touched && form.controls.precio.hasError('min')) {
                  <span class="field-error">El precio debe ser mayor que 0.</span>
                  }

                  @if (serverFieldErrors.precio) {
                  <span class="field-error" role="alert">{{ serverFieldErrors.precio }}</span>
                  }
                </div>

                <div class="form-field">
                  <label for="stock">Unidades en stock</label>
                  <input id="stock" type="number" formControlName="stock" min="0" step="1"
                    placeholder="Se inicializa a 0 si se deja vacío" />

                  @if (form.controls.stock.touched && form.controls.stock.hasError('min')) {
                  <span class="field-error">El stock no puede ser negativo.</span>
                  } @else if (form.controls.stock.touched && form.controls.stock.hasError('pattern')) {
                  <span class="field-error">El stock debe ser un número entero.</span>
                  }

                  @if (serverFieldErrors.stock) {
                  <span class="field-error" role="alert">{{ serverFieldErrors.stock }}</span>
                  }
                </div>

                <div class="form-field full-width">
                  <label for="descripcion">Descripción</label>
                  <textarea id="descripcion" formControlName="descripcion" rows="4" maxlength="2000"
                    placeholder="Describe las características principales del producto."></textarea>

                  <span class="field-hint">
                    {{ form.controls.descripcion.value.length }} / 2000 caracteres
                  </span>

                  @if (form.controls.descripcion.touched && form.controls.descripcion.hasError('maxlength')) {
                  <span class="field-error">
                    La descripción no puede superar los 2000 caracteres.
                  </span>
                  }

                  @if (serverFieldErrors.descripcion) {
                  <span class="field-error" role="alert">
                    {{ serverFieldErrors.descripcion }}
                  </span>
                  }
                </div>
              </div>
            </section>

            <section class="form-section" aria-labelledby="discounts-heading">
              <div class="section-heading">
                <div>
                  <h2 id="discounts-heading">Descuentos</h2>
                  <p>El descuento premium sustituye al general; no se acumulan.</p>
                </div>
              </div>

              <div class="form-grid">
                <div class="form-field">
                  <label for="descuento">Descuento general</label>
                  <div class="input-with-suffix">
                    <input id="descuento" type="number" formControlName="descuento" min="0" max="100" step="0.01"
                      placeholder="Sin descuento" />
                    <span aria-hidden="true">%</span>
                  </div>

                  @if (form.controls.descuento.touched && (form.controls.descuento.hasError('min') ||
                  form.controls.descuento.hasError('max'))) {
                  <span class="field-error">El descuento debe estar entre 0 y 100 %.</span>
                  }

                  @if (serverFieldErrors.descuento) {
                  <span class="field-error" role="alert">{{ serverFieldErrors.descuento }}</span>
                  }
                </div>

                <div class="form-field">
                  <label for="descuentoPremium">Descuento premium</label>
                  <div class="input-with-suffix">
                    <input id="descuentoPremium" type="number" formControlName="descuentoPremium" min="0" max="100"
                      step="0.01" placeholder="Sin descuento" />
                    <span aria-hidden="true">%</span>
                  </div>

                  @if (form.controls.descuentoPremium.touched && (form.controls.descuentoPremium.hasError('min') ||
                  form.controls.descuentoPremium.hasError('max'))) {
                  <span class="field-error">
                    El descuento premium debe estar entre 0 y 100 %.
                  </span>
                  }

                  @if (serverFieldErrors.descuentoPremium) {
                  <span class="field-error" role="alert">
                    {{ serverFieldErrors.descuentoPremium }}
                  </span>
                  }
                </div>
              </div>
            </section>

            <section class="form-section" aria-labelledby="visibility-heading">
              <div class="section-heading">
                <div>
                  <h2 id="visibility-heading">Imagen y visibilidad</h2>
                  <p>La imagen es opcional. Puedes añadir una URL pública.</p>
                </div>
              </div>

              <div class="form-grid">
                <div class="form-field full-width">
                  <label for="imagen">URL de la imagen</label>
                  <input id="imagen" type="url" formControlName="imagen" maxlength="2000"
                    placeholder="https://ejemplo.com/imagen.jpg" autocomplete="url" />

                  <span class="field-hint">
                    Introduce una URL http o https; si no se indica, el producto se guardará sin imagen.
                  </span>

                  <div class="image-preview" [class.has-error]="previewUrl && imageError()">
                    @if (previewUrl) {
                    <img [src]="previewUrl" alt="Vista previa del producto" [hidden]="imageError()"
                      (load)="imageError.set(false)" (error)="imageError.set(true)" />

                    @if (imageError()) {
                    <span class="image-preview-text">No se pudo cargar la imagen</span>
                    }
                    } @else {
                    <span class="image-preview-text">Vista previa</span>
                    }
                  </div>

                  @if (form.controls.imagen.touched && form.controls.imagen.hasError('pattern')) {
                  <span class="field-error">
                    Introduce una URL válida que empiece por http:// o https://.
                  </span>
                  } @else if (form.controls.imagen.touched && form.controls.imagen.hasError('maxlength')) {
                  <span class="field-error">
                    La URL no puede superar los 2000 caracteres.
                  </span>
                  }

                  @if (serverFieldErrors.imagen) {
                  <span class="field-error" role="alert">
                    {{ serverFieldErrors.imagen }}
                  </span>
                  }
                </div>

                <label class="visibility-toggle" for="disponible">
                  <input id="disponible" type="checkbox" formControlName="disponible" />
                  <span class="visibility-copy">
                    <strong>Producto visible en la tienda</strong>
                    <small>Los clientes podrán encontrar este producto en ESIBuy.</small>

                    @if (serverFieldErrors.disponible) {
                    <small class="field-error" role="alert">
                      {{ serverFieldErrors.disponible }}
                    </small>
                    }
                  </span>
                </label>
              </div>
            </section>

            @if (submitSuccess()) {
            <output class="submit-success">
              {{ productId
              ? 'Producto actualizado correctamente.'
              : 'Producto registrado correctamente.' }}
            </output>
            }

            @if (submitError(); as error) {
            <div class="submit-error" role="alert">{{ error }}</div>
            }

            <footer class="form-actions">
              <a class="cancel-action" routerLink="/seller/catalog">Cancelar</a>

              <button class="submit-action" type="submit"
                [disabled]="submitting() || categoriesLoading || categoriesError || categories.length === 0">
                {{ submitting()
                ? 'Guardando…'
                : productId
                ? 'Guardar cambios'
                : 'Guardar producto' }}
              </button>
            </footer>
          </form>
          }
        </section>
      </div>
    </div>
  </div>
</main>
</file>

<file path="frontend/src/app/features/products/seller-orders/seller-orders.css">
.orders-content {
  box-sizing: border-box;
  width: min(1480px, 100%);
  margin: 0 auto;
  padding: 42px 40px 60px;
}

.topbar-link {
  color: #001a48;
  min-height: 30px;
  min-width: 45px;
  border-radius: 8px;
  display: inline-flex;
  gap: 8px;
  background-color: #b3ddfa;
  font-size: 12px;
  align-items: center;
  flex: 0 0 auto;
  padding: 0 10px;
  text-decoration: none;
  font-weight: 650;
}

.secondary-button,
.details-button {
  min-height: 36px;
  border-radius: 8px;
  font: inherit;
  font-size: 11px;
  font-weight: 650;
}

.secondary-button {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 0 14px;
  border: 1px solid #dfe5e6;
  background: #fff;
  color: #65747a;
  cursor: pointer;
}

.secondary-button.is-active {
  border-color: #42d6b2;
  background: #e9f8f4;
  color: #173247;
}

.secondary-button svg {
  width: 15px;
  height: 15px;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.8;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.orders-filter {
  position: relative;
}

.orders-filter-panel {
  position: absolute;
  top: 44px;
  right: 0;
  z-index: 2;
  display: grid;
  min-width: 280px;
  gap: 8px;
  padding: 16px;
  border: 1px solid #dce6ea;
  border-radius: 10px;
  background: #fff;
  box-shadow: 0 8px 20px rgb(23 50 71 / 12%);
}

.orders-filter-panel label {
  color: #52616c;
  font-size: 11px;
  font-weight: 650;
}

.orders-filter-panel select {
  min-height: 34px;
  padding: 0 8px;
  border: 1px solid #dce6ea;
  border-radius: 7px;
  background: #fff;
  color: #203b4e;
  font: inherit;
  font-size: 11px;
}

.date-filter-group {
  display: grid;
  gap: 7px;
  margin-top: 4px;
  color: #52616c;
  font-size: 11px;
  font-weight: 650;
}

.date-filter-fields {
  display: grid;
  grid-template-columns: auto 1fr auto 1fr;
  align-items: center;
  gap: 6px;
}

.date-filter-fields label {
  font-size: 10px;
  font-weight: 500;
}

.date-filter-fields input {
  min-height: 32px;
  min-width: 0;
  padding: 0 6px;
  border: 1px solid #dce6ea;
  border-radius: 7px;
  background: #fff;
  color: #203b4e;
  font: inherit;
  font-size: 10px;
}

.close-orders-filter {
  position: absolute;
  top: 7px;
  right: 8px;
  display: grid;
  width: 24px;
  height: 24px;
  place-items: center;
  padding: 0;
  border: 0;
  border-radius: 6px;
  background: transparent;
  color: #52616c;
  cursor: pointer;
  font: inherit;
  font-size: 20px;
  line-height: 1;
}

.close-orders-filter:hover {
  background: #edf4ff;
  color: #203b4e;
}

.clear-order-filter {
  min-height: 32px;
  padding: 0 10px;
  border: 0;
  border-radius: 7px;
  background: transparent;
  color: #4774a0;
  cursor: pointer;
  font: inherit;
  font-size: 11px;
  text-align: left;
}

.clear-order-filter:hover {
  background: #edf4ff;
}

.orders-toolbar {
  position: relative;
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 22px;
}

.orders-toolbar .orders-filter {
  margin-right: 0;
}

.status-summary {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 10px;
  margin-bottom: 20px;
}

.status-summary-card {
  display: flex;
  min-height: 70px;
  flex-direction: column;
  justify-content: space-between;
  padding: 12px 13px;
  border: 1px solid #d6e0e3;
  border-radius: 9px;
  color: #52616c;
  cursor: pointer;
  font: inherit;
  text-align: left;
  transition: border-color 0.15s, transform 0.15s;
}

.status-summary-card:hover {
  border-color: currentColor;
  transform: translateY(-1px);
}

.status-summary-card.is-selected {
  border-color: currentColor;
  box-shadow: 0 0 0 2px rgb(23 50 71 / 7%);
}

.status-summary-card span {
  font-size: 10px;
  font-weight: 650;
}

.status-summary-card strong {
  color: inherit;
  font-size: 22px;
  line-height: 1;
}

.status-summary-card.pendiente {
  background: #fff8eb;
  color: #80520e;
}

.status-summary-card.en-preparacion {
  background: #eff6ff;
  color: #24558a;
}

.status-summary-card.enviado {
  background: #f3efff;
  color: #6040a0;
}

.status-summary-card.entregado {
  background: #edf9f3;
  color: #176b4a;
}

.status-summary-card.cancelado {
  background: #fff1f1;
  color: #a52d35;
}

.orders-search {
  position: relative;
  display: flex;
  width: min(230px, 32%);
  min-width: 160px;
  flex: 0 1 230px;
  align-items: center;
}

.orders-search svg {
  position: absolute;
  left: 11px;
  width: 16px;
  height: 16px;
  fill: none;
  stroke: #72828e;
  stroke-linecap: round;
  stroke-linejoin: round;
  stroke-width: 2;
  pointer-events: none;
}

.orders-search input {
  box-sizing: border-box;
  width: 100%;
  min-height: 36px;
  padding: 0 10px 0 34px;
  border: 1px solid #dce6ea;
  border-radius: 8px;
  background: #fff;
  color: #203b4e;
  font: inherit;
  font-size: 11px;
}

.orders-search input:focus {
  border-color: #42d6b2;
  outline: none;
  box-shadow: 0 0 0 3px rgb(66 214 178 / 16%);
}

.order-count {
  flex: 0 0 auto;
  padding: 8px 12px;
  border: 1px solid #dcebe7;
  border-radius: 8px;
  color: #168c75;
  background: #eef9f5;
  font-size: 12px;
  font-weight: 750;
  white-space: nowrap;
}

.order-id {
  color: #0f343a;
  font-weight: 700;
  white-space: nowrap;
}

.product-summary {
  display: flex;
  align-items: center;
  gap: 10px;
  min-width: 170px;
  color: #3e4c51;
}

.product-icon {
  display: grid;
  width: 36px;
  height: 36px;
  flex: 0 0 36px;
  place-items: center;
  border-radius: 8px;
  background: #e6f7f5;
  color: #48c4b7;
  font-size: 17px;
}

.order-date {
  color: #69787d;
  white-space: nowrap;
}

.order-total {
  color: #26353b;
  font-weight: 750;
  white-space: nowrap;
}

.status-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 5px 9px;
  border-radius: 999px;
  font-size: 10px;
  font-weight: 650;
  white-space: nowrap;
}

.status-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: currentColor;
}

.pendiente {
  background: #fff3de;
  color: #80520e;
}

.en-preparacion {
  background: #e5f0ff;
  color: #24558a;
}

.enviado {
  background: #eee8ff;
  color: #6040a0;
}

.entregado {
  background: #e2f7ed;
  color: #176b4a;
}

.cancelado {
  background: #fde7e7;
  color: #a52d35;
}

.order-action {
  text-align: right;
}

.details-button {
  padding: 0 11px;
  border: 1px solid #d7e1e4;
  background: #eef3f5;
  color: #65747a;
  cursor: pointer;
}

.details-button:hover {
  border-color: #b8cbd0;
  background: #e4edef;
  color: #3e5962;
}

.details-button.action-button {
  border-color: #54cabe;
  background: #dff5f1;
  color: #125b5b;
}

.details-button.action-button:hover {
  border-color: #42bdb1;
  background: #c9eee8;
  color: #0f4b4e;
}

.order-detail-backdrop {
  position: fixed;
  inset: 0;
  z-index: 10;
  display: flex;
  justify-content: flex-end;
  background: rgb(15 52 58 / 32%);
}

.order-detail-panel {
  width: min(460px, 100%);
  height: 100%;
  overflow-y: auto;
  background: #fff;
  box-shadow: -8px 0 24px rgb(23 50 71 / 15%);
}

.order-detail-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 28px 28px 22px;
  border-bottom: 1px solid #e8edef;
}

.order-detail-header h2 {
  margin: 5px 0 4px;
  color: #203b4e;
  font-size: 24px;
}

.order-detail-date {
  color: #7a878c;
  font-size: 11px;
}

.close-detail-button {
  display: grid;
  width: 32px;
  height: 32px;
  place-items: center;
  padding: 0;
  border: 0;
  border-radius: 8px;
  background: #f1f5f6;
  color: #52616c;
  cursor: pointer;
  font: inherit;
  font-size: 22px;
  line-height: 1;
}

.close-detail-button:hover {
  background: #e5edef;
}

.order-detail-body {
  display: grid;
  gap: 24px;
  padding: 24px 28px 36px;
}

.detail-section {
  display: grid;
  gap: 12px;
}

.detail-section h3 {
  margin: 0;
  color: #203b4e;
  font-size: 14px;
}

.detail-product {
  display: grid;
  grid-template-columns: 48px 1fr auto;
  align-items: center;
  gap: 11px;
  padding: 10px 0;
  border-bottom: 1px solid #edf0f1;
}

.detail-product img {
  width: 48px;
  height: 48px;
  border-radius: 8px;
  object-fit: cover;
}

.detail-product div {
  display: grid;
  gap: 4px;
}

.detail-product strong,
.detail-product b {
  color: #26353b;
  font-size: 12px;
}

.detail-product span,
.detail-customer span,
.detail-customer address {
  color: #69787d;
  font-size: 11px;
  font-style: normal;
}

.detail-total {
  display: flex;
  justify-content: space-between;
  padding-top: 4px;
  color: #52616c;
  font-size: 12px;
}

.detail-total strong {
  color: #203b4e;
  font-size: 15px;
}

.detail-status-field {
  color: #52616c;
  font-size: 11px;
  font-weight: 650;
}

.detail-section select {
  min-height: 38px;
  padding: 0 10px;
  border: 1px solid #dce6ea;
  border-radius: 8px;
  background: #fff;
  color: #203b4e;
  font: inherit;
  font-size: 12px;
}

.detail-customer {
  gap: 6px;
  padding-top: 4px;
}

.detail-customer strong {
  color: #26353b;
  font-size: 13px;
}

.seller-layout a:focus-visible,
.seller-layout button:focus-visible,
.seller-layout input:focus-visible {
  outline: 3px solid #48c4b7;
  outline-offset: 3px;
}

@media (max-width: 760px) {

  .orders-content {
    padding: 30px 20px 44px;
  }

  .orders-toolbar {
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 17px;
  }

  .orders-search {
    width: min(100%, 230px);
    flex-basis: 230px;
  }

  .status-summary {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .order-count {
    margin-left: auto;
  }

  .orders-filter-panel {
    right: auto;
    left: 0;
    min-width: min(280px, calc(100vw - 40px));
  }

  .order-detail-header,
  .order-detail-body {
    padding-left: 20px;
    padding-right: 20px;
  }
}
</file>

