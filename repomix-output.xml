  margin: 0;
  color: #718694;
  font-size: 13px;
  line-height: 1.6;
}

.secondary-action {
  border-color: #d1dfe6;
  color: #27485b;
  background: #fff;
}

.secondary-action:hover:not(:disabled) {
  background: #f4f8fa;
}

.dialog-backdrop {
  position: fixed;
  z-index: 1000;
  inset: 0;
  display: grid;
  place-items: center;
  padding: 22px;
  background: rgb(9 25 38 / 66%);
  backdrop-filter: blur(4px);
  animation: fade-in .16s ease-out;
}

.dialog {
  width: min(100%, 490px);
  max-height: calc(100vh - 44px);
  overflow-y: auto;
  padding: 30px;
  border: 1px solid #dce7ec;
  border-top: 5px solid #42d6b2;
  border-radius: 17px;
  color: var(--color-text-primary);
  background: #fff;
  box-shadow: 0 28px 80px rgb(5 24 38 / 32%);
  animation: dialog-in .2s ease-out;
}

.dialog-icon {
  display: grid;
  width: 52px;
  height: 52px;
  place-items: center;
  margin-bottom: 18px;
  border-radius: 15px;
  color: #168c75;
  background: #e4f8f2;
  font-size: 28px;
  font-weight: 750;
}

.dialog-icon--danger {
  color: #c52d43;
  background: #fff0f2;
}

.dialog h2 {
  margin: 0 0 12px;
  color: var(--color-brand-dark);
  font-size: 25px;
  letter-spacing: -.5px;
}

.dialog > p {
  margin: 0 0 18px;
  color: #526a79;
  font-size: 14px;
  line-height: 1.65;
}

.dialog strong {
  color: var(--color-text-primary);
  overflow-wrap: anywhere;
}

.field-label {
  display: block;
  margin-bottom: 8px;
  color: #334f60;
  font-size: 13px;
  font-weight: 750;
}

.dialog input {
  width: 100%;
  min-height: 46px;
  padding: 0 14px;
  border: 1px solid #d8e3e9;
  border-radius: 9px;
  outline: none;
  color: #203b4e;
  background: #fbfcfd;
  font: inherit;
  font-size: 14px;
}

.field-hint,
.field-error {
  display: block;
  margin-top: 8px;
  font-size: 12px;
  line-height: 1.5;
}

.field-hint { color: #718694; }
.field-error { color: #b42318; }

.dialog-actions {
  display: flex;
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: 11px;
  margin-top: 25px;
}

.danger-action {
  color: #fff;
  background: #dc354b;
  box-shadow: 0 4px 10px rgb(220 53 75 / 16%);
}

.danger-action:hover:not(:disabled) {
  background: #bd2439;
}

.visually-hidden {
  position: absolute !important;
  width: 1px !important;
  height: 1px !important;
  padding: 0 !important;
  margin: -1px !important;
  overflow: hidden !important;
  clip: rect(0, 0, 0, 0) !important;
  white-space: nowrap !important;
  border: 0 !important;
}

@keyframes fade-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes dialog-in {
  from { opacity: 0; transform: translateY(8px) scale(.985); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

@media (max-width: 1250px) {
  .admin-content { padding: 34px 28px 50px; }
  .categories-main-card { padding: 28px; }
}

@media (max-width: 900px) {
  .admin-workspace { margin-left: 225px; }
  .admin-content { padding: 28px 20px 42px; }
  .categories-main-card { padding: 24px; }
  .page-heading { align-items: flex-start; }
}

@media (max-width: 760px) {
  .admin-workspace { margin-left: 0; }
  .admin-content { padding: 20px 14px 32px; }
  .categories-main-card { padding: 19px 15px; border-radius: 14px; }
}

@media (max-width: 560px) {
  .page-heading { align-items: stretch; flex-direction: column; gap: 18px; }
  .page-heading h1 { font-size: 30px; }
  .page-description { font-size: 14px; }
  .primary-action { width: 100%; }
  .panel-heading { align-items: flex-start; flex-direction: column; gap: 10px; padding: 18px 16px; }
  .search-field { margin: 16px 16px 14px; }
  .category-row { gap: 10px; padding: 13px 12px; }
  .category-index { display: none; }
  .category-symbol { width: 39px; height: 39px; flex-basis: 39px; }
  .row-actions { grid-template-columns: repeat(2, 35px); gap: 6px; }
  .btn-icon { width: 35px; height: 35px; }
  .dialog { padding: 24px 20px; border-radius: 14px; }
  .dialog h2 { font-size: 22px; }
  .dialog-actions { flex-direction: column-reverse; }
  .dialog-actions button { width: 100%; min-height: 46px; }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    scroll-behavior: auto !important;
    animation-duration: .01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: .01ms !important;
  }
}
</file>

<file path="frontend/src/app/features/admin/admin-user-detail/admin-user-detail.html">
<div class="admin-layout seller-shell" [class.app-sidebar-collapsed]="sidebarCollapsed()">
  <aside class="admin-sidebar admin-sidebar--shared app-sidebar" aria-label="Panel de administración">
    <button type="button" class="app-sidebar-toggle" (click)="toggleSidebar()" aria-label="Ocultar barra lateral">
      <span aria-hidden="true">‹</span>
    </button>

    <a routerLink="/" class="admin-brand" aria-label="ESIBuy">
      <span class="brand-mark" aria-hidden="true">E</span>
      <span>ESI<span class="brand-accent">Buy</span></span>
    </a>

    <p class="sidebar-caption">GESTIÓN DE ADMINISTRACIÓN</p>

    <nav class="admin-navigation" aria-label="Navegación de administración">
      <a class="navigation-link" routerLink="/admin/usuarios" routerLinkActive="is-active" ariaCurrentWhenActive="page">
        <svg class="navigation-icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M16 20v-1.5a4.5 4.5 0 0 0-4.5-4.5h-3A4.5 4.5 0 0 0 4 18.5V20"></path>
          <circle cx="10" cy="7" r="3"></circle>
          <path d="M16 11a3 3 0 1 0 0-6"></path>
          <path d="M16 14h1a4 4 0 0 1 4 4v2"></path>
        </svg>
        <span>Usuarios</span>
      </a>

      <a class="navigation-link" routerLink="/admin/altas" routerLinkActive="is-active"
        [routerLinkActiveOptions]="{ exact: true }" ariaCurrentWhenActive="page">
        <span class="navigation-icon text-icon" aria-hidden="true">＋</span>
        <span>Dar de alta Administrador</span>
      </a>

      <a class="navigation-link" routerLink="/admin/categorias" routerLinkActive="is-active"
        [routerLinkActiveOptions]="{ exact: true }" ariaCurrentWhenActive="page">
        <svg class="navigation-icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20 13 11 22l-9-9V2h11l9 9a1.4 1.4 0 0 1-2 2Z"></path>
          <circle cx="7" cy="7" r="1.2"></circle>
        </svg>
        <span>Categorías</span>
      </a>
    </nav>
  </aside>

  <button type="button" class="app-sidebar-toggle-open" (click)="toggleSidebar()" aria-label="Mostrar barra lateral"
    [hidden]="!sidebarCollapsed()">
    <span aria-hidden="true">›</span>
  </button>

  <div class="admin-workspace app-workspace">
    <main class="admin-create-container edit-page">
      <div class="main-container">
        @if (cargando()) {
        <output class="status" aria-live="polite">
          Cargando datos del usuario...
        </output>
        } @else {
        @if (successMessage()) {
        <output class="alert-box alert-success" aria-live="polite">
          {{ successMessage() }}
        </output>
        }

        @if (errorMessage()) {
        <div class="alert-box alert-danger" role="alert" aria-live="assertive">
          {{ errorMessage() }}
        </div>
        }

        <section class="card">
          <div class="card-header">
            <h1 class="card-title">
              <svg width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M16 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0zm-8 9a4 4 0 0 1 8 0v2H8v-2zm11-1h3m-1.5-1.5v3" />
              </svg>
              Editar usuario
            </h1>

            <p class="card-subtitle">
              Actualice la información de la cuenta. Los datos identificativos
              y las credenciales permanecen protegidos.
            </p>
          </div>

          <form [formGroup]="form" (ngSubmit)="onSubmit()" novalidate>
            <section class="account-section" aria-labelledby="account-heading">
              <h2 class="section-title" id="account-heading">
                Información de la cuenta
              </h2>

              <div class="form-row readonly-row">
                <div class="form-group">
                  <label class="form-label" for="accountEmail">
                    Correo electrónico
                  </label>
                  <input id="accountEmail" type="email" class="form-control readonly-control" [value]="getEmail()"
                    readonly aria-readonly="true" />
                </div>

                <div class="form-group">
                  <label class="form-label" for="accountRole">Rol</label>
                  <input id="accountRole" type="text" class="form-control readonly-control" [value]="getRole()" readonly
                    aria-readonly="true" />
                </div>

                <div class="form-group">
                  <label class="form-label" for="accountCredential">
                    Contraseña
                  </label>
                  <input id="accountCredential" type="password" class="form-control readonly-control"
                    [value]="credentialMask" readonly aria-readonly="true" autocomplete="off" />
                </div>
              </div>

              <p class="locked-indicator">
                El correo, el rol y la contraseña no se pueden cambiar desde
                esta pantalla.
              </p>
            </section>

            <section class="editable-section" aria-labelledby="editable-heading">
              <h2 class="section-title" id="editable-heading">
                Datos editables
              </h2>

              <div class="form-row">
                <div class="form-group">
                  <label class="form-label" for="firstName">
                    Nombre <span class="required">*</span>
                  </label>
                  <input id="firstName" type="text" formControlName="firstName" class="form-control"
                    autocomplete="given-name"
                    [attr.aria-invalid]="form.controls.firstName.invalid && form.controls.firstName.touched" />
                  @if (form.controls.firstName.touched && form.controls.firstName.invalid) {
                  <small class="field-error">
                    Indique un nombre válido de 2 a 25 caracteres.
                  </small>
                  }
                </div>

                <div class="form-group">
                  <label class="form-label" for="lastName">
                    Apellidos <span class="required">*</span>
                  </label>
                  <input id="lastName" type="text" formControlName="lastName" class="form-control"
                    autocomplete="family-name"
                    [attr.aria-invalid]="form.controls.lastName.invalid && form.controls.lastName.touched" />
                  @if (form.controls.lastName.touched && form.controls.lastName.invalid) {
                  <small class="field-error">
                    Indique apellidos válidos de 2 a 50 caracteres.
                  </small>
                  }
                </div>

                @if (isClient()) {
                <div class="form-group">
                  <label class="form-label" for="birthDate">
                    Fecha de nacimiento <span class="required">*</span>
                  </label>
                  <input id="birthDate" type="date" formControlName="birthDate" class="form-control"
                    [attr.aria-invalid]="form.controls.birthDate.invalid && form.controls.birthDate.touched" />
                  @if (form.controls.birthDate.touched && form.controls.birthDate.errors?.['required']) {
                  <small class="field-error">
                    La fecha de nacimiento es obligatoria.
                  </small>
                  }
                  @if (form.controls.birthDate.touched && form.controls.birthDate.errors?.['underAge']) {
                  <small class="field-error">
                    Debes ser mayor de 18 años para registrarte.
                  </small>
                  }
                </div>

                <div class="form-group">
                  <label class="form-label" for="clientNationalId">
                    DNI <span class="required">*</span>
                  </label>
                  <input id="clientNationalId" type="text" formControlName="nationalId" class="form-control"
                    autocomplete="off"
                    [attr.aria-invalid]="form.controls.nationalId.invalid && form.controls.nationalId.touched" />
                  @if (form.controls.nationalId.touched && form.controls.nationalId.errors?.['required']) {
                  <small class="field-error">El DNI es obligatorio.</small>
                  }
                  @if (form.controls.nationalId.touched && form.controls.nationalId.errors?.['maxlength']) {
                  <small class="field-error">
                    El documento no puede superar los 20 caracteres.
                  </small>
                  }
                </div>

                <div class="form-group">
                  <label class="form-label" for="clientPhone">Teléfono</label>
                  <input id="clientPhone" type="tel" formControlName="phone" class="form-control" autocomplete="tel"
                    inputmode="numeric" placeholder="Ej: 600112233" maxlength="9"
                    [attr.aria-invalid]="form.controls.phone.invalid && form.controls.phone.touched" />
                  @if (form.controls.phone.touched && form.controls.phone.errors?.['pattern']) {
                  <small class="field-error">
                    El teléfono debe contener exactamente 9 dígitos numéricos.
                  </small>
                  }
                </div>
                }

                @if (isSeller()) {
                <div class="form-group">
                  <label class="form-label" for="defaultCategory">
                    Categoría por defecto <span class="required">*</span>
                  </label>
                  <select id="defaultCategory" formControlName="defaultCategory" class="form-control"
                    (change)="categorySelectionUnavailable.set(false)"
                    [attr.aria-invalid]="form.controls.defaultCategory.invalid && form.controls.defaultCategory.touched">
                    @for (cat of categories; track cat) {
                    <option [value]="cat">{{ cat }}</option>
                    }
                  </select>

                  @if (categoriesLoadError()) {
                  <small class="field-error" role="alert">
                    No se pudieron cargar las categorías actuales. Recarga
                    la página para volver a intentarlo.
                  </small>
                  } @else if (categorySelectionUnavailable()) {
                  <small class="field-error" role="alert">
                    La categoría guardada ya no está disponible. Selecciona
                    una de las categorías actuales.
                  </small>
                  } @else if (categories.length === 0) {
                  <small class="field-error" role="alert">
                    No hay categorías disponibles.
                  </small>
                  }

                  @if (form.controls.defaultCategory.touched && form.controls.defaultCategory.errors?.['required']) {
                  <small class="field-error">
                    La categoría por defecto es obligatoria.
                  </small>
                  }
                </div>

                <div class="form-group">
                  <label class="form-label" for="businessName">
                    Nombre comercial / tienda <span class="required">*</span>
                  </label>
                  <input id="businessName" type="text" formControlName="businessName" class="form-control"
                    placeholder="Ej. Tienda Central"
                    [attr.aria-invalid]="form.controls.businessName.invalid && form.controls.businessName.touched" />
                  @if (form.controls.businessName.touched && form.controls.businessName.errors?.['required']) {
                  <small class="field-error">
                    El nombre comercial es obligatorio.
                  </small>
                  }
                  @if (form.controls.businessName.touched && (form.controls.businessName.errors?.['minlength'] ||
                  form.controls.businessName.errors?.['maxlength'])) {
                  <small class="field-error">
                    Debe tener entre 2 y 100 caracteres.
                  </small>
                  }
                </div>

                <div class="form-group">
                  <label class="form-label" for="sellerNationalId">
                    DNI / NIF <span class="required">*</span>
                  </label>
                  <input id="sellerNationalId" type="text" formControlName="nationalId" class="form-control"
                    autocomplete="off"
                    [attr.aria-invalid]="form.controls.nationalId.invalid && form.controls.nationalId.touched" />
                  @if (form.controls.nationalId.touched && form.controls.nationalId.errors?.['required']) {
                  <small class="field-error">El DNI/NIF es obligatorio.</small>
                  }
                  @if (form.controls.nationalId.touched && form.controls.nationalId.errors?.['maxlength']) {
                  <small class="field-error">
                    El documento no puede superar los 20 caracteres.
                  </small>
                  }
                </div>

                <div class="form-group">
                  <label class="form-label" for="sellerPhone">Teléfono</label>
                  <input id="sellerPhone" type="tel" formControlName="phone" class="form-control" autocomplete="tel"
                    inputmode="numeric" placeholder="Ej: 600112233" maxlength="9"
                    [attr.aria-invalid]="form.controls.phone.invalid && form.controls.phone.touched" />
                  @if (form.controls.phone.touched && form.controls.phone.errors?.['pattern']) {
                  <small class="field-error">
                    El teléfono debe contener exactamente 9 dígitos numéricos.
                  </small>
                  }
                </div>
                }

                @if (isAdmin()) {
                <div class="form-group">
                  <label class="form-label" for="adminNationalId">
                    DNI / Documento <span class="required">*</span>
                  </label>
                  <input id="adminNationalId" type="text" formControlName="nationalId" class="form-control"
                    autocomplete="off"
                    [attr.aria-invalid]="form.controls.nationalId.invalid && form.controls.nationalId.touched" />
                  @if (form.controls.nationalId.touched && form.controls.nationalId.errors?.['required']) {
                  <small class="field-error">El DNI es obligatorio.</small>
                  }
                  @if (form.controls.nationalId.touched && form.controls.nationalId.errors?.['maxlength']) {
                  <small class="field-error">
                    El documento no puede superar los 20 caracteres.
                  </small>
                  }
                </div>

                <div class="form-group">
                  <label class="form-label" for="headquarters">Sede</label>
                  <input id="headquarters" type="text" formControlName="headquarters" class="form-control"
                    placeholder="Ej. Ciudad Real"
                    [attr.aria-invalid]="form.controls.headquarters.invalid && form.controls.headquarters.touched" />
                  @if (form.controls.headquarters.touched && form.controls.headquarters.errors?.['maxlength']) {
                  <small class="field-error">
                    La sede no puede superar los 100 caracteres.
                  </small>
                  }
                </div>
                }

                @if (!isClient() && !isSeller() && !isAdmin()) {
                <div class="form-group">
                  <label class="form-label" for="otherNationalId">
                    DNI / Documento <span class="required">*</span>
                  </label>
                  <input id="otherNationalId" type="text" formControlName="nationalId" class="form-control"
                    autocomplete="off"
                    [attr.aria-invalid]="form.controls.nationalId.invalid && form.controls.nationalId.touched" />
                  @if (form.controls.nationalId.touched && form.controls.nationalId.errors?.['required']) {
                  <small class="field-error">El DNI es obligatorio.</small>
                  }
                  @if (form.controls.nationalId.touched && form.controls.nationalId.errors?.['maxlength']) {
                  <small class="field-error">
                    El documento no puede superar los 20 caracteres.
                  </small>
                  }
                </div>

                <div class="form-group">
                  <label class="form-label" for="otherPhone">Teléfono</label>
                  <input id="otherPhone" type="tel" formControlName="phone" class="form-control" autocomplete="tel"
                    inputmode="numeric" placeholder="Ej: 600112233" maxlength="9"
                    [attr.aria-invalid]="form.controls.phone.invalid && form.controls.phone.touched" />
                  @if (form.controls.phone.touched && form.controls.phone.errors?.['pattern']) {
                  <small class="field-error">
                    El teléfono debe contener exactamente 9 dígitos numéricos.
                  </small>
                  }
                </div>
                }
              </div>

              <div class="avatar-section">
                <span class="form-label">Imagen de perfil</span>
                <p class="avatar-help-text">
                  Selecciona el avatar que quieres utilizar.
                </p>

                <div class="avatar-selector-grid">
                  @for (avatar of currentAvatarList; track avatar) {
                  <button type="button" class="avatar-item" [class.selected]="selectedAvatar === avatar"
                    (click)="selectAvatar(avatar)" [attr.aria-label]="'Seleccionar avatar'">
                    <img [src]="avatar" alt="Avatar disponible" />
                    @if (selectedAvatar === avatar) {
                    <span class="avatar-check" aria-hidden="true">✓</span>
                    }
                  </button>
                  }
                </div>
              </div>
            </section>

            <footer class="btn-wrapper">
              <a class="btn btn-secondary" routerLink="/admin/usuarios">
                Cancelar
              </a>
              <button class="btn btn-primary" type="submit" [disabled]="guardando()">
                {{ guardando() ? 'Guardando...' : 'Guardar cambios' }}
              </button>
            </footer>
          </form>
        </section>
        }
      </div>
    </main>
  </div>
</div>
</file>

<file path="frontend/src/app/features/admin/admin-user-list/admin-user-list.css">
:host {
  display: block;
  min-height: 100vh;
  color: var(--color-text-primary);
  font-family: Inter, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  font-size: 15px;
  -webkit-font-smoothing: antialiased;
}:host *,
:host *::before,
:host *::after {
  box-sizing: border-box;
}.admin-layout {
  --navy: var(--color-brand-dark);
  --navy-deep: #0a2435;
  --teal: var(--color-brand-accent);
  --teal-dark: #168c75;
  --ink: var(--color-text-primary);
  --muted: #72828e;
  --line: #dfe8ed;

  min-height: 100vh;
  background: #edf2f8;
}.primary-action:focus-visible {
  outline: 3px solid #8df0dc;
  outline-offset: 4px;
}.eyebrow {
  margin: 0;
  color: #91a5b2;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 1.35px;
}/* Área principal */

.admin-workspace {
  min-height: 100vh;
  margin-left: 248px;
}.admin-content {
  width: min(1480px, 100%);
  margin: 0 auto;
  padding: 42px 40px 60px;
}/* Único recuadro blanco para toda la gestión */

.users-main-card {
  width: 100%;
  min-width: 0;
  padding: 32px;
  border: 1px solid #e1e9f0;
  border-radius: 18px;
  background: #fff;
  box-shadow:
    0 8px 28px rgb(25 48 70 / 5%),
    0 1px 3px rgb(25 48 70 / 3%);
}/* Encabezado dentro del recuadro */

.page-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  margin: 0 0 25px;
  padding: 0 0 25px;
  border-bottom: 1px solid #e8eef3;
}.page-heading-copy {
  min-width: 0;
  flex: 1 1 auto;
}.page-heading .eyebrow {
  margin: 0 0 10px;
  color: #168c75;
}.page-heading h1 {
  margin: 0 0 10px;
  color: var(--ink);
  font-size: clamp(30px, 2.6vw, 38px);
  font-weight: 780;
  letter-spacing: -1.25px;
  line-height: 1.15;
}.page-description {
  margin: 0;
  color: #687d8b;
  font-size: 15px;
  line-height: 1.6;
}.primary-action {
  display: inline-flex;
  min-height: 48px;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  gap: 10px;
  padding: 0 19px;
  border: 1px solid var(--teal);
  border-radius: 10px;
  color: var(--color-brand-dark);
  background: var(--teal);
  box-shadow: 0 5px 13px rgb(25 157 130 / 13%);
  font-size: 14px;
  font-weight: 750;
  text-decoration: none;
  transition: background-color .18s ease, box-shadow .18s ease, transform .18s ease;
}.primary-action svg {
  width: 19px;
  height: 19px;
  flex: 0 0 auto;
  fill: none;
  stroke: currentColor;
  stroke-width: 2;
  stroke-linecap: round;
  stroke-linejoin: round;
}.primary-action:hover {
  transform: translateY(-1px);
  background: #2bc4a2;
  box-shadow: 0 8px 18px rgb(25 157 130 / 20%);
}/* Mensajes */

.success-alert,
.error-alert {
  display: flex;
  align-items: flex-start;
  gap: 11px;
  margin: 0 0 22px;
  padding: 15px 17px;
  border: 1px solid;
  border-radius: 10px;
  font-size: 14px;
  line-height: 1.5;
}.success-alert {
  color: #0c6654;
  background: #e8fbf5;
  border-color: #b5eddf;
  border-left: 4px solid #1bb89b;
}.success-alert svg {
  width: 20px;
  height: 20px;
  flex: 0 0 auto;
  fill: none;
  stroke: currentColor;
  stroke-width: 2;
  stroke-linecap: round;
  stroke-linejoin: round;
}.error-alert {
  display: block;
  color: #a52232;
  background: #fff1f2;
  border-color: #fecdd3;
  border-left: 4px solid #e11d48;
}/* Filtros: sin tarjeta propia */

.filters-bar {
  display: flex;
  align-items: center;
  gap: 15px;
  margin-bottom: 22px;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
}.search-field {
  position: relative;
  display: flex;
  min-width: 240px;
  flex: 1 1 auto;
  align-items: center;
}.search-field svg {
  position: absolute;
  left: 15px;
  width: 19px;
  height: 19px;
  fill: none;
  stroke: #718593;
  stroke-width: 2;
  stroke-linecap: round;
  stroke-linejoin: round;
  pointer-events: none;
}.search-field input,
.filter-controls select {
  width: 100%;
  min-height: 46px;
  border: 1px solid #d8e3e9;
  border-radius: 9px;
  color: #203b4e;
  background: #fbfcfd;
  font: inherit;
  font-size: 14px;
  transition: border-color .18s ease, box-shadow .18s ease, background .18s ease;
}.search-field input {
  padding: 0 14px 0 44px;
}.filter-controls {
  display: flex;
  flex: 0 0 auto;
  gap: 12px;
}.filter-controls select {
  min-width: 185px;
  padding: 0 38px 0 13px;
  cursor: pointer;
}.search-field input:focus,
.filter-controls select:focus {
  border-color: #42cdb0;
  outline: none;
  background: #fff;
  box-shadow: 0 0 0 4px rgb(66 214 178 / 15%);
}.visually-hidden {
  position: absolute !important;
  width: 1px !important;
  height: 1px !important;
  padding: 0 !important;
  margin: -1px !important;
  overflow: hidden !important;
  clip: rect(0, 0, 0, 0) !important;
  white-space: nowrap !important;
  border: 0 !important;
}/* Estado de carga */

.loading-spinner {
  display: grid;
  justify-items: center;
  gap: 15px;
  padding: 70px 20px;
  color: #627b8b;
  font-size: 15px;
}.loading-spinner p {
  margin: 0;
}.spinner {
  display: inline-block;
  width: 34px;
  height: 34px;
  border: 4px solid #ccefe7;
  border-top-color: #168c75;
  border-radius: 50%;
  animation: spin .8s linear infinite;
}

@keyframes spin {to {
    transform: rotate(360deg);
  }
}/* Tabla */

.table-container {
  width: 100%;
  overflow: auto;
  border: 1px solid #dfe8ed;
  border-radius: 14px;
  background: #fff;
  box-shadow: 0 8px 24px rgb(16 44 64 / 5%);
  scrollbar-width: thin;
  scrollbar-color: #b9cbd4 #f5f8fa;
}.user-table {
  width: 100%;
  min-width: 1120px;
  border-collapse: separate;
  border-spacing: 0;
  table-layout: auto;
  text-align: left;
}.col-user { width: 25%; }.col-contact { width: 25%; }.col-role { width: 13%; }.col-status { width: 13%; }.col-date { width: 10%; }.col-actions {
  width: 150px;
  min-width: 150px;
  white-space: nowrap;
}.user-table th {
  padding: 17px 18px;
  color: #657b89;
  background: #f6f9fb;
  border-bottom: 1px solid #e1e9ee;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: .8px;
  text-transform: uppercase;
  white-space: nowrap;
}.user-table th:first-child {
  padding-left: 22px;
}.user-table td {
  padding: 18px;
  border-bottom: 1px solid #edf1f4;
  color: #405b6c;
  font-size: 13px;
  line-height: 1.45;
  vertical-align: middle;
}.user-table td:first-child {
  padding-left: 22px;
}.user-table tbody tr {
  transition: background-color .16s ease;
}.user-table tbody tr:hover {
  background: #f8fcfb;
}.user-table tbody tr:last-child td {
  border-bottom: 0;
}.user-table td.col-status {
  text-align: center;
}/* Información de usuario */

.user-cell-wrapper {
  display: flex;
  min-width: 0;
  max-width: 100%;
  align-items: center;
  gap: 12px;
}.avatar-img {
  width: 46px;
  height: 46px;
  flex: 0 0 46px;
  border: 2px solid #e0e9ee;
  border-radius: 50%;
  object-fit: cover;
  background: #f1f6f8;
}.user-info {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 3px;
}.user-name {
  display: block;
  overflow: hidden;
  color: #123248;
  font-size: 14px;
  font-weight: 750;
  text-overflow: ellipsis;
  white-space: nowrap;
}.user-id,
.user-site,
.text-muted {
  color: #718694;
  font-size: 12px;
}.user-id,
.user-site {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}.user-site {
  color: #4774a0;
}.contact-item {
  min-width: 0;
}.email-text {
  display: block;
  overflow: hidden;
  color: #2e4d62;
  font-size: 13px;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}.phone-text,
.sede-text {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 6px;
  margin-top: 6px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}.phone-text span,
.sede-text span {
  overflow: hidden;
  text-overflow: ellipsis;
}.phone-icon,
.location-icon {
  width: 15px;
  height: 15px;
  flex: 0 0 15px;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.8;
  stroke-linecap: round;
  stroke-linejoin: round;
}.sede-text {
  max-width: 100%;
  margin-top: 8px;
}/* Insignias de rol */

.badge {
  display: inline-flex;
  align-items: center;
  padding: 5px 10px;
  border: 1px solid transparent;
  border-radius: 7px;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: .2px;
  white-space: nowrap;
}.badge-admin {
  color: #2451a6;
  background: #e8efff;
  border-color: #d5e1ff;
}.badge-seller {
  color: #925900;
  background: #fff3dc;
  border-color: #f5e0b2;
}.badge-client {
  color: #08735d;
  background: #e2f8ef;
  border-color: #c4eddd;
}.badge-default {
  color: #3a5871;
  background: #edf5f7;
  border-color: #dbe8ed;
}/* Estado de las cuentas */

.status-indicator {
  display: inline-flex;
  min-height: 35px;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 7px 11px;
  border: 1px solid transparent;
  border-radius: 999px;
  font: inherit;
  font-size: 12px;
  font-weight: 750;
  white-space: nowrap;
}.status-clickable {
  cursor: pointer;
  transition: background-color .18s ease, border-color .18s ease, transform .18s ease;
}.status-clickable.status-active {
  color: #08735d;
  background: #e5f8f1;
  border-color: #b8e8d9;
}.status-clickable.status-inactive {
  color: #8a5a08;
  background: #fff5dc;
  border-color: #f0d99e;
}.status-clickable:hover:not(:disabled) {
  transform: translateY(-1px);
}.status-clickable.status-active:hover:not(:disabled) {
  background: #d5f1e9;
  border-color: #8dd8c2;
}.status-clickable.status-inactive:hover:not(:disabled) {
  background: #ffedbd;
  border-color: #e6c875;
}.status-clickable:disabled,
.btn-icon:disabled,
.dialog-actions button:disabled {
  cursor: not-allowed;
  opacity: .55;
}.blocked-status {
  color: #a84f41;
  background: #fff0ed;
  border-color: #f1c8c0;
}.status-dot {
  display: inline-block;
  width: 8px;
  height: 8px;
  flex: 0 0 8px;
  border-radius: 50%;
}.status-dot.active {
  background: #1bb89b;
  box-shadow: 0 0 0 3px rgb(27 184 155 / 13%);
}.status-dot.inactive {
  background: #93a9b5;
}.status-dot.blocked {
  background: #d86a5b;
  box-shadow: 0 0 0 3px rgb(216 106 91 / 12%);
}/* Acciones de la tabla */

.actions-wrapper {
  display: grid;
  grid-template-columns: repeat(3, 38px);
  align-items: center;
  justify-content: space-between;
  width: 130px;
  gap: 8px;
}.action-spacer {
  display: block;
  width: 38px;
  height: 38px;
  pointer-events: none;
}.btn-icon {
  display: inline-grid;
  width: 38px;
  height: 38px;
  flex: 0 0 38px;
  place-items: center;
  padding: 0;
  border: 1px solid transparent;
  border-radius: 9px;
  color: #3a5871;
  background: #f1f6f8;
  cursor: pointer;
  transition: background-color .18s ease, color .18s ease, border-color .18s ease, transform .18s ease;
}.btn-icon:hover:not(:disabled) {
  transform: translateY(-1px);
}.btn-icon svg {
  width: 18px;
  height: 18px;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.9;
  stroke-linecap: round;
  stroke-linejoin: round;
}.btn-edit:hover:not(:disabled) {
  color: #0a2c3a;
  background: #e3f8f2;
  border-color: #b9ebdf;
}.btn-lock {
  color: #168c75;
  background: #e9f7f3;
}.btn-lock:hover:not(:disabled) {
  background: #d5f1e9;
  border-color: #a8dfd0;
}.btn-lock.is-blocked,
.btn-delete {
  color: #a84f41;
  background: #fff0ed;
}.btn-lock.is-blocked:hover:not(:disabled),
.btn-delete:hover:not(:disabled) {
  background: #fde1db;
  border-color: #e3b8b1;
}.btn-icon:focus-visible,
.status-clickable:focus-visible,
.dialog-actions button:focus-visible {
  outline: 3px solid rgb(66 214 178 / 55%);
  outline-offset: 3px;
}/* Sin resultados */

.empty-state {
  display: grid;
  justify-items: center;
  gap: 8px;
  padding: 55px 20px;
  color: #718694;
  text-align: center;
}.empty-state p {
  margin: 0;
  color: #27485b;
  font-size: 16px;
  font-weight: 700;
}.empty-state > span:last-child {
  font-size: 13px;
}.empty-state-mark {
  display: grid;
  width: 48px;
  height: 48px;
  place-items: center;
  margin-bottom: 5px;
  border-radius: 15px;
  color: #168c75;
  background: #e4f8f2;
  font-size: 30px;
}/* Modal de eliminación */

.modal-backdrop {
  position: fixed;
  z-index: 1000;
  inset: 0;
  display: grid;
  place-items: center;
  padding: 22px;
  background: rgb(9 25 38 / 66%);
  backdrop-filter: blur(4px);
  animation: fade-in .16s ease-out;
}.delete-dialog {
  width: min(100%, 490px);
  max-height: calc(100vh - 44px);
  overflow-y: auto;
  padding: 30px;
  border: 1px solid #dce7ec;
  border-top: 5px solid #e11d48;
  border-radius: 17px;
  color: var(--color-text-primary);
  background: #fff;
  box-shadow: 0 28px 80px rgb(5 24 38 / 32%);
  animation: dialog-in .2s ease-out;
}.dialog-icon {
  display: grid;
  width: 52px;
  height: 52px;
  place-items: center;
  margin-bottom: 18px;
  border-radius: 15px;
  color: #c52d43;
  background: #fff0f2;
}.dialog-icon svg {
  width: 25px;
  height: 25px;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.8;
  stroke-linecap: round;
  stroke-linejoin: round;
}.dialog-eyebrow {
  margin: 0 0 7px !important;
  color: #a84f41;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 1.15px;
}.delete-dialog h2 {
  margin: 0 0 12px;
  color: var(--color-brand-dark);
  font-size: 25px;
  letter-spacing: -.5px;
}.delete-dialog p {
  color: #526a79;
  font-size: 14px;
  line-height: 1.65;
}.delete-dialog strong {
  color: var(--color-text-primary);
  overflow-wrap: anywhere;
}.delete-warning {
  margin-top: 18px;
  padding: 13px 15px;
  border: 1px solid #f7d5d9;
  border-left: 4px solid #e11d48;
  border-radius: 8px;
  color: #8d2635 !important;
  background: #fff5f6;
}.dialog-actions {
  display: flex;
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: 11px;
  margin-top: 25px;
}.dialog-actions button {
  min-height: 44px;
  padding: 0 17px;
  border: 1px solid transparent;
  border-radius: 9px;
  font: inherit;
  font-size: 13px;
  font-weight: 750;
  cursor: pointer;
  transition: background-color .18s ease, transform .18s ease;
}.dialog-actions button:hover:not(:disabled) {
  transform: translateY(-1px);
}.btn-secondary {
  color: #27485b;
  background: #fff;
  border-color: #d1dfe6 !important;
}.btn-secondary:hover:not(:disabled) {
  background: #f4f8fa;
}.btn-danger {
  color: #fff;
  background: #dc354b;
  box-shadow: 0 4px 10px rgb(220 53 75 / 16%);
}.btn-danger:hover:not(:disabled) {
  background: #bd2439;
}

@keyframes fade-in {from { opacity: 0; }to { opacity: 1; }
}

@keyframes dialog-in {from {
    opacity: 0;
    transform: translateY(8px) scale(.985);
  }to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}/* Adaptación a pantallas medianas */

@media (max-width: 1250px) {
  .admin-content {
    padding: 34px 28px 50px;
  }

  .users-main-card {
    padding: 28px;
  }

  .page-heading {
    align-items: flex-start;
  }

  .filter-controls select {
    min-width: 165px;
  }

  .user-table {
    min-width: 1080px;
  }
}/* Adaptación a tablets */

@media (max-width: 900px) {
  .admin-workspace {
    margin-left: 225px;
  }

  .admin-content {
    padding: 28px 20px 42px;
  }

  .users-main-card {
    padding: 24px;
  }

  .page-heading {
    flex-direction: column;
    align-items: stretch;
    gap: 18px;
  }

  .primary-action {
    align-self: flex-start;
  }

  .filters-bar {
    align-items: stretch;
    flex-direction: column;
  }

  .search-field {
    min-width: 0;
  }

  .filter-controls {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .filter-controls select {
    min-width: 0;
  }
}/* Adaptación a móviles */

@media (max-width: 680px) {
  .admin-content {
    padding: 20px 12px 32px;
  }

  .users-main-card {
    padding: 19px 15px;
    border-radius: 14px;
  }

  .page-heading {
    margin-bottom: 22px;
    padding-bottom: 21px;
  }

  .page-heading h1 {
    font-size: 30px;
  }

  .page-description {
    font-size: 14px;
  }

  .primary-action {
    width: 100%;
    min-height: 47px;
    align-self: stretch;
  }

  .filters-bar {
    gap: 12px;
    padding: 0;
    border-radius: 0;
  }

  .filter-controls {
    grid-template-columns: 1fr;
    gap: 10px;
  }

  .search-field input,
  .filter-controls select {
    min-height: 45px;
    font-size: 14px;
  }

  .table-container {
    border-radius: 11px;
  }

  .user-table {
    min-width: 1050px;
  }

  .user-table th {
    padding: 14px 13px;
    font-size: 10px;
  }

  .user-table td {
    padding: 14px 13px;
    font-size: 12px;
  }

  .user-table th:first-child,
  .user-table td:first-child {
    padding-left: 15px;
  }

  .avatar-img {
    width: 40px;
    height: 40px;
    flex-basis: 40px;
  }

  .user-name {
    font-size: 13px;
  }

  .actions-wrapper {
    width: 117px;
    grid-template-columns: repeat(3, 35px);
    gap: 6px;
  }

  .action-spacer {
    width: 35px;
    height: 35px;
  }

  .btn-icon {
    width: 35px;
    height: 35px;
    flex-basis: 35px;
  }

  .delete-dialog {
    padding: 24px 20px;
    border-radius: 14px;
  }

  .delete-dialog h2 {
    font-size: 22px;
  }

  .dialog-actions {
    flex-direction: column-reverse;
  }

  .dialog-actions button {
    width: 100%;
    min-height: 46px;
  }
}/* Respeta la preferencia de reducir movimiento */

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    animation-duration: .01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: .01ms !important;
  }
}
