<div class="profile-page">

    <!-- BARRA LATERAL -->
    <app-profile-shell [avatar]="selectedAvatar()" [displayName]="fullName()" fallbackName="Administrador"
        avatarAlt="Perfil del administrador" badgeLabel="Administrador" [sections]="shellSections"
        [activeSection]="activeSection()" [logoutError]="logoutError()" (sectionChange)="selectSection($any($event))"
        (back)="goBack()" (logout)="logout()">
    </app-profile-shell>

    <!-- CONTENIDO PRINCIPAL -->
    <main class="profile-main">

        @if (loading()) {
        <section class="panel">
            <output class="panel-description">
                Cargando los datos de tu perfil...
            </output>
        </section>
        } @else if (profileError(); as error) {
        <section class="panel">
            <h1 class="panel-title">Mi perfil</h1>

            <p class="form-error" role="alert">{{ error }}</p>

            <button type="button" class="primary-button" (click)="loadProfile()">
                Reintentar
            </button>
        </section>
        } @else if (profile(); as admin) {

        <!-- DATOS PERSONALES -->
        @if (activeSection() === 'personal') {
        <section class="panel">

            <div class="panel-heading">
                <div class="panel-heading-text">
                    <span class="eyebrow">CUENTA DE ADMINISTRADOR</span>

                    <h1 class="panel-title">Mi perfil</h1>

                    <p class="panel-description">
                        Consulta y actualiza tus datos personales y la información
                        de tu puesto en ESIBuy.
                    </p>
                </div>

                @if (!editing()) {
                <button type="button" class="primary-button" (click)="startEditing()">
                    Editar perfil
                </button>
                }
            </div>

            @if (editSuccess(); as message) {
            <output class="success-message">{{ message }}</output>
            }

            @if (editError(); as error) {
            <p class="form-error" role="alert">{{ error }}</p>
            }

            <form (ngSubmit)="saveProfile()">

                <h2 class="section-title">Datos personales</h2>

                <div class="field-grid">

                    <div class="field">
                        <label for="firstName">Nombre <span>*</span></label>

                        @if (editing()) {
                        <input id="firstName" name="firstName" type="text" [(ngModel)]="editForm.firstName" required
                            minlength="2" maxlength="25" autocomplete="given-name" [disabled]="saving()" />
                        } @else {
                        <input id="firstName" type="text" [value]="admin.firstName || ''" readonly />
                        }
                    </div>

                    <div class="field">
                        <label for="lastName">Apellidos <span>*</span></label>

                        @if (editing()) {
                        <input id="lastName" name="lastName" type="text" [(ngModel)]="editForm.lastName" required
                            minlength="2" maxlength="50" autocomplete="family-name" [disabled]="saving()" />
                        } @else {
                        <input id="lastName" type="text" [value]="admin.lastName || ''" readonly />
                        }
                    </div>

                    <div class="field">
                        <label for="email">Correo electrónico</label>
                        <input id="email" type="email" [value]="admin.email || ''" readonly />
                        <small>El correo electrónico no se puede modificar.</small>
                    </div>

                    <div class="field">
                        <label for="phone">Teléfono</label>
                        <input id="phone" type="text" [value]="admin.phone || 'No indicado'" readonly />
                    </div>

                    <div class="field">
                        <label for="nationalId">Documento de identidad</label>

                        @if (editing()) {
                        <input id="nationalId" name="nationalId" type="text" [(ngModel)]="editForm.nationalId"
                            maxlength="20" autocomplete="off" placeholder="Introduce un documento nuevo"
                            [disabled]="saving()" />
                        <small>Déjalo vacío para mantener el documento actual.</small>
                        } @else {
                        <input id="nationalId" type="text" [value]="admin.maskedNationalId || 'No disponible'"
                            readonly />
                        }
                    </div>

                </div>

                <div class="job-section">
                    <h2 class="section-title">Información del puesto</h2>

                    <div class="field-grid">

                        <div class="field">
                            <label for="headquarters">Sede central</label>

                            @if (editing()) {
                            <input id="headquarters" name="headquarters" type="text" [(ngModel)]="editForm.headquarters"
                                maxlength="100" [disabled]="saving()" />
                            } @else {
                            <input id="headquarters" type="text" [value]="admin.headquarters || 'No indicada'"
                                readonly />
                            }
                        </div>

                        <div class="field">
                            <label for="hireDate">Fecha de incorporación</label>
                            <input id="hireDate" type="text" [value]="formattedHireDate()" readonly />

                            @if (editing()) {
                            <small>Este dato no se puede modificar desde el perfil.</small>
                            }
                        </div>

                    </div>
                </div>

                @if (editing()) {
                <div class="avatar-section">
                    <h2 class="section-title">Imagen de perfil</h2>

                    <p class="section-description">
                        Selecciona uno de los avatares disponibles.
                    </p>

                    <fieldset class="avatar-selector-grid">
                        <legend>Seleccionar avatar</legend>

                        @for (avatar of adminAvatars; track avatar; let i = $index) {
                        <button type="button" class="avatar-item" [class.selected]="selectedAvatar() === avatar"
                            [attr.aria-pressed]="selectedAvatar() === avatar"
                            [attr.aria-label]="'Seleccionar avatar ' + (i + 1)" [disabled]="saving()"
                            (click)="selectAvatar(avatar)">

                            <img [src]="avatar" [alt]="'Avatar ' + (i + 1)" />

                            @if (selectedAvatar() === avatar) {
                            <span class="avatar-check" aria-hidden="true">✓</span>
                            }
                        </button>
                        }
                    </fieldset>
                </div>
                }

                @if (editing()) {
                <div class="form-actions">
                    <button type="button" class="secondary-button" [disabled]="saving()" (click)="cancelEditing()">
                        Cancelar
                    </button>

                    <button type="submit" class="primary-button" [disabled]="saving()">
                        {{ saving() ? 'Guardando...' : 'Guardar cambios' }}
                    </button>
                </div>
                }

            </form>
        </section>

        <!-- ZONA DE PELIGRO -->
        <section class="panel danger-zone" aria-labelledby="danger-zone-title">
            <div class="panel-heading">
                <div class="panel-heading-text">
                    <span class="eyebrow">ACCIONES IRREVERSIBLES</span>

                    <h2 id="danger-zone-title" class="panel-title">
                        Zona de peligro
                    </h2>

                    <p class="panel-description">
                        Desde aquí puedes iniciar el proceso de eliminación
                        de tu cuenta de administrador.
                    </p>
                </div>
            </div>

            <app-delete-account [role]="'ADMIN'" />
        </section>
        }

        <!-- SEGURIDAD -->
        @if (activeSection() === 'security') {
        <app-two-factor-settings [enabled]="twoFactorEnabled()"
            (enabledChange)="onTwoFactorEnabledChange($any($event))" />
        }
        }
    </main>
</div>
</file>

