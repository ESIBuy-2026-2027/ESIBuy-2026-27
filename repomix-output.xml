<div class="home-container">
  <!-- SECCIÓN HERO CON BÚSQUEDA DESTACADA -->
  <section class="hero-section" aria-labelledby="hero-title">
    <div class="hero-content">
      <p class="hero-eyebrow">Tu tienda, más sencilla</p>
      <h1 id="hero-title">Compra con confianza. Vive la experiencia.</h1>
      <p class="hero-subtitle">
        Descubre miles de productos disponibles con acceso libre para toda la comunidad.
      </p>

      <!-- CAMPO DE BÚSQUEDA VISIBLE -->
      <div class="hero-search-box">
        <label for="public-search" class="visually-hidden">Buscar productos por nombre o palabra clave</label>
        <svg class="search-svg" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="2.2"></circle>
          <path d="m16 16 4.5 4.5" fill="none" stroke="currentColor" stroke-width="2.2"></path>
        </svg>
        <input id="public-search" type="search" placeholder="Buscar por nombre o palabra clave..."
          [ngModel]="searchQuery()" (ngModelChange)="searchQuery.set($event); onFilterChange()" />
        @if (searchQuery()) {
          <button type="button" class="clear-search-btn" (click)="searchQuery.set(''); onFilterChange()" aria-label="Borrar búsqueda">×</button>
        }
      </div>
    </div>
  </section>

  <!-- BARRA DE FILTROS COMBINABLES CON RECUADRO NOTABLE -->
  <section class="catalog-main" aria-label="Catálogo público">
    <div class="filters-panel">
      <div class="filters-header">
        <span class="filters-title">Filtrar catálogo</span>
        <button type="button" class="reset-link" (click)="resetFilters()">Limpiar filtros</button>
      </div>

      <div class="filters-grid">
        <div class="filter-item">
          <label for="home-category">Categoría</label>
          <select id="home-category" [ngModel]="selectedCategory()" (ngModelChange)="selectedCategory.set($event); onFilterChange()">
            <option value="">Todas las categorías</option>
            @for (cat of categories(); track cat.id) {
              <option [value]="cat.id">{{ cat.name }}</option>
            }
          </select>
        </div>

        <div class="filter-item price-item">
          <span>Rango de precio (€)</span>
          <div class="price-inputs-row">
            <input type="number" min="0" placeholder="Mín" [ngModel]="minPrice()"
              (ngModelChange)="minPrice.set($event); onFilterChange()" aria-label="Precio mínimo" />
            <span class="sep">-</span>
            <input type="number" min="0" placeholder="Máx" [ngModel]="maxPrice()"
              (ngModelChange)="maxPrice.set($event); onFilterChange()" aria-label="Precio máximo" />
          </div>
        </div>

        <div class="filter-item">
          <label for="home-rating">Valoración mínima</label>
          <select id="home-rating" [ngModel]="minRating()" (ngModelChange)="minRating.set($event); onFilterChange()">
            <option [ngValue]="null">Cualquier valoración</option>
            <option [ngValue]="4">4 estrellas o más (★★★★☆)</option>
            <option [ngValue]="3">3 estrellas o más (★★★☆☆)</option>
            <option [ngValue]="2">2 estrellas o más (★★☆☆☆)</option>
            <option [ngValue]="1">1 estrella o más (★☆☆☆☆)</option>
          </select>
        </div>

        <div class="filter-item stock-item">
          <label class="stock-checkbox">
            <input type="checkbox" [ngModel]="onlyInStock()" (ngModelChange)="onlyInStock.set($event); onFilterChange()" />
            <span>Solo en stock</span>
          </label>
        </div>
      </div>
    </div>

    <!-- CUADRÍCULA DE PRODUCTOS -->
    <div class="catalog-results">
      <div class="results-meta">
        @if (!loading() && !error()) {
          <span class="meta-count">{{ products().length }} productos disponibles</span>
        }
      </div>

      @if (loading()) {
        <div class="status-box">
          <div class="spinner"></div>
          <p>Cargando el escaparate de productos…</p>
        </div>
      } @else if (error()) {
        <div class="status-box error-box" role="alert">
          <p>No se pudo cargar el catálogo de productos.</p>
          <button type="button" class="btn-retry" (click)="loadProducts()">Reintentar</button>
        </div>
      } @else if (products().length === 0) {
        <div class="status-box empty-box">
          <span class="empty-glyph" aria-hidden="true">⌕</span>
          <h3>No se encontraron productos</h3>
          <p>No hay artículos que coincidan con tus criterios de búsqueda o filtros.</p>
          <button type="button" class="btn-reset" (click)="resetFilters()">Restablecer filtros</button>
        </div>
      } @else {
        <div class="product-cards-grid">
          @for (product of products(); track product.id) {
            <article class="showcase-card" [routerLink]="['/products', product.id]">
              <div class="card-media-wrapper">
                @if (product.imageUrl) {
                  <img [src]="product.imageUrl" [alt]="product.name" class="card-photo" loading="lazy" />
                } @else {
                  <div class="photo-placeholder" aria-hidden="true">▦</div>
                }

                <!-- CORAZÓN CENTRADO AL PONERSE ENCIMA DE LA IMAGEN CON EL RATÓN -->
                <button type="button" class="center-heart-action"
                  [class.is-favorite]="wishlistService.isFavorite(product.id)"
                  (click)="toggleFavorite(product.id, $event)"
                  [title]="wishlistService.isFavorite(product.id) ? 'En tu lista de deseos' : 'Guardar en favoritos'"
                  [attr.aria-label]="wishlistService.isFavorite(product.id) ? 'Quitar de lista de deseos' : 'Añadir a lista de deseos'">
                  <svg viewBox="0 0 24 24" class="heart-svg-icon" aria-hidden="true">
                    <path
                      d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" />
                  </svg>
                </button>

                <span class="rating-badge">★ {{ (product.rating ?? 5.0).toFixed(1) }}</span>
              </div>

              <div class="card-content">
                <div class="card-category-list">
                  @for (catId of product.categoryIds; track catId) {
                    <span class="cat-pill">{{ categoryName(catId) }}</span>
                  }
                </div>

                <h3 class="card-title">{{ product.name }}</h3>
                <p class="card-desc">{{ product.description || 'Sin descripción' }}</p>
                
                <span class="detail-link">Ver detalle →</span>

                <div class="card-price-row">
                  <div class="price-stock-wrap">
                    <span class="card-price">{{ formatPrice(product.price) }}</span>
                    <span class="stock-pill" [class.stock-empty]="product.stock === 0" [class.stock-low]="stockStatus(product.stock) === 'Stock bajo'">
                      {{ stockStatus(product.stock) }}
                    </span>
                  </div>

                  <div class="card-btn-group">
                    <button type="button" class="add-to-cart-action-btn"
                      [disabled]="product.stock === 0"
                      (click)="addToCart(product, $event)">
                      Añadir al carrito
                    </button>
                  </div>
                </div>
              </div>
            </article>
          }
        </div>
      }
    </div>

  </section>
</div>
