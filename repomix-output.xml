@if (dialogMode(); as mode) {
<div class="dialog-backdrop" (click)="closeDialog()" (keydown.escape)="closeDialog()">
  <dialog class="dialog" open aria-modal="true"
    [attr.aria-labelledby]="mode === 'delete' ? 'delete-title' : 'edit-title'" (click)="$event.stopPropagation()"
    (keydown.escape)="closeDialog()">
    @if (mode === 'delete') {
    <span class="dialog-icon dialog-icon--danger" aria-hidden="true">!</span>
    <h2 id="delete-title">¿Eliminar categoría?</h2>
    <p>Vas a eliminar <strong>{{ selectedCategory()?.name }}</strong>. No se podrá eliminar si está asociada a
      productos. Los perfiles de vendedor existentes guardan el nombre como texto y podrían requerir una actualización
      manual.</p>
    <div class="dialog-actions">
      <button type="button" class="secondary-action" (click)="closeDialog()">Cancelar</button>
      <button type="button" class="danger-action" [disabled]="deleting()" (click)="deleteCategory()">
        {{ deleting() ? 'Eliminando...' : 'Eliminar' }}
      </button>
    </div>
    } @else {
    <span class="dialog-icon" aria-hidden="true">{{ mode === 'create' ? '+' : '✎' }}</span>
    <h2 id="edit-title">{{ mode === 'create' ? 'Nueva categoría' : 'Editar categoría' }}</h2>
    <p>El nombre se mostrará en el catálogo de vendedores y productos. Renombrar no actualiza automáticamente el texto
      guardado en los perfiles de vendedor existentes.</p>
    <label class="field-label" for="category-name">Nombre de la categoría</label>
    <input id="category-name" type="text" maxlength="50" [ngModel]="draftName()"
      (ngModelChange)="draftName.set($event); clearFieldError()" (keyup.enter)="saveCategory()"
      placeholder="Ej.: Electrónica" autofocus required aria-describedby="category-name-error">
    @if (serverFieldErrors().name) {
    <span class="field-error" id="category-name-error" role="alert">{{ serverFieldErrors().name }}</span>
    } @else if (!draftName().trim()) {
    <span class="field-hint" id="category-name-error">Escribe un nombre para continuar.</span>
    } @else if (draftName().trim().length < 2) { <span class="field-error" id="category-name-error">El nombre debe
      tener
      al menos 2 caracteres.</span>
      } @else if (draftName().trim().length > 50) {
      <span class="field-error" id="category-name-error">El nombre no puede superar los 50 caracteres.</span>
      } @else if (hasDuplicateName()) {
      <span class="field-error" id="category-name-error" role="alert">Ya existe una categoría con ese nombre.</span>
      }
      <div class="dialog-actions">
        <button type="button" class="secondary-action" (click)="closeDialog()">Cancelar</button>
        <button type="button" class="primary-action" [disabled]="!isValidName() || hasDuplicateName() || saving()"
          (click)="saveCategory()">
          {{ saving() ? 'Guardando...' : mode === 'create' ? 'Añadir categoría' : 'Guardar cambios' }}
        </button>
      </div>
      }
  </dialog>
</div>
}
