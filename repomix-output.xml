<section class="panel security-panel" aria-labelledby="email-otp-title">
    <div class="panel-heading">
        <div class="panel-heading-text">
            <p class="panel-eyebrow">SEGURIDAD DE LA CUENTA</p>

            <h2 class="panel-title" id="email-otp-title">
                Verificación por correo electrónico
            </h2>

            <p class="panel-description">
                Añade una capa adicional de protección mediante un
                código temporal enviado a tu correo electrónico.
            </p>
        </div>

        <span class="security-status" [class.security-status-on]="enabled">
            <span class="status-dot"></span>
            {{ enabled ? 'Activada' : 'Desactivada' }}
        </span>
    </div>

    @if (loading) {
    <p class="security-copy" role="status">
        Cargando configuración de seguridad...
    </p>
    } @else {
    @if (error) {
    <p class="form-error" role="alert">
        {{ error }}
    </p>
    }

    @if (success) {
    <output class="success-message" role="status">
        {{ success }}
    </output>
    }

    <div class="security-copy">
        <p>
            La verificación por correo permite solicitar un código
            temporal al iniciar sesión. Esta opción está disponible
            para las cuentas de administrador y vendedor.
        </p>
    </div>

    <div class="email-information">
        <span class="email-label">Correo asociado a la cuenta</span>
        <span class="email-value">{{ email || 'No disponible' }}</span>
    </div>

    @if (enabled) {
    <div class="security-enabled-note">
        <strong>Verificación por correo activada</strong>
        <p>
            Se solicitará un código de verificación por correo
            durante el inicio de sesión. Tu configuración TOTP
            seguirá funcionando de forma independiente.
        </p>
    </div>

    <div class="disable-email-otp">
        <h3>Desactivar verificación por correo</h3>

        @if (!awaitingCode) {
        <p>
            Para desactivar esta protección, confirma la operación
            con un código enviado a tu correo electrónico.
        </p>

        <div class="security-actions">
            <button type="button" class="danger-button" (click)="disableEmailOtp()"
                [disabled]="saving || requestingCode">
                {{ requestingCode ? 'Enviando código...' : 'Desactivar verificación' }}
            </button>
        </div>
        } @else {
        <p>
            Hemos enviado un código de confirmación a
            <strong>{{ email }}</strong>. Introdúcelo para confirmar la desactivación.
        </p>

        <div class="security-code-field">
            <label for="email-otp-disable-code">Código de verificación</label>
            <input id="email-otp-disable-code" type="text" name="emailOtpDisableCode"
                [(ngModel)]="verificationCode"
                (ngModelChange)="verificationCode = formatVerificationCode($event)"
                autocomplete="one-time-code" inputmode="numeric" placeholder="XXX XXX"
                maxlength="7" [disabled]="saving" aria-describedby="email-otp-disable-help" />
            <span id="email-otp-disable-help" class="qr-caption">
                Introduce los seis dígitos recibidos por correo. El código caduca a los 10 minutos.
            </span>
        </div>

        <div class="security-actions">
            <button type="button" class="secondary-button" (click)="cancelDisableEmailOtp()"
                [disabled]="saving || requestingCode">
                Cancelar
            </button>
            <button type="button" class="danger-button" (click)="confirmDisableEmailOtp()"
                [disabled]="saving || verificationCode.replace(' ', '').length !== 6">
                {{ saving ? 'Verificando...' : 'Desactivar verificación' }}
            </button>
        </div>
        }
    </div>
    } @else {
    <div class="setup-instructions">
        <h3>Activar verificación por correo</h3>
        <p>
            Al activar esta opción, se solicitará un código temporal
            enviado a la dirección asociada a tu cuenta cuando el inicio
            de sesión requiera esta verificación.
        </p>

        <div class="email-confirmation">
            <span class="email-label">Los códigos se enviarán a</span>
            <strong class="email-value">{{ email || 'No disponible' }}</strong>
        </div>

        <div class="form-actions">
            <button type="button" class="primary-button" (click)="enableEmailOtp()"
                [disabled]="saving || !email">
                {{ saving ? 'Activando...' : 'Activar verificación' }}
            </button>
        </div>
    </div>
    }

    @if (saving) {
    <p class="security-copy" role="status">Guardando configuración...</p>
    }
    }

    <div class="security-note">
        <strong>Importante</strong>
        <p>
            La verificación por correo es independiente de la autenticación TOTP.
            Desactivar una no desactiva la otra.
        </p>
    </div>
</section>
</file>

<file path="frontend/src/app/shared/email-otp-settings/email-otp-settings.ts">
import {
    ChangeDetectorRef,
    Component,
    OnInit,
    inject,
} from '@angular/core';
import { FormsModule } from '@angular/forms';
import { finalize } from 'rxjs';
import { EmailOtpSettingsService } from '../../core/services/email-otp-settings.service';

type EmailOtpHttpError = {
    status?: number;
    error?: {
        message?: string;
        detail?: string;
        error?: string;
    };
};

@Component({
    selector: 'app-email-otp-settings',
    standalone: true,
    imports: [FormsModule],
    templateUrl: './email-otp-settings.html',
    styleUrl: './email-otp-settings.css',
})
export class EmailOtpSettingsComponent implements OnInit {
    private readonly cdr = inject(ChangeDetectorRef);
    private readonly emailOtpService = inject(EmailOtpSettingsService);

    email = '';
    enabled = false;
    loading = true;
    saving = false;
    requestingCode = false;
    awaitingCode = false;
    verificationCode = '';
    error = '';
    success = '';

    ngOnInit(): void {
        this.loadSettings();
    }

    loadSettings(): void {
        this.loading = true;
        this.error = '';
        this.success = '';
        this.emailOtpService.getSettings()
            .pipe(finalize(() => {
                this.loading = false;
                this.cdr.detectChanges();
            }))
            .subscribe({
                next: (settings) => {
                    this.email = settings.email ?? '';
                    this.enabled = settings.enabled;
                    this.cdr.detectChanges();
                },
                error: (err: EmailOtpHttpError) => {
                    this.error = this.getErrorMessage(err, 'No se ha podido cargar la configuración de seguridad.');
                    this.cdr.detectChanges();
                },
            });
    }

    enableEmailOtp(): void {
        if (this.loading || this.saving || this.enabled) return;
        this.error = '';
        this.success = '';
        this.saving = true;
        this.emailOtpService.updateEnabled(true)
            .pipe(finalize(() => {
                this.saving = false;
                this.cdr.detectChanges();
            }))
            .subscribe({
                next: (response) => {
                    this.enabled = response.enabled;
                    this.email = response.email ?? this.email;
                    this.success = response.message || 'La verificación por correo se ha activado correctamente.';
                    this.cdr.detectChanges();
                },
                error: (err: EmailOtpHttpError) => {
                    this.error = this.getErrorMessage(err, 'No se ha podido activar la verificación por correo.');
                    this.cdr.detectChanges();
                },
            });
    }

    disableEmailOtp(): void {
        if (this.loading || this.saving || this.requestingCode || !this.enabled || this.awaitingCode) return;
        this.error = '';
        this.success = '';
        this.requestingCode = true;
        this.emailOtpService.requestDisableChallenge()
            .pipe(finalize(() => {
                this.requestingCode = false;
                this.cdr.detectChanges();
            }))
            .subscribe({
                next: (response) => {
                    this.awaitingCode = true;
                    this.verificationCode = '';
                    this.success = response.message || 'Hemos enviado un código de verificación a tu correo.';
                    this.cdr.detectChanges();
                },
                error: (err: EmailOtpHttpError) => {
                    this.error = this.getErrorMessage(err, 'No se ha podido enviar el código. Inténtalo de nuevo.');
                    this.cdr.detectChanges();
                },
            });
    }

    confirmDisableEmailOtp(): void {
        const code = this.verificationCode.replace(/\s/g, '');
        if (this.saving || !this.awaitingCode || !/^\d{6}$/.test(code)) {
            this.error = 'Introduce un código válido de 6 cifras.';
            return;
        }
        this.error = '';
        this.success = '';
        this.saving = true;
        this.emailOtpService.confirmDisable(code)
            .pipe(finalize(() => {
                this.saving = false;
                this.cdr.detectChanges();
            }))
            .subscribe({
                next: (response) => {
                    this.enabled = response.enabled;
                    this.email = response.email ?? this.email;
                    this.awaitingCode = false;
                    this.verificationCode = '';
                    this.success = response.message || 'La verificación por correo se ha desactivado correctamente.';
                    this.cdr.detectChanges();
                },
                error: (err: EmailOtpHttpError) => {
                    this.error = this.getErrorMessage(err, 'El código no es válido o ha caducado. Comprueba el correo e inténtalo de nuevo.');
                    this.cdr.detectChanges();
                },
            });
    }

    cancelDisableEmailOtp(): void {
        if (this.saving || this.requestingCode) return;
        this.awaitingCode = false;
        this.verificationCode = '';
        this.error = '';
        this.success = '';
    }

    formatVerificationCode(value: string): string {
        const digits = (value ?? '').replace(/\D/g, '').slice(0, 6);
        return digits.length > 3 ? `${digits.slice(0, 3)} ${digits.slice(3)}` : digits;
    }

    private getErrorMessage(error: EmailOtpHttpError, fallback: string): string {
        return error.error?.message ?? error.error?.detail ?? error.error?.error ?? fallback;
    }
}
