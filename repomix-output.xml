  border-color: #f0d99e;
}

.editable-availability:hover:not(:disabled) {
  border-color: #8bcfc0;
}

.editable-availability:disabled {
  cursor: wait;
  opacity: .65;
}

/* Edición en línea */

.inline-editor {
  display: inline-flex;
  align-items: center;
  gap: 6px;
}

.inline-input {
  width: 85px;
  min-height: 34px;
  padding: 5px 8px;
  border: 1px solid #8bcfc0;
  border-radius: 7px;
  color: var(--color-text-primary);
  background: #fff;
  font: inherit;
  font-size: 12px;
}

.stock-input {
  width: 68px;
}

.inline-input:focus {
  outline: none;
  box-shadow: 0 0 0 3px rgb(66 214 178 / 15%);
}

.inline-actions {
  display: flex;
  gap: 4px;
}

.inline-save,
.inline-cancel {
  display: grid;
  width: 29px;
  height: 29px;
  place-items: center;
  border: 1px solid transparent;
  border-radius: 7px;
  font-size: 16px;
  font-weight: 800;
  cursor: pointer;
}

.inline-save {
  color: #08735d;
  background: #e5f8f1;
}

.inline-cancel {
  color: #a84f41;
  background: #fff0ed;
}

.inline-save:hover:not(:disabled) {
  background: #cef1e5;
}

.inline-cancel:hover:not(:disabled) {
  background: #fde1db;
}

.inline-save:disabled,
.inline-cancel:disabled {
  cursor: not-allowed;
  opacity: .55;
}

.inline-error-row td {
  padding-top: 0;
  color: #a84f41;
  font-size: 12px;
}

/* Acciones */

.action-column {
  width: 65px;
  min-width: 65px;
  text-align: right;
}

.action-buttons {
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.icon-button {
  display: inline-grid;
  width: 37px;
  height: 37px;
  place-items: center;
  border: 1px solid #d9e6fa;
  border-radius: 9px;
  color: #4774a0;
  background: #edf4ff;
  cursor: pointer;
  text-decoration: none;
  transition: background-color .18s ease, border-color .18s ease, transform .18s ease;
}

.icon-button svg {
  width: 18px;
  height: 18px;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.9;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.icon-button:hover {
  transform: translateY(-1px);
  border-color: #b3ddfa;
  background: #dbe9fb;
}

/* Carga, errores y estados vacíos */

.catalog-message {
  display: flex;
  min-height: 190px;
  align-items: center;
  justify-content: center;
  gap: 13px;
  color: #627b8b;
  font-size: 14px;
}

.spinner {
  display: inline-block;
  width: 25px;
  height: 25px;
  flex: 0 0 25px;
  border: 3px solid #ccefe7;
  border-top-color: #168c75;
  border-radius: 50%;
  animation: spin .8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.catalog-error {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  padding: 15px 17px;
  border: 1px solid #f1d5cf;
  border-left: 4px solid #d86a5b;
  border-radius: 10px;
  color: #944c42;
  background: #fff7f5;
  font-size: 13px;
  line-height: 1.5;
}

.catalog-error button {
  flex: 0 0 auto;
  min-height: 35px;
  padding: 0 12px;
  border: 1px solid #e3b8b1;
  border-radius: 8px;
  color: #83443b;
  background: #fff;
  font: inherit;
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
}

.catalog-error button:hover {
  background: #fff0ed;
}

.category-error {
  margin-bottom: 15px;
}

.empty-state {
  display: flex;
  min-height: 270px;
  align-items: center;
  flex-direction: column;
  justify-content: center;
  padding: 35px 20px;
  border: 1px dashed #d7e4e9;
  border-radius: 12px;
  background: #fbfcfd;
  text-align: center;
}

.empty-icon {
  display: grid;
  width: 52px;
  height: 52px;
  place-items: center;
  margin-bottom: 15px;
  border-radius: 15px;
  color: #168c75;
  background: #e4f8f2;
  font-size: 24px;
}

.empty-state h2 {
  margin: 0 0 8px;
  color: var(--color-text-primary);
  font-size: 18px;
  font-weight: 750;
}

.empty-state p {
  max-width: 400px;
  margin: 0 0 20px;
  color: #718694;
  font-size: 13px;
  line-height: 1.65;
}

.secondary-action {
  min-height: 42px;
  padding: 0 16px;
  font-size: 13px;
}

/* Accesibilidad */

.primary-action:focus-visible,
.secondary-action:focus-visible,
.icon-button:focus-visible,
.catalog-filter-button:focus-visible,
.catalog-error button:focus-visible,
.inline-save:focus-visible,
.inline-cancel:focus-visible,
.editable-value:focus-visible,
.editable-availability:focus-visible {
  outline: 3px solid rgb(66 214 178 / 65%);
  outline-offset: 3px;
}

.action-column {
  width: 1%;
  padding-left: 14px !important;
  padding-right: 14px !important;
}

.action-buttons {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8px;
}

.icon-button {
  display: inline-grid;
  width: 34px;
  height: 34px;
  place-items: center;
  border: 1px solid transparent;
  border-radius: 8px;
  cursor: pointer;
  transition: background 0.15s, color 0.15s, border-color 0.15s;
  text-decoration: none;
}

.icon-button:disabled {
  cursor: not-allowed;
  opacity: 0.55;
}

.edit-button {
  background: #edf4ff;
  color: #4774a0;
}

.edit-button:hover:not(:disabled) {
  background: #dbe9fb;
  border-color: #b3ddfa;
}

.icon-button:focus-visible {
  outline: 3px solid #56d9b8;
  outline-offset: 2px;
}

@media (max-width: 760px) {
/* Pantallas medianas */

@media (max-width: 1250px) {
  .catalog-content {
    padding: 34px 28px 50px;
  }

  .catalog-main-card {
    padding: 28px;
  }

  .product-table {
    min-width: 820px;
  }
}

/* Tablets */

@media (max-width: 900px) {
  .workspace {
    margin-left: 225px;
  }

  .catalog-content {
    padding: 28px 20px 42px;
  }

  .catalog-main-card {
    padding: 24px;
  }

  .page-heading {
    align-items: flex-start;
    flex-direction: column;
    gap: 18px;
  }

  .primary-action {
    align-self: flex-start;
  }

  .catalog-toolbar {
    flex-wrap: wrap;
  }

  .catalog-search {
    width: 100%;
    min-width: 0;
    flex-basis: 100%;
  }
}

/* Móviles */

@media (max-width: 680px) {
  .workspace {
    margin-left: 0;
  }

  .catalog-content {
    padding: 20px 12px 32px;
  }

  .catalog-main-card {
    padding: 19px 15px;
    border-radius: 14px;
  }

  .page-heading {
    margin-bottom: 22px;
    padding-bottom: 21px;
  }

  .page-heading h1 {
    font-size: 30px;
  }

  .page-description {
    font-size: 14px;
  }

  .primary-action {
    width: 100%;
    min-height: 47px;
    align-self: stretch;
  }

  .catalog-toolbar {
    gap: 10px;
    margin-bottom: 17px;
  }

  .catalog-search {
    flex-basis: 100%;
  }

  .catalog-controls {
    width: 100%;
    flex-wrap: wrap;
  }

  .catalog-filter-panel {
    top: 28px;
    left: 0;
    width: min(100%, 520px);
    grid-template-columns: 1fr 1fr;
  }

  .product-count {
    margin-left: auto;
  }

  .product-image,
  .product-image-placeholder {
    width: 40px;
    height: 40px;
    flex-basis: 40px;
  }

  .product-description {
    max-width: 200px;
  }

  .catalog-error {
    align-items: flex-start;
    flex-direction: column;
  }

  .catalog-error button {
    align-self: flex-start;
  }
}

/* Respeta las preferencias de accesibilidad */

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    animation-duration: .01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: .01ms !important;
  }
}
}
