  height: 20px;
  color: #94a3b8;
  pointer-events: none;
}

.hero-search-box input {
  width: 100%;
  padding: 16px 44px 16px 52px;
  border: none;
  background: transparent;
  border-radius: 12px;
  font-size: 15px;
  outline: none;
