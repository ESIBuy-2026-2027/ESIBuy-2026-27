  box-shadow: 0 4px 12px rgb(16 44 64 / 14%);
}

.btn-submit:active:not(:disabled) {
  background: #0a2434;
}

.btn-submit:disabled {
  border-color: #c7d5dc;
  background: #dce5e9;
  color: #738792;
  cursor: not-allowed;
}

.login-success-link {
  margin-top: 0.75rem;
}

/* Texto auxiliar y enlaces */

.privacy-note {
