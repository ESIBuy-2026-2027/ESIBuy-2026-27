                    </div>
                  </td>

                  <td>
                    @if (categoriesLoading()) {
                    <span class="category-empty">Cargando categorías...</span>
                    } @else if (categoriesError()) {
                    <span class="category-badge category-unavailable">No disponible</span>
                    } @else if (product.categoryIds.length === 0) {
                    <span class="category-empty">Sin categoría</span>
                    } @else {
                    <div class="category-list">
                      @for (categoryId of product.categoryIds; track categoryId) {
                      <span class="category-badge">
                        {{ categoryName(categoryId) }}
