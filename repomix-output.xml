}

.seller-shell .app-sidebar .navigation-link.is-active {
  border-left-color: #42d6b2;
  box-shadow: none;
}

.seller-shell .app-sidebar .navigation-icon {
  display: inline-block;
  width: 20px;
  height: 20px;
  flex: 0 0 20px;
  color: currentColor;
}

.seller-shell.app-sidebar-collapsed .app-sidebar {
  transform: translateX(-100%);
}

.seller-shell.app-sidebar-collapsed .app-workspace {
  margin-left: 0;
}

.seller-layout *,
.seller-layout *::before,
.seller-layout *::after {
